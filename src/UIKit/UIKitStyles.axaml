<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="Window.UIKitWindow"><Setter Property="Background" Value="{DynamicResource OSBackgroundWindowBrush}" /></Style>
  <Style Selector="Border.UIKitSidebar"><Setter Property="Background" Value="{DynamicResource OSBackgroundControlBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource OSFillPrimaryBrush}" /><Setter Property="BorderThickness" Value="0,0,1,0" /></Style>
  <Style Selector="Border.UIKitHeader"><Setter Property="Background" Value="{DynamicResource OSBackgroundWindowBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource OSFillPrimaryBrush}" /><Setter Property="BorderThickness" Value="0,0,0,1" /></Style>
  <Style Selector="Border.UIKitSection"><Setter Property="Padding" Value="20" /><Setter Property="CornerRadius" Value="{DynamicResource OSRadiusSurface}" /><Setter Property="Background" Value="{DynamicResource OSBackgroundControlBrush}" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="TextBlock.UIKitSectionTitle"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource OSLabelPrimaryBrush}" /></Style>
  <Style Selector="TextBlock.UIKitSectionCaption"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource OSLabelTertiaryBrush}" /></Style>
  <Style Selector="TextBlock.UIKitNavItem"><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{DynamicResource OSLabelSecondaryBrush}" /></Style>
  <Style Selector="Border.UIKitToken"><Setter Property="Width" Value="70" /><Setter Property="Height" Value="46" /><Setter Property="CornerRadius" Value="{DynamicResource OSRadiusMedium}" /></Style>
  <Style Selector="Border.UIKitInsetCard"><Setter Property="Padding" Value="14" /><Setter Property="CornerRadius" Value="{DynamicResource OSRadiusControl}" /><Setter Property="Background" Value="{DynamicResource OSFillSecondaryBrush}" /></Style>
  <Style Selector="Button.UIKitComboBoxButton"><Setter Property="Height" Value="38" /><Setter Property="MinHeight" Value="38" /><Setter Property="Padding" Value="12,0" /><Setter Property="CornerRadius" Value="{DynamicResource OSRadiusMedium}" /><Setter Property="Background" Value="{DynamicResource OSClearBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource OSClearBrush}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="RenderTransform" Value="none" /></Style>
  <Style Selector="Button.UIKitComboBoxButton:pointerover, Button.UIKitComboBoxButton:pressed"><Setter Property="Background" Value="{DynamicResource OSClearBrush}" /><Setter Property="RenderTransform" Value="none" /></Style>
  <Style Selector="Button.UIKitComboBoxButton /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource OSClearBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource OSClearBrush}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="{DynamicResource OSRadiusMedium}" /></Style>
  <Style Selector="Border.UIKitComboBoxPopup"><Setter Property="Margin" Value="0,6,0,0" /><Setter Property="Padding" Value="4" /><Setter Property="CornerRadius" Value="{DynamicResource OSRadiusControl}" /><Setter Property="Background" Value="{DynamicResource OSBackgroundControlBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource OSFillPrimaryBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="BoxShadow" Value="{DynamicResource OSShadowLarge}" /></Style>
  <Style Selector="ListBox.UIKitComboBoxList"><Setter Property="Background" Value="{DynamicResource OSClearBrush}" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="ListBox.UIKitComboBoxList ListBoxItem"><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="10,6" /><Setter Property="CornerRadius" Value="{DynamicResource OSRadiusMedium}" /><Setter Property="Foreground" Value="{DynamicResource OSLabelPrimaryBrush}" /></Style>
  <Style Selector="ListBox.UIKitComboBoxList ListBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource OSButtonHoverBrush}" /></Style>
  <Style Selector="ListBox.UIKitComboBoxList ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource OSButtonSecondaryBrush}" /><Setter Property="Foreground" Value="{DynamicResource OSButtonSecondaryForegroundBrush}" /></Style>
</Styles>
