<Window
    x:Class="UIKit.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:components="clr-namespace:UIKit.Components"
    xmlns:controls="clr-namespace:DaisyOS.Shell.Controls;assembly=DaisyOS.Shell"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Classes="UIKitWindow"
    Title="UIKit — DaisyOS component gallery"
    Width="1280"
    Height="820"
    MinWidth="920"
    MinHeight="620">
  <DockPanel LastChildFill="True" ClipToBounds="True">
    <Border DockPanel.Dock="Top" Classes="UIKitHeader" Padding="24,16">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource OSAccentBrush}">
            <TextBlock Classes="MaterialSymbol" Text="deployed_code" FontSize="18" Foreground="{DynamicResource OSButtonPrimaryForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Classes="Title" Text="UIKit" />
            <TextBlock Classes="Caption" Text="DaisyOS reusable component reference" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="Subtle" Click="ThemeButton_OnClick"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="MaterialSymbol" Text="contrast" /><TextBlock Text="Theme" /></StackPanel></Button>
          <Button Classes="Primary"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="MaterialSymbol" Text="content_copy" /><TextBlock Text="Copy token" /></StackPanel></Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid ColumnDefinitions="232,*" ClipToBounds="True">
    <Border Classes="UIKitSidebar" Padding="16">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="4">
          <TextBlock Classes="Caption" Margin="8,8,8,6" Text="COMPONENTS" />
          <Button Classes="Secondary" HorizontalContentAlignment="Left" Padding="12,8"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="MaterialSymbol" Text="grid_view" /><TextBlock Text="Overview" /></StackPanel></Button>
          <Button Classes="Tertiary" HorizontalContentAlignment="Left" Padding="12,8"><TextBlock Classes="UIKitNavItem" Text="Typography" /></Button>
          <Button Classes="Tertiary" HorizontalContentAlignment="Left" Padding="12,8"><TextBlock Classes="UIKitNavItem" Text="Buttons &amp; actions" /></Button>
          <Button Classes="Tertiary" HorizontalContentAlignment="Left" Padding="12,8"><TextBlock Classes="UIKitNavItem" Text="Inputs &amp; selection" /></Button>
          <Button Classes="Tertiary" HorizontalContentAlignment="Left" Padding="12,8"><TextBlock Classes="UIKitNavItem" Text="Surfaces &amp; groups" /></Button>
          <Button Classes="Tertiary" HorizontalContentAlignment="Left" Padding="12,8"><TextBlock Classes="UIKitNavItem" Text="Feedback &amp; status" /></Button>
          <Border Height="1" Background="{DynamicResource OSFillPrimaryBrush}" Margin="8,16" />
          <TextBlock Classes="Caption" Margin="8,0,8,6" Text="TOKENS" />
          <Button Classes="Tertiary" HorizontalContentAlignment="Left" Padding="12,8"><TextBlock Classes="UIKitNavItem" Text="Colors &amp; elevation" /></Button>
          <Button Classes="Tertiary" HorizontalContentAlignment="Left" Padding="12,8"><TextBlock Classes="UIKitNavItem" Text="Spacing &amp; radius" /></Button>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <ScrollViewer x:Name="GalleryScrollViewer" Grid.Column="1" MinHeight="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Padding="32,32,32,64" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="1040" Spacing="24" Margin="0,0,0,160">
        <StackPanel Spacing="6">
          <TextBlock Classes="Display" Text="DaisyOS UIKit" />
          <TextBlock Classes="Body Secondary" Text="The live, reusable building blocks of the shell. Every item here uses the same theme resources and component styles as the desktop." TextWrapping="Wrap" />
        </StackPanel>

        <Border Classes="UIKitSection">
          <StackPanel Spacing="16">
            <StackPanel Spacing="3"><TextBlock Classes="UIKitSectionTitle" Text="Typography" /><TextBlock Classes="UIKitSectionCaption" Text="Display, hierarchy, body text, and secondary metadata." /></StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="32" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
              <TextBlock Classes="TitleLarge" Text="Title large" /><TextBlock Grid.Column="1" Classes="Caption" Text="28 / SemiBold" VerticalAlignment="Center" />
              <TextBlock Grid.Row="1" Classes="Title" Text="Title" /><TextBlock Grid.Row="1" Grid.Column="1" Classes="Caption" Text="20 / SemiBold" VerticalAlignment="Center" />
              <TextBlock Grid.Row="2" Classes="Subtitle" Text="Subtitle — a clear supporting heading" /><TextBlock Grid.Row="2" Grid.Column="1" Classes="Caption" Text="16 / Medium" VerticalAlignment="Center" />
              <TextBlock Grid.Row="3" Classes="Body" Text="Body text for ordinary content and descriptions." /><TextBlock Grid.Row="3" Grid.Column="1" Classes="Caption" Text="14 / Regular" VerticalAlignment="Center" />
              <TextBlock Grid.Row="4" Classes="Caption" Text="Caption text for timestamps, hints, and metadata." /><TextBlock Grid.Row="4" Grid.Column="1" Classes="Caption" Text="12 / Regular" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="UIKitSection">
          <StackPanel Spacing="16">
            <StackPanel Spacing="3"><TextBlock Classes="UIKitSectionTitle" Text="Buttons &amp; actions" /><TextBlock Classes="UIKitSectionCaption" Text="Shared action hierarchy, icon actions, and disabled behavior." /></StackPanel>
            <WrapPanel ItemSpacing="10" LineSpacing="10">
              <Button Classes="Primary">Primary action</Button>
              <Button Classes="Secondary">Secondary action</Button>
              <Button Classes="Tertiary">Tertiary action</Button>
              <Button Classes="Subtle">Subtle action</Button>
              <Button Classes="Danger">Delete</Button>
              <Button Classes="Primary" IsEnabled="False">Unavailable</Button>
              <Button Classes="ChromeIconButton" Width="36" Height="36" ToolTip.Tip="Add"><TextBlock Classes="MaterialSymbol" Text="add" /></Button>
              <Button Classes="ChromeIconButton" Width="36" Height="36" ToolTip.Tip="More options"><TextBlock Classes="MaterialSymbol" Text="more_horiz" /></Button>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Classes="UIKitSection">
          <StackPanel Spacing="16">
            <StackPanel Spacing="3"><TextBlock Classes="UIKitSectionTitle" Text="Inputs &amp; selection" /><TextBlock Classes="UIKitSectionCaption" Text="Text, search, choice, toggles, value controls, and disabled states." /></StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
              <StackPanel Spacing="8"><TextBlock Classes="Caption" Text="TEXT FIELD" /><controls:TextField PlaceholderText="Type something" Text="Sample value" /></StackPanel>
              <StackPanel Grid.Column="1" Spacing="8"><TextBlock Classes="Caption" Text="SEARCH" /><controls:SearchBox PlaceholderText="Search components" /></StackPanel>
              <StackPanel Grid.Row="1" Spacing="8"><TextBlock Classes="Caption" Text="COMBO BOX" /><components:ComboBox /></StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8"><TextBlock Classes="Caption" Text="TOGGLE &amp; CHECK" /><StackPanel Orientation="Horizontal" Spacing="18"><ToggleSwitch IsChecked="True" Content="Enabled" /><CheckBox IsChecked="True" Content="Checked" /><CheckBox IsEnabled="False" Content="Disabled" /></StackPanel></StackPanel>
              <StackPanel Grid.Row="2" Spacing="8"><TextBlock Classes="Caption" Text="RADIO BUTTONS" /><StackPanel Orientation="Horizontal" Spacing="16"><RadioButton GroupName="density" IsChecked="True" Content="Comfortable" /><RadioButton GroupName="density" Content="Compact" /></StackPanel></StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="1" Spacing="8"><TextBlock Classes="Caption" Text="SLIDER" /><components:Slider Minimum="0" Maximum="100" Value="62" Step="1" HorizontalAlignment="Stretch" /></StackPanel>
              <StackPanel Grid.Row="3" Spacing="8"><TextBlock Classes="Caption" Text="DATE &amp; TIME" /><components:DateTimeField /><TextBlock Classes="Caption Secondary" Text="Use localized date formats and a 24-hour time." /></StackPanel>
              <StackPanel Grid.Row="3" Grid.Column="1" Spacing="8"><TextBlock Classes="Caption" Text="TEXT FIELD STATES" /><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><controls:TextField PlaceholderText="Optional value" /><controls:TextField Grid.Column="1" Text="Unavailable" IsEnabled="False" /></Grid></StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
          <Border Classes="UIKitSection">
            <StackPanel Spacing="16">
              <StackPanel Spacing="3"><TextBlock Classes="UIKitSectionTitle" Text="Surfaces &amp; groups" /><TextBlock Classes="UIKitSectionCaption" Text="Cards, groups, borders, and elevation." /></StackPanel>
              <Border Classes="UIKitInsetCard"><StackPanel Spacing="4"><TextBlock Classes="BodyStrong" Text="Inset card" /><TextBlock Classes="Caption" Text="A quiet secondary surface for related content." /></StackPanel></Border>
              <Border Classes="NotificationCard"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Border Classes="NotificationToastIconHost"><TextBlock Classes="MaterialSymbol" Text="notifications" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Classes="BodyStrong" Text="Notification card" /><TextBlock Classes="Caption" Text="The same reusable notification treatment used by the shell." /></StackPanel></Grid></Border>
              <Border Classes="UIKitInsetCard"><StackPanel Spacing="4"><TextBlock Classes="BodyStrong" Text="Content group" /><TextBlock Classes="Caption" Text="A lightweight surface groups related information without a heavy frame." /></StackPanel></Border>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="UIKitSection">
            <StackPanel Spacing="16">
              <StackPanel Spacing="3"><TextBlock Classes="UIKitSectionTitle" Text="Feedback &amp; status" /><TextBlock Classes="UIKitSectionCaption" Text="Progress, status colors, and informative rows." /></StackPanel>
              <ProgressBar Value="68" Height="6" />
              <Border Classes="UIKitInsetCard"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><TextBlock Classes="MaterialSymbol" Text="check_circle" Foreground="{DynamicResource OSSuccessForegroundBrush}" FontSize="20" /><StackPanel Grid.Column="1"><TextBlock Classes="BodyStrong" Text="Everything is up to date" /><TextBlock Classes="Caption" Text="Last checked just now" /></StackPanel></Grid></Border>
              <Border Classes="UIKitInsetCard"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><TextBlock Classes="MaterialSymbol" Text="info" Foreground="{DynamicResource OSAccentBrush}" FontSize="20" /><StackPanel Grid.Column="1"><TextBlock Classes="BodyStrong" Text="Helpful status" /><TextBlock Classes="Caption" Text="Use concise language that explains what matters." /></StackPanel></Grid></Border>
              <Button Classes="Secondary" HorizontalAlignment="Left">Show dialog</Button>
              <StackPanel Orientation="Horizontal" Spacing="10"><Button Classes="SmallButton">Small button</Button><Button Classes="SmallButton" IsEnabled="False">Disabled</Button></StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="UIKitSection">
          <StackPanel Spacing="16">
            <StackPanel Spacing="3"><TextBlock Classes="UIKitSectionTitle" Text="Design tokens" /><TextBlock Classes="UIKitSectionCaption" Text="Theme-driven color roles used throughout the shell." /></StackPanel>
            <WrapPanel ItemSpacing="12" LineSpacing="12">
              <StackPanel Spacing="6"><Border Classes="UIKitToken" Background="{DynamicResource OSAccentBrush}" /><TextBlock Classes="Caption" Text="Accent" /></StackPanel>
              <StackPanel Spacing="6"><Border Classes="UIKitToken" Background="{DynamicResource OSBackgroundWindowBrush}" BorderBrush="{DynamicResource OSFillPrimaryBrush}" BorderThickness="1" /><TextBlock Classes="Caption" Text="Window" /></StackPanel>
              <StackPanel Spacing="6"><Border Classes="UIKitToken" Background="{DynamicResource OSBackgroundControlBrush}" BorderBrush="{DynamicResource OSFillPrimaryBrush}" BorderThickness="1" /><TextBlock Classes="Caption" Text="Control" /></StackPanel>
              <StackPanel Spacing="6"><Border Classes="UIKitToken" Background="{DynamicResource OSFillPrimaryBrush}" /><TextBlock Classes="Caption" Text="Fill primary" /></StackPanel>
              <StackPanel Spacing="6"><Border Classes="UIKitToken" Background="{DynamicResource OSDangerBrush}" /><TextBlock Classes="Caption" Text="Danger" /></StackPanel>
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
