<Application
    x:Class="UIKit.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:fluent="clr-namespace:Avalonia.Themes.Fluent;assembly=Avalonia.Themes.Fluent"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DaisyOS.Shell/Themes/OSTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <fluent:FluentTheme DensityStyle="Normal" />
    <StyleInclude Source="avares://UIKit/UIKitStyles.axaml" />
  </Application.Styles>
</Application>
