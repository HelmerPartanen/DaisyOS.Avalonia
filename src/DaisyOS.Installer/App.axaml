<Application
    x:Class="DaisyOS.Installer.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="Background" Value="#151619" /></Style>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="#F5F6F8" /></Style>
    <Style Selector="TextBlock.Heading"><Setter Property="FontSize" Value="30" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.Subtitle"><Setter Property="FontSize" Value="15" /><Setter Property="Foreground" Value="#AEB2BC" /></Style>
    <Style Selector="TextBlock.Label"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Border.Card"><Setter Property="Background" Value="#25272C" /><Setter Property="BorderBrush" Value="#34373E" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="20" /></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="42" /><Setter Property="Padding" Value="20,8" /><Setter Property="CornerRadius" Value="9" /></Style>
    <Style Selector="Button.Primary"><Setter Property="Background" Value="#59C7E8" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="TextBox, ComboBox"><Setter Property="MinHeight" Value="42" /></Style>
  </Application.Styles>
</Application>
