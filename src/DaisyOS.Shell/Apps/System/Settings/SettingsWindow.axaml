<Window
    x:Class="DaisyOS.Shell.Apps.System.Settings.SettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="clr-namespace:DaisyOS.Shell.Apps.System.Settings"
    Title="Settings"
    Width="1080"
    Height="720"
    MinWidth="760"
    MinHeight="540"
    WindowStartupLocation="CenterScreen"
    WindowDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="38"
    Background="Transparent">
  <!-- The frame is separate from the clipped content so its 1px rounded edge is never cut off. -->
  <Border Background="{DynamicResource TaskbarBorderBrush}"
          Padding="1"
          CornerRadius="12">
    <Border Background="{DynamicResource SystemBarMaterialBrush}"
            CornerRadius="11"
            ClipToBounds="True">
      <Grid RowDefinitions="38,*">
        <settings:SettingsWindowTitleBar Title="Settings" />
        <settings:SettingsView Grid.Row="1" />
      </Grid>
    </Border>
  </Border>
</Window>
