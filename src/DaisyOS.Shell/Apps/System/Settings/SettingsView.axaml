<UserControl
    x:Class="DaisyOS.Shell.Apps.System.Settings.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Styles>
    <!-- Sidebar navigation button layout -->
    <Style Selector="Button.SettingsNavItem">
      <Setter Property="Height" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style Selector="TextBlock.NavIcon">
      <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Width" Value="24" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.NavLabel">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <!-- Active navigation uses one foreground for its label and icon. -->
    <Style Selector="Button.SettingsNavItem.Active TextBlock.NavIcon, Button.SettingsNavItem.Active TextBlock.NavLabel">
      <Setter Property="Foreground" Value="{DynamicResource ContentOnActionBrush}" />
    </Style>

    <!-- List item button layout -->
    <Style Selector="Button.SettingsListItem">
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- The Settings app uses a single content width at every window size so pages
         remain comfortably readable instead of stretching across a full display. -->
    <Style Selector="TextBlock.SettingsPageTitle">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
    </Style>

    <!-- Breadcrumb button style -->
    <Style Selector="Button.BreadcrumbItem">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedSM}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.BreadcrumbItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    </Style>
    <Style Selector="Button.BreadcrumbItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StatePressedBrush}" />
    </Style>
    <Style Selector="Button.BreadcrumbItem:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
    </Style>

    <!-- Keep the platform ComboBox template so pointer, keyboard and popup behavior stay native. -->
    <Style Selector="ComboBox.ThemeModePicker">
      <Setter Property="Width" Value="112" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="{DynamicResource ActionSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedSM}" />
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="ComboBox.ThemeModePicker /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource ActionSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedSM}" />
    </Style>
    <Style Selector="ComboBox.ThemeModePicker:pointerover /template/ Border#Background, ComboBox.ThemeModePicker:dropdownopen /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource ActionSecondaryHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
    </Style>
    <Style Selector="ComboBox.ThemeModePicker /template/ PathIcon#DropDownGlyph">
      <Setter Property="Foreground" Value="{DynamicResource ContentSecondaryBrush}" />
    </Style>
    <Style Selector="ComboBox.ThemeModePicker:dropdownopen /template/ Border#PopupBorder">
      <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedSM}" />
      <Setter Property="BoxShadow" Value="{DynamicResource ElevationPopupShadow}" />
    </Style>
    <Style Selector="ComboBoxItem.ThemeModeOption">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedXS}" />
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ComboBoxItem.ThemeModeOption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
    </Style>
    <Style Selector="ComboBoxItem.ThemeModeOption:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StateSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
    </Style>
    <Style Selector="Button.AccentSwatch">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.AccentSwatch.Selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="SettingsLayout" ColumnDefinitions="248,*" Background="{DynamicResource SurfaceBaseBrush}">
    <!-- A quiet, dedicated navigation surface keeps the page hierarchy clear at every size. -->
    <Border Grid.Column="0"
            Background="{DynamicResource SurfaceBaseBrush}"
            Padding="12,14,10,14">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="6" Margin="0,0,16,0">
          <Button x:Name="NavSystem" Classes="SettingsNavItem Active" Click="OnNavCategoryClicked" Tag="System">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="computer" Classes="NavIcon SecondaryText" />
              <TextBlock Text="System" Classes="NavLabel" />
            </StackPanel>
          </Button>

          <Button x:Name="NavDisplays" Classes="SettingsNavItem" Click="OnNavCategoryClicked" Tag="Displays">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="desktop_windows" Classes="NavIcon SecondaryText" />
              <TextBlock Text="Displays" Classes="NavLabel" />
            </StackPanel>
          </Button>

          <Button x:Name="NavSound" Classes="SettingsNavItem" Click="OnNavCategoryClicked" Tag="Sound">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="volume_up" Classes="NavIcon SecondaryText" />
              <TextBlock Text="Sound" Classes="NavLabel" />
            </StackPanel>
          </Button>

          <Button x:Name="NavNetwork" Classes="SettingsNavItem" Click="OnNavCategoryClicked" Tag="Network">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="wifi" Classes="NavIcon SecondaryText" />
              <TextBlock Text="Network" Classes="NavLabel" />
            </StackPanel>
          </Button>

          <Button x:Name="NavBluetooth" Classes="SettingsNavItem" Click="OnNavCategoryClicked" Tag="Bluetooth">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="bluetooth" Classes="NavIcon SecondaryText" />
              <TextBlock Text="Bluetooth" Classes="NavLabel" />
            </StackPanel>
          </Button>

          <Button x:Name="NavAppearance" Classes="SettingsNavItem" Click="OnNavCategoryClicked" Tag="Appearance">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="contrast" Classes="NavIcon SecondaryText" />
              <TextBlock Text="Appearance" Classes="NavLabel" />
            </StackPanel>
          </Button>

          <Button x:Name="NavNotifications" Classes="SettingsNavItem" Click="OnNavCategoryClicked" Tag="Notifications">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="notifications" Classes="NavIcon SecondaryText" />
              <TextBlock Text="Notifications" Classes="NavLabel" />
            </StackPanel>
          </Button>

          <Button x:Name="NavApps" Classes="SettingsNavItem" Click="OnNavCategoryClicked" Tag="Apps">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="apps" Classes="NavIcon SecondaryText" />
              <TextBlock Text="Apps" Classes="NavLabel" />
            </StackPanel>
          </Button>

          <Button x:Name="NavStorage" Classes="SettingsNavItem" Click="OnNavCategoryClicked" Tag="Storage">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="storage" Classes="NavIcon SecondaryText" />
              <TextBlock Text="Storage" Classes="NavLabel" />
            </StackPanel>
          </Button>

          <Button x:Name="NavAccessibility" Classes="SettingsNavItem" Click="OnNavCategoryClicked" Tag="Accessibility">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="accessibility_new" Classes="NavIcon SecondaryText" />
              <TextBlock Text="Accessibility" Classes="NavLabel" />
            </StackPanel>
          </Button>

          <Button x:Name="NavPrivacy" Classes="SettingsNavItem" Click="OnNavCategoryClicked" Tag="Privacy">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="shield" Classes="NavIcon SecondaryText" />
              <TextBlock Text="Privacy &amp; security" Classes="NavLabel" />
            </StackPanel>
          </Button>

          <Button x:Name="NavAccounts" Classes="SettingsNavItem" Click="OnNavCategoryClicked" Tag="Accounts">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="person" Classes="NavIcon SecondaryText" />
              <TextBlock Text="Accounts" Classes="NavLabel" />
            </StackPanel>
          </Button>

          <Button x:Name="NavInput" Classes="SettingsNavItem" Click="OnNavCategoryClicked" Tag="Input">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="keyboard" Classes="NavIcon SecondaryText" />
              <TextBlock Text="Keyboard &amp; mouse" Classes="NavLabel" />
            </StackPanel>
          </Button>

          <Button x:Name="NavDateTime" Classes="SettingsNavItem" Click="OnNavCategoryClicked" Tag="DateTime">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="schedule" Classes="NavIcon SecondaryText" />
              <TextBlock Text="Date &amp; time" Classes="NavLabel" />
            </StackPanel>
          </Button>

          <Button x:Name="NavGaming" Classes="SettingsNavItem" Click="OnNavCategoryClicked" Tag="Gaming">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="stadia_controller" Classes="NavIcon SecondaryText" />
              <TextBlock Text="Gaming" Classes="NavLabel" />
            </StackPanel>
          </Button>

          <Button x:Name="NavAbout" Classes="SettingsNavItem" Click="OnNavCategoryClicked" Tag="About">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="info" Classes="NavIcon SecondaryText" />
              <TextBlock Text="About" Classes="NavLabel" />
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Main Content Area -->
    <Grid x:Name="ContentArea" Grid.Column="1" Background="Transparent" Margin="28,24,36,24" HorizontalAlignment="Stretch">
      <!-- SYSTEM CATEGORY MAIN LIST -->
      <ScrollViewer x:Name="SystemListView" IsVisible="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch" MaxWidth="1240" Margin="0,0,16,0">
          <!-- Page Header -->
          <Border Height="40" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button Classes="BreadcrumbItem" IsHitTestVisible="False">
                <TextBlock Text="System" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ContentPrimaryBrush}" />
              </Button>
            </StackPanel>
          </Border>

          <!-- System Settings List -->
          <StackPanel Spacing="8" HorizontalAlignment="Stretch">
            <!-- Power & Battery Card -->
            <Button Classes="SettingsListItem" Click="OnSystemSettingItemClicked" Tag="Power">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="battery_charging_full" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="20" VerticalAlignment="Center" Foreground="{DynamicResource ContentSecondaryBrush}" Margin="0,0,14,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="Power &amp; Battery" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ContentPrimaryBrush}" />
                  <TextBlock Text="Energy saver, screen sleep timeouts, and performance mode" FontSize="12" Foreground="{DynamicResource ContentSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="chevron_right" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource ContentTertiaryBrush}" Margin="12,0,0,0" />
              </Grid>
            </Button>

            <!-- Multitasking & Workspaces Card -->
            <Button Classes="SettingsListItem" Click="OnSystemSettingItemClicked" Tag="Multitasking">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="space_dashboard" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="20" VerticalAlignment="Center" Foreground="{DynamicResource ContentSecondaryBrush}" Margin="0,0,14,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="Multitasking &amp; Workspaces" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ContentPrimaryBrush}" />
                  <TextBlock Text="Window snapping, desktop workspaces, and alt-tab behavior" FontSize="12" Foreground="{DynamicResource ContentSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="chevron_right" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource ContentTertiaryBrush}" Margin="12,0,0,0" />
              </Grid>
            </Button>

            <!-- System Performance Card -->
            <Button Classes="SettingsListItem" Click="OnSystemSettingItemClicked" Tag="Performance">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="speed" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="20" VerticalAlignment="Center" Foreground="{DynamicResource ContentSecondaryBrush}" Margin="0,0,14,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="System Performance" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ContentPrimaryBrush}" />
                  <TextBlock Text="RAM usage, background processes, and performance profile" FontSize="12" Foreground="{DynamicResource ContentSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="chevron_right" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource ContentTertiaryBrush}" Margin="12,0,0,0" />
              </Grid>
            </Button>

            <!-- Recovery & Maintenance Card -->
            <Button Classes="SettingsListItem" Click="OnSystemSettingItemClicked" Tag="Recovery">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="restore" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="20" VerticalAlignment="Center" Foreground="{DynamicResource ContentSecondaryBrush}" Margin="0,0,14,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="Recovery &amp; Maintenance" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ContentPrimaryBrush}" />
                  <TextBlock Text="System reset, diagnostic logs, and restore options" FontSize="12" Foreground="{DynamicResource ContentSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="chevron_right" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource ContentTertiaryBrush}" Margin="12,0,0,0" />
              </Grid>
            </Button>

            <!-- Clipboard & History Card -->
            <Button Classes="SettingsListItem" Click="OnSystemSettingItemClicked" Tag="Clipboard">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="content_paste" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="20" VerticalAlignment="Center" Foreground="{DynamicResource ContentSecondaryBrush}" Margin="0,0,14,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="Clipboard &amp; History" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ContentPrimaryBrush}" />
                  <TextBlock Text="Clipboard history and cross-device sync" FontSize="12" Foreground="{DynamicResource ContentSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="chevron_right" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource ContentTertiaryBrush}" Margin="12,0,0,0" />
              </Grid>
            </Button>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- SYSTEM SUB-PAGE DETAIL VIEW -->
      <ScrollViewer x:Name="SystemDetailView" IsVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch" MaxWidth="1240" Margin="0,0,16,0">
          <!-- Breadcrumb Navigation Bar -->
          <Border Height="40" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
              <Button Classes="BreadcrumbItem" Click="OnBackToSystemListClicked">
                <TextBlock Text="System" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ContentSecondaryBrush}" />
              </Button>
              <TextBlock Text="chevron_right" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource ContentSecondaryBrush}" Margin="2,0" />
              <TextBlock x:Name="DetailTitleText" Text="Power &amp; Battery" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource ContentPrimaryBrush}" Margin="4,0,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Every category except Appearance is composed into this shared surface at runtime. Keeping
           the page shell here ensures the same compact hierarchy, spacing and focus behavior. -->
      <ScrollViewer x:Name="CategoryView" IsVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
        <Grid Margin="0,0,16,0">
          <StackPanel x:Name="CategoryContent" Spacing="24" HorizontalAlignment="Center" Width="680" Margin="0,4,0,36" />
        </Grid>
      </ScrollViewer>

      <!-- APPEARANCE -->
      <ScrollViewer x:Name="AppearanceView" IsVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
        <Grid Margin="0,0,16,0">
          <StackPanel x:Name="AppearanceContent" Spacing="24" HorizontalAlignment="Center" Width="680" Margin="0,4,0,36">
          <StackPanel Spacing="3">
            <TextBlock Text="Appearance" Classes="SettingsPageTitle" />
          </StackPanel>

          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
              <StackPanel Spacing="3">
                <TextBlock Text="THEME" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ContentTertiaryBrush}" />
                <TextBlock Text="Switch between light and dark mode" FontSize="14" Foreground="{DynamicResource ContentSecondaryBrush}" />
              </StackPanel>
              <ComboBox x:Name="ThemeModePicker" Grid.Column="1" Classes="ThemeModePicker" VerticalAlignment="Center" SelectionChanged="OnThemeModeSelectionChanged">
                <ComboBoxItem Classes="ThemeModeOption" Tag="Light">Light</ComboBoxItem>
                <ComboBoxItem Classes="ThemeModeOption" Tag="Dark">Dark</ComboBoxItem>
                <ComboBoxItem Classes="ThemeModeOption" Tag="Automatic">Automatic</ComboBoxItem>
              </ComboBox>
            </Grid>
            <TextBlock x:Name="AutomaticThemeInfo" IsVisible="False" FontSize="13" Foreground="{DynamicResource ContentSecondaryBrush}" Margin="2,0,0,0" />
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Text="WALLPAPER" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ContentTertiaryBrush}" />
            <Border Height="116" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{DynamicResource RoundedMD}" ClipToBounds="True">
              <Grid>
                <Image x:Name="WallpaperPreviewImage" Source="avares://DaisyOS.Shell/Assets/Wallpapers/Wallpaper.jpg" Stretch="UniformToFill" />
                <Border Background="{DynamicResource OverlayScrimBrush}" />
                <StackPanel Margin="16" VerticalAlignment="Bottom" Spacing="2">
                  <TextBlock x:Name="WallpaperNameText" Text="DaisyOS wallpaper" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock Text="Shown across desktop and console mode" FontSize="13" Foreground="{DynamicResource ContentSecondaryBrush}" />
                </StackPanel>
              </Grid>
            </Border>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Text="Images and video wallpapers are supported." VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource ContentSecondaryBrush}" />
              <Button Grid.Column="1" Classes="SubtleButton" Height="36" Padding="12,0" VerticalContentAlignment="Center" Click="OnPickWallpaperClicked"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6"><TextBlock Text="folder_open" Classes="NavIcon" FontSize="18" /><TextBlock Text="Choose file" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel></Button>
              <Button Grid.Column="2" Classes="ShellButton" Padding="8,7" Click="OnResetWallpaperClicked" ToolTip.Tip="Restore DaisyOS wallpaper"><TextBlock Text="restart_alt" Classes="NavIcon" FontSize="18" /></Button>
            </Grid>
          </StackPanel>

          <Border Background="{DynamicResource StrokeDefaultBrush}" Height="1" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Spacing="3"><TextBlock Text="Accent color" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="Applied to controls and focus states." FontSize="13" Foreground="{DynamicResource ContentSecondaryBrush}" /></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
              <Button x:Name="AccentDefaultButton" Classes="AccentSwatch" Tag="Default" Click="OnAccentColorClicked" Background="{DynamicResource AccentOptionDefaultBrush}" ToolTip.Tip="Default" />
              <Button x:Name="AccentBlueButton" Classes="AccentSwatch" Tag="Blue" Click="OnAccentColorClicked" Background="{DynamicResource AccentOptionBlueBrush}" ToolTip.Tip="Blue" />
              <Button x:Name="AccentPurpleButton" Classes="AccentSwatch" Tag="Purple" Click="OnAccentColorClicked" Background="{DynamicResource AccentOptionPurpleBrush}" ToolTip.Tip="Purple" />
              <Button x:Name="AccentPinkButton" Classes="AccentSwatch" Tag="Pink" Click="OnAccentColorClicked" Background="{DynamicResource AccentOptionPinkBrush}" ToolTip.Tip="Pink" />
              <Button x:Name="AccentRedButton" Classes="AccentSwatch" Tag="Red" Click="OnAccentColorClicked" Background="{DynamicResource AccentOptionRedBrush}" ToolTip.Tip="Red" />
              <Button x:Name="AccentOrangeButton" Classes="AccentSwatch" Tag="Orange" Click="OnAccentColorClicked" Background="{DynamicResource AccentOptionOrangeBrush}" ToolTip.Tip="Orange" />
              <Button x:Name="AccentGreenButton" Classes="AccentSwatch" Tag="Green" Click="OnAccentColorClicked" Background="{DynamicResource AccentOptionGreenBrush}" ToolTip.Tip="Green" />
              <Button x:Name="AccentGrayButton" Classes="AccentSwatch" Tag="Gray" Click="OnAccentColorClicked" Background="{DynamicResource AccentOptionGrayBrush}" ToolTip.Tip="Gray" />
            </StackPanel>
          </Grid>

          <Border Background="{DynamicResource StrokeDefaultBrush}" Height="1" />
          <StackPanel Spacing="12">
            <TextBlock Text="ACCESSIBILITY" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ContentTertiaryBrush}" />
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="14" ColumnSpacing="20">
              <StackPanel Spacing="2"><TextBlock Text="High contrast" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Increase contrast between text and surfaces." FontSize="13" Foreground="{DynamicResource ContentSecondaryBrush}" /></StackPanel>
              <ToggleSwitch x:Name="HighContrastToggle" Grid.Column="1" VerticalAlignment="Center" Click="OnHighContrastToggled" />
              <StackPanel Grid.Row="1" Spacing="2"><TextBlock Text="Reduce desktop motion" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Turn off desktop item movement animations." FontSize="13" Foreground="{DynamicResource ContentSecondaryBrush}" /></StackPanel>
              <ToggleSwitch x:Name="ReduceMotionToggle" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Click="OnReduceMotionToggled" />
            </Grid>
          </StackPanel>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
