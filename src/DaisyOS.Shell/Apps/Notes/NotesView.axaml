<UserControl
    x:Class="DaisyOS.Shell.Apps.Notes.NotesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:notes="clr-namespace:DaisyOS.Shell.Apps.Notes"
    xmlns:controls="clr-namespace:DaisyOS.Shell.Controls">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveNoteCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <!-- Sidebar navigation button layout - 100% identical to Settings app -->
    <Style Selector="Button.SettingsNavItem">
      <Setter Property="Height" Value="40" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style Selector="TextBlock.NavIcon">
      <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Width" Value="24" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="TextBlock.NavLabel">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.SettingsNavItem.Active TextBlock.NavIcon, Button.SettingsNavItem.Active TextBlock.NavLabel">
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
    </Style>

    <!-- Seamless Editor TextBoxes -->
    <Style Selector="TextBox.EditorTextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TextBox.EditorTextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.EditorTextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="240,*" Background="{DynamicResource SystemBarMaterialBrush}">
    <!-- Transparent Sidebar Container (matching Settings 240px sidebar) -->
    <Border Grid.Column="0" Background="Transparent" Padding="12,12,8,12">
      <Grid RowDefinitions="Auto,Auto,*">
        <!-- Search Bar -->
        <controls:SearchBar Grid.Row="0"
                            Text="{Binding SearchQuery, Mode=TwoWay}"
                            Height="40"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Stretch"
                            CornerRadius="6"
                            PlaceholderText="Search notes..." />

        <!-- Action Buttons -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,0,0,12">
          <!-- New Note Button -->
          <Button Grid.Column="0" Classes="SettingsNavItem"
                  Margin="0,0,4,0"
                  Command="{Binding AddNoteCommand}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="add" Classes="NavIcon" />
              <TextBlock Text="New" Classes="NavLabel" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          
          <!-- Open File Button -->
          <Button Grid.Column="1" Classes="SettingsNavItem"
                  Margin="4,0,0,0"
                  Click="OnOpenFileClick">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="folder_open" Classes="NavIcon" />
              <TextBlock Text="Open" Classes="NavLabel" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
        </Grid>

        <!-- Scrollable List of Notes -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="6">
            <ItemsControl ItemsSource="{Binding FilteredNotes}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type notes:NoteItem}">
                  <StackPanel>
                    <Button Classes="SettingsNavItem"
                            HorizontalContentAlignment="Stretch"
                            Classes.Active="{Binding IsSelected}"
                            Command="{Binding $parent[UserControl].DataContext.SelectNoteCommand}"
                            CommandParameter="{Binding}">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Rename Note" Click="OnRenameNoteClicked">
                            <MenuItem.Icon>
                              <TextBlock Text="edit" Classes="MenuIcon"/>
                            </MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="Toggle Pin" Command="{Binding $parent[UserControl].DataContext.PinNoteCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon>
                              <TextBlock Text="keep" Classes="MenuIcon"/>
                            </MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="Duplicate" Command="{Binding $parent[UserControl].DataContext.DuplicateNoteCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon>
                              <TextBlock Text="file_copy" Classes="MenuIcon"/>
                            </MenuItem.Icon>
                          </MenuItem>
                          <Separator/>
                          <MenuItem Header="Delete Note" Command="{Binding $parent[UserControl].DataContext.DeleteNoteCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon>
                              <TextBlock Text="delete" Classes="MenuIcon"/>
                            </MenuItem.Icon>
                          </MenuItem>
                        </ContextMenu>
                      </Button.ContextMenu>
                      <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <Grid RowDefinitions="Auto,Auto" HorizontalAlignment="Left" Margin="12,0,24,0">
                          <Panel Grid.Row="0">
                            <TextBlock Text="New Note" Classes="NavLabel" Margin="0" FontStyle="{Binding FontStyle}" TextTrimming="CharacterEllipsis" IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                            <TextBlock Text="{Binding Title}" Classes="NavLabel" Margin="0" FontStyle="{Binding FontStyle}" TextTrimming="CharacterEllipsis" IsVisible="{Binding Title, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          </Panel>
                          <TextBlock Grid.Row="1" Text="{Binding LastModified, StringFormat='MMM d, yyyy  HH:mm'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </Grid>
                        <TextBlock Text="keep" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="14" Foreground="{DynamicResource AppPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding IsPinned}" />
                      </Grid>
                    </Button>
                    <Rectangle Height="1" Fill="{DynamicResource ShellSurfaceBorderBrush}" Margin="12,4,12,4" IsVisible="{Binding ShowDivider}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- Divider Line -->
    <Rectangle Grid.Column="0" 
               HorizontalAlignment="Right" 
               VerticalAlignment="Stretch"
               Width="1" 
               Fill="{DynamicResource ShellSurfaceBorderBrush}" 
               Margin="0,0,0,44" />

    <!-- Main Content Area -->
    <Grid Grid.Column="1">
      <!-- Empty State Placeholder (Visible when no note is selected) -->
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="16"
                  IsVisible="{Binding SelectedNote, Converter={x:Static ObjectConverters.IsNull}}">
        <TextBlock Text="edit_document"
                   FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                   FontSize="64"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Opacity="0.5"
                   TextAlignment="Center" />
        <TextBlock Text="Start by creating a note"
                   FontSize="16"
                   FontWeight="Medium"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Opacity="0.7"
                   TextAlignment="Center" />
      </StackPanel>
      
      <!-- Editor Area (Visible when a note is selected) -->
      <ScrollViewer IsVisible="{Binding SelectedNote, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Padding="48,48,48,48"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
          <!-- Content Input -->
          <TextBox x:Name="ContentTextBox"
                   Classes="EditorTextBox"
                   Text="{Binding SelectedNote.Content, Mode=TwoWay}"
                   FontSize="15"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="400">
            <TextBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Cut" Click="OnCutClicked">
                  <MenuItem.Icon>
                    <TextBlock Text="content_cut" Classes="MenuIcon"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Copy" Click="OnCopyClicked">
                  <MenuItem.Icon>
                    <TextBlock Text="content_copy" Classes="MenuIcon"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Paste" Click="OnPasteClicked">
                  <MenuItem.Icon>
                    <TextBlock Text="content_paste" Classes="MenuIcon"/>
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </TextBox.ContextMenu>
          </TextBox>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
