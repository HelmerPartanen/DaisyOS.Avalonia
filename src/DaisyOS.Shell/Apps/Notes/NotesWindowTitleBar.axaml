<UserControl
    x:Class="DaisyOS.Shell.Apps.Notes.NotesWindowTitleBar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DaisyOS.Shell.Apps.Notes"
    xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
    Height="44">
  <UserControl.Styles>
    <Style Selector="Button.CaptionButton">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.CaptionButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TaskbarHoverBrush}" />
    </Style>
    <Style Selector="Button.CaptionButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TaskbarPressedBrush}" />
    </Style>
    <Style Selector="Button.CaptionClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E81123" />
    </Style>
    <Style Selector="Button.CaptionClose:pointerover TextBlock.CaptionIcon">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.CaptionClose:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C42B1C" />
    </Style>
    <Style Selector="Button.CaptionClose:pressed TextBlock.CaptionIcon">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="TextBlock.CaptionIcon">
      <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.CaptionIcon.CaptionMaximizeIcon">
      <Setter Property="FontSize" Value="15" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource SystemBarMaterialBrush}"
          BorderThickness="0"
          PointerPressed="OnTitleBarPointerPressed"
          DoubleTapped="OnTitleBarDoubleTapped">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="12,0,10,0">
        <Image Source="avares://DaisyOS.Shell/Assets/AppIcons/NotesIcon.png"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               Width="20" Height="20" IsHitTestVisible="False" />
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=local:NotesWindowTitleBar}}"
                   FontSize="13" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Classes="CaptionButton" Click="OnMinimizeClicked" ToolTip.Tip="Minimize">
          <TextBlock Text="remove" Classes="CaptionIcon" />
        </Button>
        <Button Classes="CaptionButton" Click="OnMaximizeRestoreClicked" ToolTip.Tip="Maximize or restore">
          <TextBlock Text="crop_square" Classes="CaptionIcon CaptionMaximizeIcon" />
        </Button>
        <Button Classes="CaptionButton CaptionClose" Click="OnCloseClicked" ToolTip.Tip="Close">
          <TextBlock Text="close" Classes="CaptionIcon" />
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
