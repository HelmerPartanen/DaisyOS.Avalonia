<Window
    x:Class="DaisyOS.Shell.Apps.Calculator.CalculatorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:calculator="clr-namespace:DaisyOS.Shell.Apps.Calculator"
    xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
    Title="Calculator"
    Width="360"
    Height="560"
    CanResize="True"
    WindowStartupLocation="CenterScreen"
    WindowDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="44"
    TextOptions.TextRenderingMode="SubpixelAntialias"
    Background="Transparent"
    PointerPressed="OnWindowPointerPressed">
  <Grid>
    <!-- Frame border and rounded clipping container -->
    <Border x:Name="AppFrame"
            Classes="AppWindowFrame"
            Margin="12"
            Background="{DynamicResource ShellFrameOuterEdgeBrush}"
            Padding="1"
            CornerRadius="{DynamicResource RoundedLG}">
      <Border x:Name="FrameHighlight" Classes="AppWindowFrameHighlight" Background="{DynamicResource ShellFrameInnerHighlightBrush}"
              Padding="1" CornerRadius="{DynamicResource RoundedLGInset}">
        <Border x:Name="ContentFrame" Classes="AppWindowContentFrame" Background="{DynamicResource SurfaceBaseBrush}"
                CornerRadius="{DynamicResource RoundedMD}"
                ClipToBounds="True">
          <Grid x:Name="ContentLayout" RowDefinitions="44,*">
            <calculator:CalculatorWindowTitleBar x:Name="TitleBar" Title="Calculator" />
            <calculator:CalculatorView Grid.Row="1" DataContext="{Binding}" />
          </Grid>
        </Border>
      </Border>
    </Border>

    <!-- App Performance Overlay Layer -->
    <controls:AppPerformanceOverlay x:Name="PerfOverlay" AppName="Calculator" IsOverlayVisible="False" Margin="0,48,16,0" />

  </Grid>
</Window>
