<Window
    x:Class="DaisyOS.Shell.Apps.Calculator.CalculatorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:calculator="clr-namespace:DaisyOS.Shell.Apps.Calculator"
    xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
    xmlns:compositor="clr-namespace:DaisyOS.Shell.Services.Compositor"
    Title="Calculator"
    Width="360"
    Height="560"
    CanResize="False"
    WindowStartupLocation="CenterScreen"
    WindowDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="44"
    TextOptions.TextRenderingMode="Antialias"
    Background="Transparent"
    PointerPressed="OnWindowPointerPressed">
  <Grid>
    <!-- Frame border and rounded clipping container -->
    <Border x:Name="AppFrame"
            Classes="AppWindowFrame"
            Margin="12"
            Background="{DynamicResource DividerBrush}"
            Padding="1"
            CornerRadius="{DynamicResource RoundedLG}"
            compositor:KWinBlur.IsEnabled="True"
            compositor:KWinBlur.CornerRadius="{DynamicResource RoundedLGValue}">
      <Border Background="{DynamicResource SecondarySurfaceBrush}"
              CornerRadius="{DynamicResource RoundedLGInset}"
              ClipToBounds="True">
        <Grid RowDefinitions="44,*">
          <calculator:CalculatorWindowTitleBar Title="Calculator" />
          <calculator:CalculatorView Grid.Row="1" DataContext="{Binding}" />
        </Grid>
      </Border>
    </Border>

    <!-- App Performance Overlay Layer -->
    <controls:AppPerformanceOverlay x:Name="PerfOverlay" AppName="Calculator" IsOverlayVisible="True" Margin="0,48,16,0" />

  </Grid>
</Window>
