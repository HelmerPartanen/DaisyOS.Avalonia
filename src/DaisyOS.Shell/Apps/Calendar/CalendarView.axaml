<UserControl
    x:Class="DaisyOS.Shell.Apps.Calendar.CalendarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:calendar="clr-namespace:DaisyOS.Shell.Apps.Calendar"
    xmlns:systemBar="clr-namespace:DaisyOS.Shell.Views.Components.SystemBar"
    x:DataType="calendar:CalendarViewModel"
    Background="Transparent">

  <UserControl.Styles>
    <Style Selector="Button.CalendarNavButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedSM}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.CalendarNavButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource GhostHoverBrush}" />
    </Style>
    <Style Selector="Button.CalendarNavButton:pressed">
      <Setter Property="Background" Value="{DynamicResource GhostPressedBrush}" />
    </Style>

    <Style Selector="Border.CalendarCard">
      <Setter Property="Background" Value="{DynamicResource TertiarySurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedLG}" />
    </Style>

    <Style Selector="Border.WeekDay">
      <Setter Property="Height" Value="54" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.DayNumberBadge">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.DayNumberBadge.IsToday">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.DayNumberBadge.IsToday TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Border.EventBlock">
      <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentDividerBrush}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedSM}" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Border.TimelineColumn, Border.TimelineHour">
      <Setter Property="Opacity" Value="0.58" />
    </Style>
    <Style Selector="Button.CalendarPrimaryAction">
      <Setter Property="MinWidth" Value="110" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="228,1,*,1,208" Background="{DynamicResource PrimarySurfaceBrush}">

    <!-- Month navigator and intentionally sparse calendar source list. -->
    <Border Grid.Column="0" Background="{DynamicResource PrimarySurfaceBrush}">
      <ScrollViewer>
        <StackPanel Spacing="20" Margin="16,18">
          <systemBar:CustomCalendarView Margin="-4,0" />

          <Border Height="1" Background="{DynamicResource DividerBrush}" />

          <StackPanel Spacing="8">
            <TextBlock Text="CALENDARS" FontSize="10" FontWeight="SemiBold" LetterSpacing="0.8" Foreground="{DynamicResource TextMutedBrush}" />
            <Border Classes="CalendarCard" Padding="12">
              <StackPanel Spacing="8">
                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentSurfaceBrush}" HorizontalAlignment="Left">
                  <TextBlock Text="event_available" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="17" Foreground="{DynamicResource OnAccentSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Your schedule" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="No events to show in this view." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Divider -->
    <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" />

    <!-- Week agenda. The grid remains useful with no events and never fabricates a schedule. -->
    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,20,24,16">
        <StackPanel Spacing="3">
          <TextBlock Text="{Binding CurrentMonthYear}" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="{Binding WeekRange}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="Active CalendarPrimaryAction" Height="34" Padding="12,0" Command="{Binding OpenEventComposerCommand}" ToolTip.Tip="Create an event">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="add" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="16" />
              <TextBlock Text="New event" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="{DynamicResource RoundedPill}" Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="view_week" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="15" Foreground="{DynamicResource OnAccentSurfaceBrush}" />
              <TextBlock Text="Week" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentSurfaceBrush}" />
            </StackPanel>
          </Border>
          <Button Classes="ShellButton" Height="32" Padding="10,0" Command="{Binding GoToTodayCommand}" ToolTip.Tip="Return to today">
            <TextBlock Text="Today" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
          </Button>
          <Border Width="1" Height="20" Background="{DynamicResource DividerBrush}" Margin="2,0" />
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Classes="ShellButton" Width="32" Height="32" Padding="0" CornerRadius="16" Command="{Binding PreviousWeekCommand}" ToolTip.Tip="Previous week">
              <TextBlock Text="chevron_left" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                         FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="ShellButton" Width="32" Height="32" Padding="0" CornerRadius="16" Command="{Binding NextWeekCommand}" ToolTip.Tip="Next week">
              <TextBlock Text="chevron_right" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                         FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="58,*" Margin="16,0,16,12">
        <ItemsControl Grid.Column="1" ItemsSource="{Binding WeekDays}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="7" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="calendar:CalendarDayViewModel">
              <Border Classes="WeekDay" Margin="2,0">
                <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DayName}" HorizontalAlignment="Center" FontWeight="Medium" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                  <Border Classes="DayNumberBadge" Classes.IsToday="{Binding IsToday}">
                    <TextBlock Text="{Binding DayNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="16" />
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>

      <ScrollViewer Grid.Row="2" Margin="16,0,16,16">
        <Grid ColumnDefinitions="58,*" Height="600">
          <Grid Grid.Column="0" RowDefinitions="60,60,60,60,60,60,60,60,60,60" IsHitTestVisible="False">
            <TextBlock Grid.Row="0" Text="{Binding Time8}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
            <TextBlock Grid.Row="1" Text="{Binding Time9}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
            <TextBlock Grid.Row="2" Text="{Binding Time10}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
            <TextBlock Grid.Row="3" Text="{Binding Time11}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
            <TextBlock Grid.Row="4" Text="{Binding Time12}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
            <TextBlock Grid.Row="5" Text="{Binding Time13}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
            <TextBlock Grid.Row="6" Text="{Binding Time14}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
            <TextBlock Grid.Row="7" Text="{Binding Time15}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
            <TextBlock Grid.Row="8" Text="{Binding Time16}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
            <TextBlock Grid.Row="9" Text="{Binding Time17}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
            <TextBlock Text="{Binding Time18}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,-7" />
          </Grid>

          <Grid Grid.Column="1" RowDefinitions="60,60,60,60,60,60,60,60,60,60" ColumnDefinitions="*,*,*,*,*,*,*" ClipToBounds="True">
            <Border Classes="TimelineColumn" Grid.RowSpan="10" Grid.Column="0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,1,0,1" />
            <Border Classes="TimelineColumn" Grid.RowSpan="10" Grid.Column="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,1,0,1" />
            <Border Classes="TimelineColumn" Grid.RowSpan="10" Grid.Column="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,1,0,1" />
            <Border Classes="TimelineColumn" Grid.RowSpan="10" Grid.Column="3" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,1,0,1" />
            <Border Classes="TimelineColumn" Grid.RowSpan="10" Grid.Column="4" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,1,0,1" />
            <Border Classes="TimelineColumn" Grid.RowSpan="10" Grid.Column="5" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,1,0,1" />
            <Border Classes="TimelineColumn" Grid.RowSpan="10" Grid.Column="6" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,1,1,1" />

            <Border Classes="TimelineHour" Grid.Row="1" Grid.ColumnSpan="7" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Top" />
            <Border Classes="TimelineHour" Grid.Row="2" Grid.ColumnSpan="7" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Top" />
            <Border Classes="TimelineHour" Grid.Row="3" Grid.ColumnSpan="7" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Top" />
            <Border Classes="TimelineHour" Grid.Row="4" Grid.ColumnSpan="7" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Top" />
            <Border Classes="TimelineHour" Grid.Row="5" Grid.ColumnSpan="7" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Top" />
            <Border Classes="TimelineHour" Grid.Row="6" Grid.ColumnSpan="7" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Top" />
            <Border Classes="TimelineHour" Grid.Row="7" Grid.ColumnSpan="7" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Top" />
            <Border Classes="TimelineHour" Grid.Row="8" Grid.ColumnSpan="7" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Top" />
            <Border Classes="TimelineHour" Grid.Row="9" Grid.ColumnSpan="7" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Top" />

            <Canvas IsVisible="{Binding IsCurrentWeek}" IsHitTestVisible="False">
              <Border Height="2" Width="2000" Background="{DynamicResource DangerBrush}" Canvas.Top="{Binding CurrentTimeTopOffset}">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource DangerBrush}" Margin="-4,-3,0,0" HorizontalAlignment="Left" />
              </Border>
            </Canvas>

            <ItemsControl Grid.RowSpan="10" Grid.ColumnSpan="7" ItemsSource="{Binding Events}">
              <ItemsControl.Styles>
                <Style Selector="ContentPresenter">
                  <Setter Property="Grid.Column" Value="{Binding Column}" />
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <Grid ColumnDefinitions="*,*,*,*,*,*,*" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="calendar:CalendarEventViewModel">
                  <Border Classes="EventBlock" Margin="{Binding Margin}" Height="{Binding Height}" VerticalAlignment="Top">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding TimeRange}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </Grid>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- Divider -->
    <Border Grid.Column="3" Background="{DynamicResource DividerBrush}" />

    <!-- The composer opens from the primary action and saves real local events. -->
    <Border Grid.Column="4" Background="{DynamicResource PrimarySurfaceBrush}">
      <Grid>
        <StackPanel IsVisible="{Binding IsEventComposerClosed}" Spacing="16" Margin="18,22">
          <TextBlock Text="CALENDAR" FontSize="10" FontWeight="SemiBold" LetterSpacing="0.8" Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Text="Plan your week" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Create an event to place it directly in the week view." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
          <TextBlock Text="Use New event above to add your first event." FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel IsVisible="{Binding IsEventComposerOpen}" Spacing="14" Margin="18,22">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="NEW EVENT" FontSize="10" FontWeight="SemiBold" LetterSpacing="0.8" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ShellButton" Width="28" Height="28" Command="{Binding CancelEventComposerCommand}" ToolTip.Tip="Cancel">
              <TextBlock Text="close" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="17" />
            </Button>
          </Grid>

          <StackPanel Spacing="6">
            <TextBlock Text="Title" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Text="{Binding NewEventTitle}" PlaceholderText="What are you planning?" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Date" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
            <CalendarDatePicker SelectedDate="{Binding NewEventDate}" />
          </StackPanel>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Spacing="6">
              <TextBlock Text="Starts" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBox Text="{Binding NewEventStartTime}" PlaceholderText="{Binding StartTimePlaceholder}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="Ends" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBox Text="{Binding NewEventEndTime}" PlaceholderText="{Binding EndTimePlaceholder}" />
            </StackPanel>
          </Grid>

          <TextBlock Text="{Binding EventComposerError}" IsVisible="{Binding HasEventComposerError}" FontSize="11" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />

          <Button Classes="Active" Height="38" Command="{Binding SaveEventCommand}">
            <TextBlock Text="Save event" FontSize="12" FontWeight="SemiBold" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</UserControl>
