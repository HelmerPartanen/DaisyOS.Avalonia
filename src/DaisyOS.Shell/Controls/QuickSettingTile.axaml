<UserControl x:Class="DaisyOS.Shell.Controls.QuickSettingTile"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="96">
  <UserControl.Styles>
    <Style Selector="ToggleButton.QuickActionSingle">
      <Setter Property="Width" Value="96"/>
      <Setter Property="Height" Value="56"/>
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedMD}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ToggleButton.QuickActionSplit">
      <Setter Property="Width" Value="68"/>
      <Setter Property="Height" Value="56"/>
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedMDLeft}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.QuickSettingDetails">
      <Setter Property="Width" Value="27"/>
      <Setter Property="Height" Value="56"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedMDRight}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- A split pair is one control. The chevron deliberately uses the exact same inactive
         and disabled material as the toggle beside it, rather than the platform button state. -->
    <Style Selector="Button.QuickSettingDetails:not(.Active)">
      <Setter Property="Background" Value="{DynamicResource ActionSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.QuickSettingDetails:disabled">
      <Setter Property="Background" Value="{DynamicResource ActionSecondaryBrush}"/>
      <Setter Property="Opacity" Value="0.48"/>
    </Style>
    <!-- Controller focus must be as explicit as pointer hover. The shared tiles are used in
         console mode where there is no cursor to reveal the current destination. -->
    <Style Selector="ToggleButton.QuickSetting:focus-visible /template/ ContentPresenter#PART_ContentPresenter, Button.QuickSettingDetails:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource ActionPrimaryBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Border.QuickSettingSplitDivider">
      <Setter Property="Background" Value="{DynamicResource StrokeDefaultBrush}"/>
    </Style>
    <Style Selector="Border.QuickSettingSplitDivider.Active">
      <Setter Property="Background" Value="{DynamicResource FocusRingBrush}"/>
    </Style>
    <Style Selector="TextBlock.QuickSettingLabel">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource ContentSecondaryBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="6" Width="96" HorizontalAlignment="Center">
    <!-- Single Action Tile -->
    <Grid IsVisible="{Binding !HasDetails, ElementName=Root}" Width="96" Height="56">
      <ToggleButton x:Name="SingleToggle"
                    Classes="ShellButton QuickActionSingle QuickSetting"
                    Classes.Active="{Binding IsChecked, ElementName=Root}"
                    IsChecked="{Binding IsChecked, ElementName=Root, Mode=TwoWay}"
                    ToolTip.Tip="{Binding ToolTipText, ElementName=Root}"
                    Click="OnSingleToggleClick">
        <TextBlock Classes="QuickSettingIcon"
                   Text="{Binding Icon, ElementName=Root}"
                   FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                   FontSize="18"/>
      </ToggleButton>
    </Grid>

    <!-- Split Tile (Action + Divider + Details Chevron) -->
    <Grid IsVisible="{Binding HasDetails, ElementName=Root}" Height="56" Width="96" ColumnDefinitions="68,1,27">
        <ToggleButton x:Name="SplitToggle"
                      Grid.Column="0"
                      Classes="ShellButton QuickActionSplit QuickSetting"
                      Classes.Active="{Binding IsChecked, ElementName=Root}"
                      IsChecked="{Binding IsChecked, ElementName=Root, Mode=TwoWay}"
                      ToolTip.Tip="{Binding ToolTipText, ElementName=Root}"
                      Click="OnSplitToggleClick">
          <TextBlock Classes="QuickSettingIcon"
                     Text="{Binding Icon, ElementName=Root}"
                     FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                     FontSize="18"/>
        </ToggleButton>

        <Border x:Name="SplitDivider"
                Grid.Column="1"
                Classes="QuickSettingSplitDivider"
                Classes.Active="{Binding IsChecked, ElementName=Root}"
                IsHitTestVisible="False"/>

        <Button x:Name="DetailsButton"
                Grid.Column="2"
                Classes="ShellButton QuickSettingDetails"
                Classes.Active="{Binding IsChecked, ElementName=Root}"
                Click="OnDetailsButtonClick"
                ToolTip.Tip="{Binding DetailsToolTipText, ElementName=Root}">
          <TextBlock Classes="QuickSettingIcon"
                     Text="chevron_right"
                     FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                     FontSize="18"/>
        </Button>
    </Grid>

    <!-- Subtitle Label -->
    <TextBlock Classes="QuickSettingLabel"
               Classes.Active="{Binding IsChecked, ElementName=Root}"
               Text="{Binding Label, ElementName=Root}"/>
  </StackPanel>
</UserControl>
