<UserControl
    x:Class="DaisyOS.Shell.Controls.ShellMetricsPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Right"
    VerticalAlignment="Stretch"
    Margin="0,36,16,16"
    ZIndex="950">

  <UserControl.Styles>
    <Style Selector="Border.MetricsPanelCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedLG}" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="BoxShadow" Value="{DynamicResource ElevationDialogShadow}" />
    </Style>

    <Style Selector="Border.SummaryTile">
      <Setter Property="Background" Value="{DynamicResource StateSelectedBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedMD}" />
      <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style Selector="TextBlock.IconSymbol">
      <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.HeaderButton">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedPill}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.HeaderButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    </Style>
    <Style Selector="Button.HeaderButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StatePressedBrush}" />
    </Style>

    <Style Selector="Button.SortChip">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Background" Value="{DynamicResource StateSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedPill}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource ContentSecondaryBrush}" />
    </Style>
    <Style Selector="Button.SortChip.Active">
      <Setter Property="Background" Value="{DynamicResource ActionPrimaryBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid Name="RootContainer">
    <Border Classes="MetricsPanelCard" Width="420" MaxHeight="800">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Background="{DynamicResource ActionPrimaryBrush}" CornerRadius="{DynamicResource RoundedMD}" Padding="8">
              <TextBlock Text="monitoring" Classes="IconSymbol" Foreground="White" FontSize="20" />
            </Border>
            <StackPanel Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Shell Resource Metrics" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource ContentPrimaryBrush}" />
                <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="{DynamicResource RoundedXS}" Padding="5,2" VerticalAlignment="Center">
                  <TextBlock Name="TxtPid" Text="PID 0" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ContentSecondaryBrush}" />
                </Border>
              </StackPanel>
              <TextBlock Text="DaisyOS Shell Internal Performance" FontSize="11" Foreground="{DynamicResource ContentTertiaryBrush}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
            <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="{DynamicResource RoundedPill}" Padding="8,4" VerticalAlignment="Center" Margin="0,0,4,0">
              <TextBlock Text="CTRL+R" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ActionPrimaryBrush}" />
            </Border>
            <Button Classes="HeaderButton" Click="OnCloseClicked" ToolTip.Tip="Close panel (CTRL+R)">
              <TextBlock Text="close" Classes="IconSymbol" Foreground="{DynamicResource ContentSecondaryBrush}" FontSize="18" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- Process Overall Summary Cards Grid -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" Margin="0,0,0,16">
          <!-- CPU -->
          <Border Grid.Row="0" Grid.Column="0" Classes="SummaryTile" Margin="0,0,4,4">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Name="IconCpu" Text="speed" Classes="IconSymbol" Foreground="{DynamicResource StatusSuccessBrush}" FontSize="16" />
                <TextBlock Text="Shell CPU" FontSize="11" Foreground="{DynamicResource ContentSecondaryBrush}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Name="TxtShellCpu" Text="0.0%" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ContentPrimaryBrush}" />
            </StackPanel>
          </Border>

          <!-- RAM -->
          <Border Grid.Row="0" Grid.Column="1" Classes="SummaryTile" Margin="4,0,0,4">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="memory" Classes="IconSymbol" Foreground="{DynamicResource StatusInfoBrush}" FontSize="16" />
                <TextBlock Text="GC Memory" FontSize="11" Foreground="{DynamicResource ContentSecondaryBrush}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                <TextBlock Name="TxtGcRam" Text="0 MB" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ContentPrimaryBrush}" />
                <TextBlock Name="TxtWorkingSet" Text="(0 MB WS)" FontSize="10" Foreground="{DynamicResource ContentTertiaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Threads & Handles -->
          <Border Grid.Row="1" Grid.Column="0" Classes="SummaryTile" Margin="0,4,4,0">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="account_tree" Classes="IconSymbol" Foreground="{DynamicResource StatusWarningBrush}" FontSize="16" />
                <TextBlock Text="Threads &amp; Handles" FontSize="11" Foreground="{DynamicResource ContentSecondaryBrush}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Name="TxtThreads" Text="0 thr" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ContentPrimaryBrush}" />
                <TextBlock Text="/" Foreground="{DynamicResource ContentTertiaryBrush}" />
                <TextBlock Name="TxtHandles" Text="0 hnd" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ContentPrimaryBrush}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Uptime -->
          <Border Grid.Row="1" Grid.Column="1" Classes="SummaryTile" Margin="4,4,0,0">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="timer" Classes="IconSymbol" Foreground="{DynamicResource StatusInfoBrush}" FontSize="16" />
                <TextBlock Text="Shell Runtime" FontSize="11" Foreground="{DynamicResource ContentSecondaryBrush}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Name="TxtUptime" Text="00:00:00" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ContentPrimaryBrush}" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Component Ranking Header & Sort Bar -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,10">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="pie_chart" Classes="IconSymbol" Foreground="{DynamicResource ContentSecondaryBrush}" FontSize="16" />
            <TextBlock Text="Component Resource Usage" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ContentPrimaryBrush}" />
          </StackPanel>

          <!-- Sort Selector -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button Name="BtnSortCpu" Classes="SortChip Active" Click="OnSortCpuClicked" Content="CPU" />
            <Button Name="BtnSortMemory" Classes="SortChip" Click="OnSortMemoryClicked" Content="RAM" />
            <Button Name="BtnSortComplexity" Classes="SortChip" Click="OnSortComplexityClicked" Content="Elements" />
          </StackPanel>
        </Grid>

        <!-- Components Scrollable List -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
          <StackPanel Name="ComponentsContainer" Spacing="8" />
        </ScrollViewer>

        <!-- Footer Notice -->
        <Border Grid.Row="4" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="{DynamicResource RoundedSM}" Padding="10,6">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Text="verified_user" Classes="IconSymbol" Foreground="{DynamicResource StatusSuccessBrush}" FontSize="14" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="Isolated strictly to DaisyOS Shell process components" FontSize="10" Foreground="{DynamicResource ContentSecondaryBrush}" VerticalAlignment="Center" />
          </Grid>
        </Border>

      </Grid>
    </Border>
  </Grid>
</UserControl>
