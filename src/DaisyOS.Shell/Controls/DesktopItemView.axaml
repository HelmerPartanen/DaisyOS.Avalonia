<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DaisyOS.Shell.ViewModels"
             xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
             x:Class="DaisyOS.Shell.Controls.DesktopItemView"
             Width="74" Height="88">
  <UserControl.Styles>
    <Style Selector="Border#CellCard">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedMD}" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.1" Easing="QuadraticEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="controls|DesktopItemView[IsHiddenPlaceholder=True] Border#CellCard">
      <Setter Property="Opacity" Value="0.0" />
    </Style>

    <Style Selector="Border#CellCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource GhostHoverBrush}" />
    </Style>

    <Style Selector="Border#CellCard:pressed">
      <Setter Property="Background" Value="{DynamicResource GhostPressedBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Name="CellCard" Padding="4,4,4,2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid RowDefinitions="Auto,*">
      <Border Name="IconWrapper" Grid.Row="0" Width="48" Height="48" HorizontalAlignment="Center">
        <Image Name="AppIcon" 
               Source="{Binding IconBitmap}" 
               RenderOptions.BitmapInterpolationMode="HighQuality" />
      </Border>

      <!-- Label below the icon -->
      <TextBlock Grid.Row="1"
                 Text="{Binding Label}"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 TextTrimming="CharacterEllipsis"
                 MaxLines="2"
                 Margin="0,4,0,0"
                 FontSize="11"
                 Foreground="{DynamicResource DesktopItemLabelBrush}"
                 Effect="{DynamicResource DesktopItemLabelShadow}" />
    </Grid>
  </Border>
</UserControl>
