<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DaisyOS.Shell.Controls.DesktopItemView"
             Width="74" Height="88">
  <!-- The width and height act as the logical footprint for rendering.
       They are usually overridden or scaled by the grid placement math in code behind,
       but this provides a sensible fallback at 96 DPI. -->
  <UserControl.Styles>
    <Style Selector="Grid#ContainerGrid:pointerover Border#IconWrapper">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Grid#ContainerGrid:pressed Border#IconWrapper">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
  </UserControl.Styles>

  <Grid Name="ContainerGrid" Background="Transparent" RowDefinitions="Auto,*">
    <!-- Icon centered near the top -->
    <Border Name="IconWrapper" Grid.Row="0" Width="48" Height="48" Margin="0,4,0,0">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.1" Easing="QuadraticEaseOut" />
        </Transitions>
      </Border.Transitions>
      <Image Name="AppIcon" 
             Source="{Binding IconBitmap}" 
             RenderOptions.BitmapInterpolationMode="HighQuality" />
    </Border>

    <!-- Label below the icon, wraps lines, centered -->
    <TextBlock Grid.Row="1"
               Text="{Binding Label}"
               TextAlignment="Center"
               TextWrapping="Wrap"
               TextTrimming="CharacterEllipsis"
               MaxLines="2"
               Margin="2,4,2,0"
               FontSize="11" />
  </Grid>
</UserControl>
