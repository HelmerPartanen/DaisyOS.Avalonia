<UserControl x:Class="DaisyOS.Shell.Controls.ConsolePillSlider"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             ClipToBounds="False">

  <UserControl.Styles>
    <Style Selector="TextBlock.SliderIcon">
      <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.ArrowBtn">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextPrimaryBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="0,0,0,0" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="TextBlock.ArrowIcon">
      <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextPrimaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.ArrowBtn:pointerover">
      <Setter Property="Background" Value="{DynamicResource ConsoleDividerBrush}" />
    </Style>

    <Style Selector="UserControl:focus Border#FocusBorder">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </UserControl.Styles>

  <Panel ClipToBounds="False" HorizontalAlignment="Right" VerticalAlignment="Center">
    <!-- White Focus Capsule Outline around the Pill Slider (Matching Normal Action Buttons) -->
    <Border x:Name="FocusBorder"
            BorderBrush="{DynamicResource ConsoleAccentBrush}"
            BorderThickness="2.5"
            CornerRadius="26"
            Margin="-5"
            IsVisible="False"
            ClipToBounds="False" />

    <!-- Container Pill Background (Height 42, CornerRadius 21, Padding 20,0) -->
    <Border Background="Transparent"
            CornerRadius="21"
            Height="42"
            Padding="20,0"
            VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <!-- Icon e.g. volume_up or mic -->
        <TextBlock x:Name="IconTextBlock" Text="volume_up" Classes="SliderIcon" Margin="0,0,4,0" />

        <!-- Decrement Arrow Button < -->
        <Button x:Name="DecrementBtn" Classes="ArrowBtn" Click="OnDecrementClicked">
          <TextBlock Text="chevron_left" Classes="ArrowIcon" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-2,0,0,0" />
        </Button>

        <!-- 10 Pill Segment Stack -->
        <StackPanel x:Name="PillContainer" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border Width="26" Height="7" CornerRadius="3.5" Background="{DynamicResource ConsoleTextPrimaryBrush}" />
          <Border Width="26" Height="7" CornerRadius="3.5" Background="{DynamicResource ConsoleTextPrimaryBrush}" />
          <Border Width="26" Height="7" CornerRadius="3.5" Background="{DynamicResource ConsoleTextPrimaryBrush}" />
          <Border Width="26" Height="7" CornerRadius="3.5" Background="{DynamicResource ConsoleTextPrimaryBrush}" />
          <Border Width="26" Height="7" CornerRadius="3.5" Background="{DynamicResource ConsoleTextPrimaryBrush}" />
          <Border Width="26" Height="7" CornerRadius="3.5" Background="{DynamicResource ConsoleDividerBrush}" />
          <Border Width="26" Height="7" CornerRadius="3.5" Background="{DynamicResource ConsoleDividerBrush}" />
          <Border Width="26" Height="7" CornerRadius="3.5" Background="{DynamicResource ConsoleDividerBrush}" />
          <Border Width="26" Height="7" CornerRadius="3.5" Background="{DynamicResource ConsoleDividerBrush}" />
          <Border Width="26" Height="7" CornerRadius="3.5" Background="{DynamicResource ConsoleDividerBrush}" />
        </StackPanel>

        <!-- Increment Arrow Button > -->
        <Button x:Name="IncrementBtn" Classes="ArrowBtn" Click="OnIncrementClicked">
          <TextBlock Text="chevron_right" Classes="ArrowIcon" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
        </Button>

        <!-- Percentage Value Text e.g. 50% -->
        <TextBlock x:Name="ValueText" Text="50%" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Panel>

</UserControl>
