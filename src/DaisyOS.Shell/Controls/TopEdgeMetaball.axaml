<UserControl x:Class="DaisyOS.Shell.Controls.TopEdgeMetaball"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
             Width="263"
             Height="40"
             UseLayoutRounding="True"
             ClipToBounds="False"
             Cursor="SizeAll">
  <Canvas Width="263" Height="40" ClipToBounds="False">
    <Border x:Name="PocketBody"
            Width="263"
            Height="40"
            Background="{DynamicResource ShellTopEdgePocketBrush}"
            CornerRadius="12" />
    <controls:QuickSettingsSlider x:Name="VolumeSlider"
                                  Canvas.Left="0"
                                  Canvas.Top="0"
                                  Width="263"
                                  Height="40"
                                  Icon=""
                                  Minimum="0"
                                  Maximum="100"
                                  ShowThumb="False"
                                  TrackCornerRadius="6"
                                  TrackBorderBrush="{DynamicResource TaskbarBorderBrush}"
                                  TrackBorderThickness="1"
                                  ValueChanged="OnVolumeChanged" />
  </Canvas>
</UserControl>
