<UserControl x:Class="DaisyOS.Shell.Controls.TopEdgeMetaball"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="180"
             Height="52"
             UseLayoutRounding="True"
             ClipToBounds="False">
  <Canvas Width="180" Height="52" ClipToBounds="False">
    <!-- Fixed merged bridge: the pocket touches and flares into the top edge. -->
    <Path x:Name="EdgeBridge" Fill="{DynamicResource ShellTopEdgePocketBrush}" />
    <Border x:Name="PocketBody"
            Width="180"
            Height="52"
            Background="{DynamicResource ShellTopEdgePocketBrush}"
            CornerRadius="12" />
  </Canvas>
</UserControl>
