<UserControl x:Class="DaisyOS.Shell.Controls.FlyoutPageHeader"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid ColumnDefinitions="40,*,40">
    <Button Grid.Column="0"
            Classes="ShellButton OutputDevicesButton"
            Click="OnBackButtonClick"
            ToolTip.Tip="Back">
      <TextBlock Text="chevron_left"
                 FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                 FontSize="20"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>
    </Button>
    <TextBlock Grid.Column="1"
               Text="{Binding Title, ElementName=Root}"
               FontSize="15"
               FontWeight="Regular"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
    <Border Grid.Column="2" Width="40" Height="40"/>
  </Grid>
</UserControl>
