<UserControl x:Class="DaisyOS.Shell.Controls.QuickSettingsSlider"
            x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             AutomationProperties.Name="Volume"
             Height="40">
  <!-- The glyph overlays the track and never creates a false minimum fill. -->
  <Grid x:Name="RangeSurface">
    <Border x:Name="TrackBackground"
            Background="{DynamicResource SubtleSurfaceBrush}"
            BorderBrush="{Binding TrackBorderBrush, ElementName=Root}"
            BorderThickness="{Binding TrackBorderThickness, ElementName=Root}"
            CornerRadius="{Binding TrackCornerRadius, ElementName=Root}"
            ClipToBounds="True">
      <Grid>
        <!-- The fill deliberately owns no corner geometry. The clipped track is
             the single rounded silhouette at every value, including 0 and 100. -->
        <Border x:Name="ProgressFill"
                Background="{DynamicResource AccentBrush}"
                HorizontalAlignment="Left" />
        <Border x:Name="ProgressThumb"
                Width="8"
                Background="{DynamicResource OnAccentBrush}"
                CornerRadius="{DynamicResource RoundedXS}"
                HorizontalAlignment="Left"
                IsVisible="{Binding ShowThumb, ElementName=Root}" />
      </Grid>
    </Border>
    <TextBlock Text="{Binding Icon, ElementName=Root}"
               FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
               FontSize="20"
               Foreground="{DynamicResource OnAccentBrush}"
               Margin="14,0,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               IsHitTestVisible="False" />
  </Grid>

</UserControl>
