<UserControl x:Class="DaisyOS.Shell.Controls.QuickSettingsSlider"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             AutomationProperties.Name="Volume"
             Height="40">
  <UserControl.Resources>
    <ControlTheme x:Key="QuickSettingsSliderTrackTheme" TargetType="Slider">
      <Setter Property="Template">
        <ControlTemplate>
          <Track Name="PART_Track"
                 Orientation="Horizontal"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value}"
                 IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseButton>
              <RepeatButton BorderThickness="0">
                <RepeatButton.Template>
                  <ControlTemplate>
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.DecreaseButton>
            <Track.Thumb>
              <Thumb Width="8" Height="40">
                <Thumb.Template>
                  <ControlTemplate>
                    <Border Background="{DynamicResource AppPrimaryBrush}"
                            CornerRadius="5" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseButton>
              <RepeatButton BorderThickness="0">
                <RepeatButton.Template>
                  <ControlTemplate>
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.IncreaseButton>
          </Track>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </UserControl.Resources>

  <!-- The glyph overlays the track and never creates a false minimum fill. -->
  <Grid x:Name="RangeSurface">
    <Border x:Name="TrackBackground"
            Background="{DynamicResource QuickSettingBackgroundBrush}"
            CornerRadius="10,0,0,10"
            ClipToBounds="True">
      <!-- The fill deliberately owns no corner geometry. The clipped track is
           the single rounded silhouette at every value, including 0 and 100. -->
      <Border x:Name="ProgressFill"
              Background="{DynamicResource AppPrimaryContainerBrush}"
              HorizontalAlignment="Left" />
    </Border>
    <TextBlock Text="{Binding Icon, ElementName=Root}"
               FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
               FontSize="20"
               Foreground="{DynamicResource AppPrimaryBrush}"
               Margin="14,0,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               IsHitTestVisible="False" />
    <Slider Minimum="{Binding Minimum, ElementName=Root}"
            Maximum="{Binding Maximum, ElementName=Root}"
            Value="{Binding Value, ElementName=Root, Mode=TwoWay}"
            Theme="{StaticResource QuickSettingsSliderTrackTheme}" />
  </Grid>
</UserControl>
