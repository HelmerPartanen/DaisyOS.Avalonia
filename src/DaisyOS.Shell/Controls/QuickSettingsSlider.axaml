<UserControl x:Class="DaisyOS.Shell.Controls.QuickSettingsSlider"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="40">
  <UserControl.Resources>
    <ControlTheme x:Key="QuickSettingsSliderTrackTheme" TargetType="Slider">
      <Setter Property="Template">
        <ControlTemplate>
          <Track Name="PART_Track"
                 Orientation="Horizontal"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value}"
                 IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseButton>
              <RepeatButton BorderThickness="0">
                <RepeatButton.Template>
                  <ControlTemplate>
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.DecreaseButton>
            <Track.Thumb>
              <Thumb Width="8" Height="40">
                <Thumb.Template>
                  <ControlTemplate>
                    <Border Background="{DynamicResource AppPrimaryBrush}"
                            CornerRadius="5" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseButton>
              <RepeatButton BorderThickness="0">
                <RepeatButton.Template>
                  <ControlTemplate>
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.IncreaseButton>
          </Track>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </UserControl.Resources>

  <!-- The fill is an explicit layer: input and rendering stay independent. -->
  <Grid ColumnDefinitions="40,*" ColumnSpacing="8">
    <Border Background="{DynamicResource AppPrimaryContainerBrush}"
            CornerRadius="10">
      <TextBlock Text="{Binding Icon, ElementName=Root}"
                 FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                 FontSize="20"
                 Foreground="{DynamicResource AppOnPrimaryContainerBrush}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
    </Border>
    <Grid Grid.Column="1" x:Name="RangeSurface">
      <Border x:Name="TrackBackground"
              Background="{DynamicResource AppSurfaceContainerBrush}"
              CornerRadius="10" />
      <Border x:Name="ProgressFill"
              Background="{DynamicResource AppPrimaryContainerBrush}"
              CornerRadius="10,0,0,10"
              HorizontalAlignment="Left" />
      <Slider Minimum="{Binding Minimum, ElementName=Root}"
              Maximum="{Binding Maximum, ElementName=Root}"
              Value="{Binding Value, ElementName=Root, Mode=TwoWay}"
              Theme="{StaticResource QuickSettingsSliderTrackTheme}"
              ValueChanged="OnSliderValueChanged" />
    </Grid>
  </Grid>
</UserControl>
