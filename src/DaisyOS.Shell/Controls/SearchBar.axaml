<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DaisyOS.Shell.Controls.SearchBar"
             Height="44">
  <Grid ClipToBounds="False">
    <!-- The 2 px inset reserves a 1 px gap after the 1 px outline without overflow or clipping. -->
    <Border x:Name="FocusOutline"
            BorderBrush="{DynamicResource AppPrimaryContainerBrush}"
            BorderThickness="2"
            CornerRadius="22"
            Opacity="0"
            IsHitTestVisible="False">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="QuadraticEaseOut"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="QuadraticEaseOut"/>
        </Transitions>
      </Border.Transitions>
    </Border>
    <Border x:Name="SearchFrame"
            Margin="2"
            Background="#1AFFFFFF"

            CornerRadius="20"
            Padding="12,0">
      <Grid ColumnDefinitions="Auto,*">
      <!-- Search Icon -->
      <PathIcon Data="M 15.5 14 L 20 18.5 L 18.5 20 L 14 15.5 C 12.5 16.5 10.8 17 9 17 C 4.6 17 1 13.4 1 9 C 1 4.6 4.6 1 9 1 C 13.4 1 17 4.6 17 9 C 17 10.8 16.5 12.5 15.5 14 Z M 9 15 C 12.3 15 15 12.3 15 9 C 15 5.7 12.3 3 9 3 C 5.7 3 3 5.7 3 9 C 3 12.3 5.7 15 9 15 Z"
                Width="16" Height="16"
                Foreground="{DynamicResource TextTertiaryBrush}"
                VerticalAlignment="Center"/>
      
      <TextBox x:Name="SearchInput"
               Grid.Column="1"
               Margin="8,0,0,0"
               PlaceholderText="Search for apps, settings, and documents"
               Background="Transparent"
               BorderThickness="0"
               VerticalAlignment="Center"
               CaretBrush="{DynamicResource TextPrimaryBrush}">
        <TextBox.Styles>
          <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
          </Style>
          <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
          </Style>
        </TextBox.Styles>
      </TextBox>

      </Grid>
    </Border>
  </Grid>
</UserControl>
