<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
             x:Class="DaisyOS.Shell.Controls.SearchBar">
  <UserControl.Styles>
    <Style Selector="Border#SearchFrame">
      <Setter Property="Background" Value="{DynamicResource SettingsButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TaskbarBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="UserControl:pointerover Border#SearchFrame">
      <Setter Property="Background" Value="{DynamicResource SettingsButtonHoverBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid ClipToBounds="False">
    <!-- The 2 px inset reserves a 1 px gap after the 1 px outline without overflow or clipping. -->
    <Border x:Name="FocusOutline"
            BorderBrush="{DynamicResource AppPrimaryContainerBrush}"
            BorderThickness="2"
            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=controls:SearchBar}}"
            Opacity="0"
            IsHitTestVisible="False">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="QuadraticEaseOut"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="QuadraticEaseOut"/>
        </Transitions>
      </Border.Transitions>
    </Border>
    <Border x:Name="SearchFrame"
            Margin="1"
            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=controls:SearchBar}}"
            Padding="12,0">
      <Grid ColumnDefinitions="Auto,*">
      <!-- Search Icon -->
      <PathIcon Data="M 15.5 14 L 20 18.5 L 18.5 20 L 14 15.5 C 12.5 16.5 10.8 17 9 17 C 4.6 17 1 13.4 1 9 C 1 4.6 4.6 1 9 1 C 13.4 1 17 4.6 17 9 C 17 10.8 16.5 12.5 15.5 14 Z M 9 15 C 12.3 15 15 12.3 15 9 C 15 5.7 12.3 3 9 3 C 5.7 3 3 5.7 3 9 C 3 12.3 5.7 15 9 15 Z"
                Width="15" Height="15"
                Foreground="{DynamicResource TextSecondaryBrush}"
                VerticalAlignment="Center"/>
      
      <TextBox x:Name="SearchInput"
               Grid.Column="1"
               Margin="8,0,0,0"
               MinHeight="0"
               Padding="0"
               Text="{Binding Text, RelativeSource={RelativeSource AncestorType=controls:SearchBar}, Mode=TwoWay}"
               PlaceholderText="{Binding PlaceholderText, RelativeSource={RelativeSource AncestorType=controls:SearchBar}}"
               Background="Transparent"
               Foreground="{DynamicResource TextPrimaryBrush}"
               BorderThickness="0"
               VerticalAlignment="Center"
               VerticalContentAlignment="Center"
               FontSize="13"
               CaretBrush="{DynamicResource TextPrimaryBrush}">
        <TextBox.Styles>
          <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Opacity" Value="0.80"/>
          </Style>
          <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
          </Style>
          <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
          </Style>
        </TextBox.Styles>
      </TextBox>

      </Grid>
    </Border>
  </Grid>
</UserControl>
