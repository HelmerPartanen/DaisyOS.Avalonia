<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Reusable Global Glass Dropdown Menu Container Style (MenuFlyoutPresenter) -->
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RoundedLG}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Margin="16"
                MinWidth="180"
                Background="{DynamicResource MenuSurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RoundedLG}"
                Padding="4"
                BoxShadow="0 4 16 0 #30000000">
          <ScrollViewer>
            <ItemsPresenter Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            Margin="{TemplateBinding Padding}"/>
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Reusable Global Glass Context Menu Container Style -->
  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RoundedLG}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Margin="16"
                MinWidth="180"
                Background="{DynamicResource MenuSurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RoundedLG}"
                Padding="4"
                BoxShadow="0 4 16 0 #30000000">
          <ScrollViewer>
            <ItemsPresenter Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            Margin="{TemplateBinding Padding}"/>
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Reusable Global Glass Dropdown MenuItem Style -->
  <Style Selector="MenuItem">
    <Setter Property="FontFamily" Value="Inter" />
    <Setter Property="FontWeight" Value="Regular" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="{DynamicResource RoundedSM}" />
    <Setter Property="Padding" Value="6,4,8,4" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Margin" Value="4,1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="MenuItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GhostHoverBrush}" />
  </Style>

  <Style Selector="MenuItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GhostHoverBrush}" />
  </Style>

  <Style Selector="MenuItem:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- Reusable Menu Separator / Divider Style -->
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="4,4" />
  </Style>

  <!-- Reusable Trigger Button Style (Button.SubtleLink) -->
  <Style Selector="Button.SubtleLink">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RoundedSM}" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.SubtleLink:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.SubtleLink:flyout-open /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GhostHoverBrush}" />
  </Style>
  <Style Selector="Button.SubtleLink:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GhostPressedBrush}" />
  </Style>

  <!-- Reusable Material Symbol Icon Class for MenuItems -->
  <Style Selector="TextBlock.MenuIcon">
    <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

</Styles>
