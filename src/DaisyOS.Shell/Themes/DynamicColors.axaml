<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Wallpaper analysis may adjust only the desktop-label contrast.
       All shell materials and accents live in OSTheme.axaml. -->
  <SolidColorBrush x:Key="DesktopItemLabelBrush" Color="#FFF5F5F5"/>
  <DropShadowEffect x:Key="DesktopItemLabelShadow" OffsetX="0" OffsetY="1" BlurRadius="2" Color="Black" Opacity="0.30"/>
</ResourceDictionary>
