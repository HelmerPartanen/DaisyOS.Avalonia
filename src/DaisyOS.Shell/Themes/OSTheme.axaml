<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>

<!--
100% — FF
95% — F2
90% — E6
85% — D9
80% — CC
75% — BF
70% — B3
65% — A6
60% — 99
55% — 8C
50% — 80
45% — 73
40% — 66
35% — 59
30% — 4D
25% — 40
20% — 33
15% — 26
10% — 1A
5% — 0D
0% — 00
-->

    <!-- Light -->
    <ResourceDictionary x:Key="Light">

      <!-- Taskbar itself is Mica, so the background is transparent -->
      <SolidColorBrush x:Key="TaskbarBackgroundBrush"
                       Color="#00FFFFFF"/>

      <SolidColorBrush x:Key="TaskbarBorderBrush"
                       Color="#1AC7C7C7"/>

      <SolidColorBrush x:Key="TaskbarHoverBrush"
                       Color="#0FFFFFFF"/>

      <SolidColorBrush x:Key="TaskbarPressedBrush"
                       Color="#18FFFFFF"/>

    </ResourceDictionary>

    <!-- Dark -->
    <ResourceDictionary x:Key="Dark">

      <SolidColorBrush x:Key="TaskbarBackgroundBrush"
                       Color="#00000000"/>

      <SolidColorBrush x:Key="TaskbarBorderBrush"
                       Color="#1AFFFFFF"/>

      <SolidColorBrush x:Key="TaskbarHoverBrush"
                       Color="#14FFFFFF"/>

      <SolidColorBrush x:Key="TaskbarPressedBrush"
                       Color="#22FFFFFF"/>

    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>