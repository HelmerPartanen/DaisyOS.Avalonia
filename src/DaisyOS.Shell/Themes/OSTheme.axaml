<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Semantic theme roles only. Components choose a role, never a component-specific colour.

OPACITY VALUES

100% — FF
95% — F2
90% — E6
85% — D9
80% — CC
75% — BF
70% — B3
65% — A6
60% — 99
55% — 8C
50% — 80
45% — 73
40% — 66
35% — 59
30% — 4D
25% — 40
20% — 33
15% — 26
10% — 1A
5% — 0D
0% — 00 
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- Primary is the app background, then increasing elevation. -->
      <SolidColorBrush x:Key="PrimarySurfaceBrush" Color="#FFF5F5F5" />
      <SolidColorBrush x:Key="SecondarySurfaceBrush" Color="#99F5F5F5" />
      <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#F2FFFFFF" />
      <SolidColorBrush x:Key="MenuSurfaceBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="TertiarySurfaceBrush" Color="#1A000000" />
      <SolidColorBrush x:Key="DividerBrush" Color="#26000000" />
      <SolidColorBrush x:Key="BorderBrush" Color="#0D000000" />

      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF000000" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CC000000" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#99000000" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#99000000" />

      <SolidColorBrush x:Key="PrimaryButtonTextPrimaryBrush" Color="{StaticResource GlobalPrimaryButtonTextPrimaryColor}" />
      <SolidColorBrush x:Key="PrimaryButtonTextSecondaryBrush" Color="{StaticResource GlobalPrimaryButtonTextSecondaryColor}" />

      <SolidColorBrush x:Key="GhostHoverBrush" Color="#26000000" />
      <SolidColorBrush x:Key="GhostPressedBrush" Color="#33000000" />
      <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#26000000" />
      <SolidColorBrush x:Key="SubtleHoverBrush" Color="#33000000" />
      <SolidColorBrush x:Key="SubtlePressedBrush" Color="#40000000" />

      <!-- Overwritten by DynamicThemeService when a wallpaper accent is available. -->
      <Color x:Key="AccentColor">#FF56565B</Color>
      <SolidColorBrush x:Key="AccentBrush" Color="#FF56565B" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF646469" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF717176" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#FFDCDCE0" />
      <SolidColorBrush x:Key="AccentSurfaceHoverBrush" Color="#FFD0D0D5" />
      <SolidColorBrush x:Key="AccentSurfacePressedBrush" Color="#FFC4C4CA" />
      <SolidColorBrush x:Key="OnAccentSurfaceBrush" Color="#FF26262B" />
      <SolidColorBrush x:Key="AccentDividerBrush" Color="#FF7A7A80" />

      <SolidColorBrush x:Key="WarningBrush" Color="#FFFF8D28" />
      <SolidColorBrush x:Key="WarningHoverBrush" Color="#FFFF9C45" />
      <SolidColorBrush x:Key="WarningPressedBrush" Color="#FFE67A1F" />
      <SolidColorBrush x:Key="NeutralBrush" Color="#FF6E6E73" />
      <SolidColorBrush x:Key="DangerBrush" Color="#FFC42B1C" />
      <SolidColorBrush x:Key="DangerHoverBrush" Color="#FFE81123" />
      <SolidColorBrush x:Key="DangerPressedBrush" Color="#FFA32116" />
      <SolidColorBrush x:Key="OnDangerBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#FF237A43" />
      <SolidColorBrush x:Key="InfoBrush" Color="#FF236DB5" />
      <SolidColorBrush x:Key="DiagnosticBrush" Color="#FF7951A8" />
      <SolidColorBrush x:Key="OverlaySurfaceBrush" Color="#F2FFFFFF" />
      <SolidColorBrush x:Key="OverlaySurfaceSubtleBrush" Color="#1A000000" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <!-- Surface roles retain contrast over the #FF000000 base without a grey washout. -->
      <SolidColorBrush x:Key="PrimarySurfaceBrush" Color="{StaticResource GlobalSurfaceColor}" />
      <SolidColorBrush x:Key="SecondarySurfaceBrush" Color="{StaticResource GlobalSecondaryButtonBgColor}" />
      <!-- Add opacity to ElevatedSurfaceColor which is #181820 -->
      <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="{StaticResource GlobalElevatedSurfaceColor}" Opacity="0.95" />
      <SolidColorBrush x:Key="MenuSurfaceBrush" Color="{StaticResource GlobalElevatedSurfaceColor}" />
      <SolidColorBrush x:Key="TertiarySurfaceBrush" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource GlobalDividerColor}" />
      <SolidColorBrush x:Key="BorderBrush" Color="#0DFFFFFF" />

      <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource GlobalTextPrimaryColor}" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource GlobalTextSecondaryColor}" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource GlobalTextMutedColor}" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource GlobalTextMutedColor}" />

      <SolidColorBrush x:Key="PrimaryButtonTextPrimaryBrush" Color="{StaticResource GlobalPrimaryButtonTextPrimaryColor}" />
      <SolidColorBrush x:Key="PrimaryButtonTextSecondaryBrush" Color="{StaticResource GlobalPrimaryButtonTextSecondaryColor}" />

      <SolidColorBrush x:Key="GhostHoverBrush" Color="#26FFFFFF" />
      <SolidColorBrush x:Key="GhostPressedBrush" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="{StaticResource GlobalSubtleSurfaceColor}" />
      <SolidColorBrush x:Key="SubtleHoverBrush" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="SubtlePressedBrush" Color="#40FFFFFF" />

      <Color x:Key="AccentColor">#FFFFFFFF</Color>
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource GlobalAccentColor}" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource GlobalPrimaryButtonHoverColor}" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource GlobalPrimaryButtonPressedColor}" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource GlobalOnAccentColor}" />
      <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#FF3D3D42" />
      <SolidColorBrush x:Key="AccentSurfaceHoverBrush" Color="#FF4A4A50" />
      <SolidColorBrush x:Key="AccentSurfacePressedBrush" Color="#FF56565D" />
      <SolidColorBrush x:Key="OnAccentSurfaceBrush" Color="{StaticResource GlobalTextPrimaryColor}" />
      <SolidColorBrush x:Key="AccentDividerBrush" Color="#FFAFAFB5" />

      <SolidColorBrush x:Key="WarningBrush" Color="#FFFF9230" />
      <SolidColorBrush x:Key="WarningHoverBrush" Color="#FFFFA24D" />
      <SolidColorBrush x:Key="WarningPressedBrush" Color="#FFE17E21" />
      <SolidColorBrush x:Key="NeutralBrush" Color="#FFB8B8BE" />
      <SolidColorBrush x:Key="DangerBrush" Color="#FFE34234" />
      <SolidColorBrush x:Key="DangerHoverBrush" Color="#FFFF5A4D" />
      <SolidColorBrush x:Key="DangerPressedBrush" Color="#FFC93328" />
      <SolidColorBrush x:Key="OnDangerBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#FF62C783" />
      <SolidColorBrush x:Key="InfoBrush" Color="#FF6BAEF0" />
      <SolidColorBrush x:Key="DiagnosticBrush" Color="#FFC69BF2" />
      <SolidColorBrush x:Key="OverlaySurfaceBrush" Color="#E61A1C23" />
      <SolidColorBrush x:Key="OverlaySurfaceSubtleBrush" Color="#1AFFFFFF" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
