<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>

    <!--
      OPACITY VALUES
      100% — FF
      95%  — F2
      90%  — E6
      85%  — D9
      80%  — CC
      75%  — BF
      70%  — B3
      65%  — A6
      60%  — 99
      55%  — 8C
      50%  — 80
      45%  — 73
      40%  — 66
      35%  — 59
      30%  — 4D
      25%  — 40
      20%  — 33
      15%  — 26
      10%  — 1A
      5%   — 0D
      0%   — 00
    -->


    <!-- ========================================================= -->
    <!-- LIGHT THEME                                               -->
    <!-- ========================================================= -->

    <ResourceDictionary x:Key="Light">

      <!-- ===================================================== -->
      <!-- Shell Surfaces                                        -->
      <!-- ===================================================== -->

      <!--
        KWin supplies the blur.
        DaisyOS supplies a stable neutral translucent tint.
      -->

      <SolidColorBrush
        x:Key="ShellSurfaceBrush"
        Color="#80F5F5F5"/>

      <!-- Opaque top-edge pocket so it remains legible over every wallpaper. -->
      <SolidColorBrush
        x:Key="ShellTopEdgePocketBrush"
        Color="#FF000000"/>

      <SolidColorBrush
        x:Key="ShellSurfaceElevatedBrush"
        Color="#C2FFFFFF"/>

      <SolidColorBrush
        x:Key="ShellSurfaceSubtleBrush"
        Color="#26000000"/>

      <SolidColorBrush
        x:Key="ShellSurfaceBorderBrush"
        Color="#1A000000"/>


      <!-- ===================================================== -->
      <!-- Interaction States                                    -->
      <!-- ===================================================== -->

      <SolidColorBrush
        x:Key="ShellHoverBrush"
        Color="#12000000"/>

      <SolidColorBrush
        x:Key="ShellPressedBrush"
        Color="#22000000"/>

      <SolidColorBrush
        x:Key="ShellDividerBrush"
        Color="#14000000"/>


      <!-- ===================================================== -->
      <!-- Text                                                  -->
      <!-- ===================================================== -->

      <SolidColorBrush
        x:Key="TextPrimaryBrush"
        Color="#1C1C1E"/>

      <SolidColorBrush
        x:Key="TextSecondaryBrush"
        Color="#CC1C1C1E"/>

      <SolidColorBrush
        x:Key="TextTertiaryBrush"
        Color="#991C1C1E"/>


      <!-- ===================================================== -->
      <!-- Primary Color                                         -->
      <!-- ===================================================== -->

      <!--
        DaisyOS primary color.

        Neutral graphite gray.
        Never wallpaper-driven.
        No purple / violet hue.
      -->

      <Color x:Key="AppPrimaryColor">#4B4D55</Color>

      <SolidColorBrush
        x:Key="AppPrimaryBrush"
        Color="#4B4D55"/>

      <SolidColorBrush
        x:Key="AppOnPrimaryBrush"
        Color="#FFFFFF"/>


      <!-- ===================================================== -->
      <!-- Primary Container                                     -->
      <!-- ===================================================== -->

      <SolidColorBrush
        x:Key="AppPrimaryContainerBrush"
        Color="#E2E3E6"/>

      <SolidColorBrush
        x:Key="AppPrimaryContainerHoverBrush"
        Color="#D7D8DC"/>

      <SolidColorBrush
        x:Key="AppPrimaryContainerPressedBrush"
        Color="#CBCCD1"/>

      <SolidColorBrush
        x:Key="AppOnPrimaryContainerBrush"
        Color="#26272C"/>


      <!-- ===================================================== -->
      <!-- Active / Selected Indicators                          -->
      <!-- ===================================================== -->

      <SolidColorBrush
        x:Key="QuickSettingActiveDividerBrush"
        Color="#A5A7AF"/>


      <!-- ===================================================== -->
      <!-- Settings Surfaces                                     -->
      <!-- ===================================================== -->

      <SolidColorBrush
        x:Key="SettingsButtonBackgroundBrush"
        Color="#FFFFFF"/>

      <SolidColorBrush
        x:Key="SettingsButtonHoverBrush"
        Color="#F5F5F5"/>

      <SolidColorBrush
        x:Key="SettingsButtonPressedBrush"
        Color="#E8E8EA"/>


      <!-- ===================================================== -->
      <!-- Subtle Buttons                                        -->
      <!-- ===================================================== -->

      <SolidColorBrush
        x:Key="SubtleButtonBackgroundBrush"
        Color="#0A000000"/>


      <!-- ===================================================== -->
      <!-- Accent Swatches                                       -->
      <!-- ===================================================== -->

      <SolidColorBrush
        x:Key="OrangeSwatch"
        Color="#FF8D28"/>

      <SolidColorBrush
        x:Key="OrangeSwatchHover"
        Color="#FF9C45"/>

      <SolidColorBrush
        x:Key="GraySwatch"
        Color="#6E6E73"/>


      <!-- ===================================================== -->
      <!-- Legacy / Component Aliases                            -->
      <!-- ===================================================== -->

      <StaticResource
        x:Key="TaskbarBackgroundBrush"
        ResourceKey="ShellSurfaceBrush"/>

      <StaticResource
        x:Key="TaskbarMaterialBrush"
        ResourceKey="ShellSurfaceBrush"/>

      <StaticResource
        x:Key="SystemBarMaterialBrush"
        ResourceKey="ShellSurfaceBrush"/>

      <StaticResource
        x:Key="LauncherMaterialBrush"
        ResourceKey="ShellSurfaceBrush"/>

      <StaticResource
        x:Key="ContextMenuMaterialBrush"
        ResourceKey="ShellSurfaceElevatedBrush"/>

      <StaticResource
        x:Key="DropdownMenuBackgroundBrush"
        ResourceKey="ShellSurfaceElevatedBrush"/>

      <StaticResource
        x:Key="TaskbarBorderBrush"
        ResourceKey="ShellSurfaceBorderBrush"/>


      <!-- Hover aliases -->

      <StaticResource
        x:Key="TaskbarHoverBrush"
        ResourceKey="ShellHoverBrush"/>

      <StaticResource
        x:Key="QuickSettingHoverBrush"
        ResourceKey="ShellHoverBrush"/>

      <StaticResource
        x:Key="LauncherItemHoverBrush"
        ResourceKey="ShellHoverBrush"/>

      <StaticResource
        x:Key="SearchBarHoverBrush"
        ResourceKey="ShellHoverBrush"/>

      <StaticResource
        x:Key="DropdownMenuItemHoverBrush"
        ResourceKey="ShellHoverBrush"/>


      <!-- Pressed aliases -->

      <StaticResource
        x:Key="TaskbarPressedBrush"
        ResourceKey="ShellPressedBrush"/>

      <StaticResource
        x:Key="QuickSettingPressedBrush"
        ResourceKey="ShellPressedBrush"/>

      <StaticResource
        x:Key="LauncherItemPressedBrush"
        ResourceKey="ShellPressedBrush"/>


      <!-- Surface aliases -->

      <StaticResource
        x:Key="QuickSettingBackgroundBrush"
        ResourceKey="ShellSurfaceSubtleBrush"/>

      <StaticResource
        x:Key="SearchBarBackgroundBrush"
        ResourceKey="ShellSurfaceSubtleBrush"/>

      <StaticResource
        x:Key="LauncherFooterBrush"
        ResourceKey="ShellSurfaceSubtleBrush"/>


      <!-- Divider aliases -->

      <StaticResource
        x:Key="QuickSettingInactiveDividerBrush"
        ResourceKey="ShellDividerBrush"/>


      <!-- Foreground aliases -->

      <StaticResource
        x:Key="QuickSettingForegroundBrush"
        ResourceKey="TextPrimaryBrush"/>

    </ResourceDictionary>



    <!-- ========================================================= -->
    <!-- DARK THEME                                                -->
    <!-- ========================================================= -->

    <ResourceDictionary x:Key="Dark">

      <!-- ===================================================== -->
      <!-- Shell Surfaces                                        -->
      <!-- ===================================================== -->

      <!--
        KWin supplies the blur.
        DaisyOS supplies a stable neutral dark tint.
      -->

      <SolidColorBrush
        x:Key="ShellSurfaceBrush"
        Color="#801C1C1C"/>

      <!-- Opaque top-edge pocket so it remains legible over every wallpaper. -->
      <SolidColorBrush
        x:Key="ShellTopEdgePocketBrush"
        Color="#FF000000"/>

      <SolidColorBrush
        x:Key="ShellSurfaceElevatedBrush"
        Color="#C22A2A2C"/>

      <SolidColorBrush
        x:Key="ShellSurfaceSubtleBrush"
        Color="#26FFFFFF"/>

      <SolidColorBrush
        x:Key="ShellSurfaceBorderBrush"
        Color="#14FFFFFF"/>


      <!-- ===================================================== -->
      <!-- Interaction States                                    -->
      <!-- ===================================================== -->

      <SolidColorBrush
        x:Key="ShellHoverBrush"
        Color="#1AFFFFFF"/>

      <SolidColorBrush
        x:Key="ShellPressedBrush"
        Color="#26FFFFFF"/>

      <SolidColorBrush
        x:Key="ShellDividerBrush"
        Color="#26FFFFFF"/>


      <!-- ===================================================== -->
      <!-- Text                                                  -->
      <!-- ===================================================== -->

      <SolidColorBrush
        x:Key="TextPrimaryBrush"
        Color="#F5F5F7"/>

      <SolidColorBrush
        x:Key="TextSecondaryBrush"
        Color="#CCF5F5F7"/>

      <SolidColorBrush
        x:Key="TextTertiaryBrush"
        Color="#99F5F5F7"/>


      <!-- ===================================================== -->
      <!-- Primary Color                                         -->
      <!-- ===================================================== -->

      <!--
        Silver graphite keeps the same neutral character in dark mode while
        retaining enough contrast for small active glyphs.
      -->

      <Color x:Key="AppPrimaryColor">#C9CAD0</Color>

      <SolidColorBrush
        x:Key="AppPrimaryBrush"
        Color="#C9CAD0"/>

      <SolidColorBrush
        x:Key="AppOnPrimaryBrush"
        Color="#17181B"/>


      <!-- ===================================================== -->
      <!-- Primary Container                                     -->
      <!-- ===================================================== -->

      <SolidColorBrush
        x:Key="AppPrimaryContainerBrush"
        Color="#45474E"/>

      <SolidColorBrush
        x:Key="AppPrimaryContainerHoverBrush"
        Color="#52545C"/>

      <SolidColorBrush
        x:Key="AppPrimaryContainerPressedBrush"
        Color="#5E6069"/>

      <SolidColorBrush
        x:Key="AppOnPrimaryContainerBrush"
        Color="#F4F4F6"/>


      <!-- ===================================================== -->
      <!-- Active / Selected Indicators                          -->
      <!-- ===================================================== -->

      <SolidColorBrush
        x:Key="QuickSettingActiveDividerBrush"
        Color="#84868F"/>


      <!-- ===================================================== -->
      <!-- Settings Surfaces                                     -->
      <!-- ===================================================== -->

      <SolidColorBrush
        x:Key="SettingsButtonBackgroundBrush"
        Color="#0DFFFFFF"/>

      <SolidColorBrush
        x:Key="SettingsButtonHoverBrush"
        Color="#1AFFFFFF"/>

      <SolidColorBrush
        x:Key="SettingsButtonPressedBrush"
        Color="#26FFFFFF"/>


      <!-- ===================================================== -->
      <!-- Subtle Buttons                                        -->
      <!-- ===================================================== -->

      <SolidColorBrush
        x:Key="SubtleButtonBackgroundBrush"
        Color="#0DFFFFFF"/>


      <!-- ===================================================== -->
      <!-- Accent Swatches                                       -->
      <!-- ===================================================== -->

      <SolidColorBrush
        x:Key="OrangeSwatch"
        Color="#FF9230"/>

      <SolidColorBrush
        x:Key="OrangeSwatchHover"
        Color="#FFA24D"/>

      <SolidColorBrush
        x:Key="GraySwatch"
        Color="#B8B8BE"/>


      <!-- ===================================================== -->
      <!-- Legacy / Component Aliases                            -->
      <!-- ===================================================== -->

      <StaticResource
        x:Key="TaskbarBackgroundBrush"
        ResourceKey="ShellSurfaceBrush"/>

      <StaticResource
        x:Key="TaskbarMaterialBrush"
        ResourceKey="ShellSurfaceBrush"/>

      <StaticResource
        x:Key="SystemBarMaterialBrush"
        ResourceKey="ShellSurfaceBrush"/>

      <StaticResource
        x:Key="LauncherMaterialBrush"
        ResourceKey="ShellSurfaceBrush"/>

      <StaticResource
        x:Key="ContextMenuMaterialBrush"
        ResourceKey="ShellSurfaceElevatedBrush"/>

      <StaticResource
        x:Key="DropdownMenuBackgroundBrush"
        ResourceKey="ShellSurfaceElevatedBrush"/>

      <StaticResource
        x:Key="TaskbarBorderBrush"
        ResourceKey="ShellSurfaceBorderBrush"/>


      <!-- Hover aliases -->

      <StaticResource
        x:Key="TaskbarHoverBrush"
        ResourceKey="ShellHoverBrush"/>

      <StaticResource
        x:Key="QuickSettingHoverBrush"
        ResourceKey="ShellHoverBrush"/>

      <StaticResource
        x:Key="LauncherItemHoverBrush"
        ResourceKey="ShellHoverBrush"/>

      <StaticResource
        x:Key="SearchBarHoverBrush"
        ResourceKey="ShellHoverBrush"/>

      <StaticResource
        x:Key="DropdownMenuItemHoverBrush"
        ResourceKey="ShellHoverBrush"/>


      <!-- Pressed aliases -->

      <StaticResource
        x:Key="TaskbarPressedBrush"
        ResourceKey="ShellPressedBrush"/>

      <StaticResource
        x:Key="QuickSettingPressedBrush"
        ResourceKey="ShellPressedBrush"/>

      <StaticResource
        x:Key="LauncherItemPressedBrush"
        ResourceKey="ShellPressedBrush"/>


      <!-- Surface aliases -->

      <StaticResource
        x:Key="QuickSettingBackgroundBrush"
        ResourceKey="ShellSurfaceSubtleBrush"/>

      <StaticResource
        x:Key="SearchBarBackgroundBrush"
        ResourceKey="ShellSurfaceSubtleBrush"/>

      <StaticResource
        x:Key="LauncherFooterBrush"
        ResourceKey="ShellSurfaceSubtleBrush"/>


      <!-- Divider aliases -->

      <StaticResource
        x:Key="QuickSettingInactiveDividerBrush"
        ResourceKey="ShellDividerBrush"/>


      <!-- Foreground aliases -->

      <StaticResource
        x:Key="QuickSettingForegroundBrush"
        ResourceKey="TextPrimaryBrush"/>

    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!--
    Shared perimeter treatment for the five primary shell surfaces. The cyan
    hue remains constant; only alpha changes, with matching 0 and 1 stops to
    keep the conic seam invisible.
  -->
<ConicGradientBrush x:Key="ShellDiagonalBorderBrush"
                    Center="50%,50%"
                    Angle="45">
  <GradientStop Offset="0.00" Color="#1AFFFFFF"/>
  <GradientStop Offset="0.12" Color="#26FFFFFF"/>
  <GradientStop Offset="0.25" Color="#33FFFFFF"/>
  <GradientStop Offset="0.38" Color="#26FFFFFF"/>
  <GradientStop Offset="0.50" Color="#1AFFFFFF"/>
  <GradientStop Offset="0.62" Color="#26FFFFFF"/>
  <GradientStop Offset="0.75" Color="#33FFFFFF"/>
  <GradientStop Offset="0.88" Color="#26FFFFFF"/>
  <GradientStop Offset="1.00" Color="#1AFFFFFF"/>
</ConicGradientBrush>

</ResourceDictionary>
