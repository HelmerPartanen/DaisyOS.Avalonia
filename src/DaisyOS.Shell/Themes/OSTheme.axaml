<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>

<!--
100% — FF
95% — F2
90% — E6
85% — D9
80% — CC
75% — BF
70% — B3
65% — A6
60% — 99
55% — 8C
50% — 80
45% — 73
40% — 66
35% — 59
30% — 4D
25% — 40
20% — 33
15% — 26
10% — 1A
5% — 0D
0% — 00
-->

    <!-- Light -->
    <ResourceDictionary x:Key="Light">

      <SolidColorBrush x:Key="TaskbarBackgroundBrush"
                       Color="#FFF4F5F7"/>
      <SolidColorBrush x:Key="TaskbarMaterialBrush"
                       Color="#FFF4F5F7"/>
      <SolidColorBrush x:Key="SystemBarMaterialBrush"
                       Color="#FFF4F5F7"/>
      <SolidColorBrush x:Key="ContextMenuMaterialBrush"
                       Color="#FFFFFFFF"/>
      <SolidColorBrush x:Key="LauncherMaterialBrush"
                       Color="#FFF4F5F7"/>

      <SolidColorBrush x:Key="TaskbarBorderBrush"
                       Color="#14000000"/>

      <SolidColorBrush x:Key="TaskbarHoverBrush"
                       Color="#12000000"/>

      <SolidColorBrush x:Key="TaskbarPressedBrush"
                       Color="#22000000"/>

      <SolidColorBrush x:Key="TextPrimaryBrush"
                       Color="#FF1F2328"/>

      <SolidColorBrush x:Key="TextSecondaryBrush"
                       Color="#FF57606A"/>

      <SolidColorBrush x:Key="TextTertiaryBrush"
                       Color="#FF8C959F"/>

      <!-- Inactive quick-setting tiles are OS chrome in Light mode -->
      <SolidColorBrush x:Key="QuickSettingBackgroundBrush"
                       Color="#0A000000"/>
      <SolidColorBrush x:Key="QuickSettingForegroundBrush"
                       Color="#FF1F2328"/>
      <SolidColorBrush x:Key="QuickSettingHoverBrush"
                       Color="#12000000"/>
      <SolidColorBrush x:Key="QuickSettingPressedBrush"
                       Color="#22000000"/>
      <SolidColorBrush x:Key="QuickSettingInactiveDividerBrush"
                       Color="#14000000"/>

      <SolidColorBrush x:Key="LauncherItemHoverBrush"
                       Color="#12000000"/>
      <SolidColorBrush x:Key="LauncherItemPressedBrush"
                       Color="#22000000"/>
      <SolidColorBrush x:Key="LauncherFooterBrush"
                       Color="#0A000000"/>

      <SolidColorBrush x:Key="DropdownMenuBackgroundBrush"
                       Color="#F4F5F8"/>

      <SolidColorBrush x:Key="SearchBarBackgroundBrush"
                       Color="#FFFFFF"/>

      <!-- Settings buttons theme brushes -->
      <SolidColorBrush x:Key="SettingsButtonBackgroundBrush"
                       Color="#FFFFFF"/>
      <SolidColorBrush x:Key="SettingsButtonHoverBrush"
                       Color="#FFF5F5F5"/>
      <SolidColorBrush x:Key="SettingsButtonPressedBrush"
                       Color="#FFE8EAEF"/>

    </ResourceDictionary>

    <!-- Dark -->
    <ResourceDictionary x:Key="Dark">

      <SolidColorBrush x:Key="TaskbarBackgroundBrush"
                       Color="#FF1E1E1E"/>
      <SolidColorBrush x:Key="TaskbarMaterialBrush"
                       Color="#FF1E1E1E"/>
      <SolidColorBrush x:Key="SystemBarMaterialBrush"
                       Color="#FF1E1E1E"/>
      <SolidColorBrush x:Key="ContextMenuMaterialBrush"
                       Color="#FF2A2A2A"/>
      <SolidColorBrush x:Key="LauncherMaterialBrush"
                       Color="#FF1E1E1E"/>

      <SolidColorBrush x:Key="TaskbarBorderBrush"
                       Color="#14FFFFFF"/>

      <SolidColorBrush x:Key="TaskbarHoverBrush"
                       Color="#14FFFFFF"/>

      <SolidColorBrush x:Key="TaskbarPressedBrush"
                       Color="#22FFFFFF"/>

      <SolidColorBrush x:Key="TextPrimaryBrush"
                       Color="#FFF5F5F5"/>

      <SolidColorBrush x:Key="TextSecondaryBrush"
                       Color="#CCF5F5F5"/>

      <SolidColorBrush x:Key="TextTertiaryBrush"
                       Color="#99F5F5F5"/>

      <!-- Tune these independent of wallpaper-derived active quick-setting colors. -->
      <SolidColorBrush x:Key="QuickSettingBackgroundBrush"
                       Color="#26000000"/>
      <SolidColorBrush x:Key="QuickSettingForegroundBrush"
                       Color="#FFF3F3F3"/>
      <SolidColorBrush x:Key="QuickSettingHoverBrush"
                       Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="QuickSettingPressedBrush"
                       Color="#22FFFFFF"/>
      <SolidColorBrush x:Key="QuickSettingInactiveDividerBrush"
                       Color="#1AFFFFFF"/>

      <SolidColorBrush x:Key="LauncherItemHoverBrush"
                       Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="LauncherItemPressedBrush"
                       Color="#22FFFFFF"/>
      <SolidColorBrush x:Key="LauncherFooterBrush"
                       Color="#12FFFFFF"/>

      <SolidColorBrush x:Key="DropdownMenuBackgroundBrush"
                       Color="#1e1e1e"/>

      <SolidColorBrush x:Key="SearchBarBackgroundBrush"
                       Color="#0DFFFFFF"/>

      <!-- Settings buttons theme brushes -->
      <SolidColorBrush x:Key="SettingsButtonBackgroundBrush"
                       Color="#0DFFFFFF"/>
      <SolidColorBrush x:Key="SettingsButtonHoverBrush"
                       Color="#1AFFFFFF"/>
      <SolidColorBrush x:Key="SettingsButtonPressedBrush"
                       Color="#26FFFFFF"/>

    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
