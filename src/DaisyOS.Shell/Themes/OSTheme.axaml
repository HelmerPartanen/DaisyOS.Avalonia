<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>

<!-- OPACITY VALUES
100% — FF
95% — F2
90% — E6
85% — D9
80% — CC
75% — BF
70% — B3
65% — A6
60% — 99
55% — 8C
50% — 80
45% — 73
40% — 66
35% — 59
30% — 4D
25% — 40
20% — 33
15% — 26
10% — 1A
5% — 0D
0% — 00 
-->

    <!-- Light -->
    <ResourceDictionary x:Key="Light">

      <!-- Semantic Shell Brushes -->
      <SolidColorBrush x:Key="ShellSurfaceBrush" Color="#FFF4F5F7"/>
      <SolidColorBrush x:Key="ShellSurfaceElevatedBrush" Color="#FFFFFFFF"/>
      <SolidColorBrush x:Key="ShellSurfaceSubtleBrush" Color="#0A000000"/>
      <SolidColorBrush x:Key="ShellSurfaceBorderBrush" Color="#14000000"/>

      <SolidColorBrush x:Key="ShellHoverBrush" Color="#12000000"/>
      <SolidColorBrush x:Key="ShellPressedBrush" Color="#22000000"/>
      <SolidColorBrush x:Key="ShellDividerBrush" Color="#14000000"/>

      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1C1C1C"/>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CC1C1C1C"/>
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#991C1C1C"/>

      <!-- Settings surface brushes -->
      <SolidColorBrush x:Key="SettingsButtonBackgroundBrush" Color="#FFFFFFFF"/>
      <SolidColorBrush x:Key="SettingsButtonHoverBrush" Color="#FFF5F5F5"/>
      <SolidColorBrush x:Key="SettingsButtonPressedBrush" Color="#FFE8EAEF"/>

      <!-- Legacy / Component Brush Aliases (referencing unified semantic brushes) -->
      <StaticResource x:Key="TaskbarBackgroundBrush" ResourceKey="ShellSurfaceBrush"/>
      <StaticResource x:Key="TaskbarMaterialBrush" ResourceKey="ShellSurfaceBrush"/>
      <StaticResource x:Key="SystemBarMaterialBrush" ResourceKey="ShellSurfaceBrush"/>
      <StaticResource x:Key="LauncherMaterialBrush" ResourceKey="ShellSurfaceBrush"/>
      <StaticResource x:Key="ContextMenuMaterialBrush" ResourceKey="ShellSurfaceElevatedBrush"/>
      <StaticResource x:Key="DropdownMenuBackgroundBrush" ResourceKey="ShellSurfaceElevatedBrush"/>
      <StaticResource x:Key="TaskbarBorderBrush" ResourceKey="ShellSurfaceBorderBrush"/>
      <StaticResource x:Key="TaskbarHoverBrush" ResourceKey="ShellHoverBrush"/>
      <StaticResource x:Key="QuickSettingHoverBrush" ResourceKey="ShellHoverBrush"/>
      <StaticResource x:Key="LauncherItemHoverBrush" ResourceKey="ShellHoverBrush"/>
      <StaticResource x:Key="SearchBarHoverBrush" ResourceKey="ShellHoverBrush"/>
      <StaticResource x:Key="DropdownMenuItemHoverBrush" ResourceKey="ShellHoverBrush"/>
      <StaticResource x:Key="TaskbarPressedBrush" ResourceKey="ShellPressedBrush"/>
      <StaticResource x:Key="QuickSettingPressedBrush" ResourceKey="ShellPressedBrush"/>
      <StaticResource x:Key="LauncherItemPressedBrush" ResourceKey="ShellPressedBrush"/>
      <StaticResource x:Key="QuickSettingBackgroundBrush" ResourceKey="ShellSurfaceSubtleBrush"/>
      <StaticResource x:Key="SearchBarBackgroundBrush" ResourceKey="ShellSurfaceSubtleBrush"/>
      <StaticResource x:Key="LauncherFooterBrush" ResourceKey="ShellSurfaceSubtleBrush"/>
      <StaticResource x:Key="QuickSettingInactiveDividerBrush" ResourceKey="ShellDividerBrush"/>
      <StaticResource x:Key="QuickSettingForegroundBrush" ResourceKey="TextPrimaryBrush"/>

    </ResourceDictionary>

    <!-- Dark -->
    <ResourceDictionary x:Key="Dark">

      <!-- Semantic Shell Brushes -->
      <SolidColorBrush x:Key="ShellSurfaceBrush" Color="#FF1E1E1E"/>
      <SolidColorBrush x:Key="ShellSurfaceElevatedBrush" Color="#FF2A2A2A"/>
      <SolidColorBrush x:Key="ShellSurfaceSubtleBrush" Color="#0DFFFFFF"/>
      <SolidColorBrush x:Key="ShellSurfaceBorderBrush" Color="#14FFFFFF"/>

      <SolidColorBrush x:Key="ShellHoverBrush" Color="#1AFFFFFF"/>
      <SolidColorBrush x:Key="ShellPressedBrush" Color="#26FFFFFF"/>
      <SolidColorBrush x:Key="ShellDividerBrush" Color="#26FFFFFF"/>

      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF5F5F5"/>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CCF5F5F5"/>
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#99F5F5F5"/>

      <!-- Settings surface brushes -->
      <SolidColorBrush x:Key="SettingsButtonBackgroundBrush" Color="#0DFFFFFF"/>
      <SolidColorBrush x:Key="SettingsButtonHoverBrush" Color="#1AFFFFFF"/>
      <SolidColorBrush x:Key="SettingsButtonPressedBrush" Color="#26FFFFFF"/>

      <!-- Legacy / Component Brush Aliases (referencing unified semantic brushes) -->
      <StaticResource x:Key="TaskbarBackgroundBrush" ResourceKey="ShellSurfaceBrush"/>
      <StaticResource x:Key="TaskbarMaterialBrush" ResourceKey="ShellSurfaceBrush"/>
      <StaticResource x:Key="SystemBarMaterialBrush" ResourceKey="ShellSurfaceBrush"/>
      <StaticResource x:Key="LauncherMaterialBrush" ResourceKey="ShellSurfaceBrush"/>
      <StaticResource x:Key="ContextMenuMaterialBrush" ResourceKey="ShellSurfaceElevatedBrush"/>
      <StaticResource x:Key="DropdownMenuBackgroundBrush" ResourceKey="ShellSurfaceElevatedBrush"/>
      <StaticResource x:Key="TaskbarBorderBrush" ResourceKey="ShellSurfaceBorderBrush"/>
      <StaticResource x:Key="TaskbarHoverBrush" ResourceKey="ShellHoverBrush"/>
      <StaticResource x:Key="QuickSettingHoverBrush" ResourceKey="ShellHoverBrush"/>
      <StaticResource x:Key="LauncherItemHoverBrush" ResourceKey="ShellHoverBrush"/>
      <StaticResource x:Key="SearchBarHoverBrush" ResourceKey="ShellHoverBrush"/>
      <StaticResource x:Key="DropdownMenuItemHoverBrush" ResourceKey="ShellHoverBrush"/>
      <StaticResource x:Key="TaskbarPressedBrush" ResourceKey="ShellPressedBrush"/>
      <StaticResource x:Key="QuickSettingPressedBrush" ResourceKey="ShellPressedBrush"/>
      <StaticResource x:Key="LauncherItemPressedBrush" ResourceKey="ShellPressedBrush"/>
      <StaticResource x:Key="QuickSettingBackgroundBrush" ResourceKey="ShellSurfaceSubtleBrush"/>
      <StaticResource x:Key="SearchBarBackgroundBrush" ResourceKey="ShellSurfaceSubtleBrush"/>
      <StaticResource x:Key="LauncherFooterBrush" ResourceKey="ShellSurfaceSubtleBrush"/>
      <StaticResource x:Key="QuickSettingInactiveDividerBrush" ResourceKey="ShellDividerBrush"/>
      <StaticResource x:Key="QuickSettingForegroundBrush" ResourceKey="TextPrimaryBrush"/>

    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
