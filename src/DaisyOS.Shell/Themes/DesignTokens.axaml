<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Global Shared Palette Colors -->
  <Color x:Key="GlobalBackgroundColor">#000000</Color>
  <Color x:Key="GlobalSurfaceColor">#1a1a1a</Color>
  <Color x:Key="GlobalElevatedSurfaceColor">#242424</Color>
  <Color x:Key="GlobalSubtleSurfaceColor">#26FFFFFF</Color>
  <Color x:Key="GlobalAccentColor">#FFFFFF</Color>
  <Color x:Key="GlobalOnAccentColor">#000000</Color>
  <Color x:Key="GlobalTextPrimaryColor">#FFFFFF</Color>
  <Color x:Key="GlobalTextSecondaryColor">#CCFFFFFF</Color>
  <Color x:Key="GlobalTextMutedColor">#99FFFFFF</Color>
  <Color x:Key="GlobalDividerColor">#33FFFFFF</Color>

  <Color x:Key="GlobalPrimaryButtonTextPrimaryColor">#000000</Color>
  <Color x:Key="GlobalPrimaryButtonTextSecondaryColor">#99000000</Color>

  <!-- Button and interaction shared colors -->
  <Color x:Key="GlobalPrimaryButtonHoverColor">#E5E5E5</Color>
  <Color x:Key="GlobalPrimaryButtonPressedColor">#CCCCCC</Color>
  <Color x:Key="GlobalSecondaryButtonBgColor">#1C1C24</Color>
  <Color x:Key="GlobalSecondaryButtonHoverColor">#282834</Color>
  <Color x:Key="GlobalSecondaryButtonPressedColor">#14141C</Color>

  <!-- A compact geometry scale. Use the nearest role instead of literal radii. -->
  <CornerRadius x:Key="RoundedXS">4</CornerRadius>
  <CornerRadius x:Key="RoundedSM">8</CornerRadius>
  <CornerRadius x:Key="RoundedMD">10</CornerRadius>
  <CornerRadius x:Key="RoundedLG">12</CornerRadius>
  <CornerRadius x:Key="RoundedXL">16</CornerRadius>

  <!-- Purposeful variants for split controls, inner clips, and non-rounded edges. -->
  <CornerRadius x:Key="RoundedMDLeft">10,0,0,10</CornerRadius>
  <CornerRadius x:Key="RoundedMDRight">0,10,10,0</CornerRadius>
  <CornerRadius x:Key="RoundedLGInset">11</CornerRadius>
  <CornerRadius x:Key="RoundedNone">0</CornerRadius>
  <CornerRadius x:Key="RoundedPill">13</CornerRadius>
  <x:Double x:Key="RoundedLGValue">12</x:Double>
</ResourceDictionary>
