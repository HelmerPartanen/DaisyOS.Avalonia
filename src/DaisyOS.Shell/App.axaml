<Application
    x:Class="DaisyOS.Shell.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DaisyOS.Shell/Themes/OSTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme DensityStyle="Normal" />
    <StyleInclude Source="avares://DaisyOS.Shell/Styles/DropdownMenuStyles.axaml" />

    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="AccessText">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Reusable wallpaper-derived primary action treatment. -->
    <Style Selector="Button.WallpaperPrimaryButton /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WallpaperPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource WallpaperPrimaryForegroundBrush}" />
    </Style>
    <Style Selector="ToggleButton.WallpaperPrimaryButton:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WallpaperPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource WallpaperPrimaryForegroundBrush}" />
    </Style>
    <Style Selector="Button.WallpaperPrimaryButton TextBlock, ToggleButton.WallpaperPrimaryButton:checked TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource WallpaperPrimaryForegroundBrush}" />
    </Style>
  </Application.Styles>
</Application>
