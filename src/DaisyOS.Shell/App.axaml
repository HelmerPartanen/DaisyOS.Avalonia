<Application
    x:Class="DaisyOS.Shell.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DaisyOS.Shell/Themes/DynamicColors.axaml" />
        <ResourceInclude Source="avares://DaisyOS.Shell/Themes/OSTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme DensityStyle="Normal" />
    <StyleInclude Source="avares://DaisyOS.Shell/Styles/DropdownMenuStyles.axaml" />

    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="AccessText">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Global Normalized Subtle / Ghost Buttons (Shell, Nav, List, Back, Subtle links) -->
    <Style Selector="Button.ShellButton:not(.QuickSetting):not(.QuickAction):not(.QuickSettingDetails), ToggleButton.ShellButton:not(.QuickSetting):not(.QuickAction):not(.QuickSettingDetails), Button.SettingsNavItem, Button.SettingsListItem, Button.BackButton, Button.SubtleLink">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ShellButton:not(.Active):not(.QuickSetting):not(.QuickAction):not(.QuickSettingDetails):pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.ShellButton:not(.Active):not(.QuickSetting):not(.QuickAction):not(.QuickSettingDetails):pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.SettingsNavItem:not(.Active):pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.SettingsListItem:not(.Active):pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.BackButton:not(.Active):pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.SubtleLink:not(.Active):pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TaskbarHoverBrush}" />
    </Style>
    <Style Selector="Button.ShellButton:not(.Active):not(.QuickSetting):not(.QuickAction):not(.QuickSettingDetails):pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.ShellButton:not(.Active):not(.QuickSetting):not(.QuickAction):not(.QuickSettingDetails):pressed /template/ ContentPresenter#PART_ContentPresenter, Button.SettingsNavItem:not(.Active):pressed /template/ ContentPresenter#PART_ContentPresenter, Button.SettingsListItem:not(.Active):pressed /template/ ContentPresenter#PART_ContentPresenter, Button.BackButton:not(.Active):pressed /template/ ContentPresenter#PART_ContentPresenter, Button.SubtleLink:not(.Active):pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TaskbarPressedBrush}" />
    </Style>
    <!-- Flyout triggers stay visibly active for the duration of their open surface. -->
    <Style Selector="Button.ShellButton.ShellButtonActive /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TaskbarHoverBrush}" />
    </Style>

    <!-- Reusable Material You Quick Settings container buttons. -->
    <Style Selector="ToggleButton.QuickSetting, Button.QuickSettingDetails">
      <Setter Property="Foreground" Value="{DynamicResource QuickSettingForegroundBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ToggleButton.QuickSetting:not(:checked):not(.Active), Button.QuickSettingDetails:not(.Active)">
      <Setter Property="Background" Value="{DynamicResource QuickSettingBackgroundBrush}" />
    </Style>
    <Style Selector="ToggleButton.QuickSetting:not(:checked):not(.Active):pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.QuickSettingDetails:not(.Active):pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource QuickSettingHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton.QuickSetting:not(:checked):not(.Active):pressed /template/ ContentPresenter#PART_ContentPresenter, Button.QuickSettingDetails:not(.Active):pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource QuickSettingPressedBrush}" />
    </Style>
    <Style Selector="ToggleButton.QuickSetting > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource QuickSettingForegroundBrush}" />
    </Style>
    <Style Selector="ToggleButton.QuickSetting:disabled">
      <Setter Property="Opacity" Value="0.48" />
    </Style>

    <!-- Global Normalized Active / Accent Button states. -->
    <Style Selector="Button.Active /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.Active /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.QuickSetting:checked /template/ ContentPresenter#PART_ContentPresenter, Button.QuickSettingDetails.Active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppPrimaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
    </Style>
    <Style Selector="Button.Active TextBlock, ToggleButton.Active TextBlock, ToggleButton.QuickSetting:checked > TextBlock, Button.QuickSettingDetails.Active > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
    </Style>
    <Style Selector="Button.Active:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.Active:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.QuickSetting:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.QuickSettingDetails.Active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppPrimaryContainerHoverBrush}" />
    </Style>
    <Style Selector="Button.Active:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.Active:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.QuickSetting:checked:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.QuickSettingDetails.Active:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppPrimaryContainerPressedBrush}" />
    </Style>
  </Application.Styles>
</Application>
