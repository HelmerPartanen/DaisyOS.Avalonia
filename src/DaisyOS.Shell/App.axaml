<Application
    x:Class="DaisyOS.Shell.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DaisyOS.Shell/Themes/DynamicColors.axaml" />
        <ResourceInclude Source="avares://DaisyOS.Shell/Themes/OSTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme DensityStyle="Normal" />
    <StyleInclude Source="avares://DaisyOS.Shell/Styles/DropdownMenuStyles.axaml" />

    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="AccessText">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Reusable Material You Quick Settings states. -->
    <Style Selector="ToggleButton.QuickSetting">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppOnSurfaceBrush}" />
    </Style>
    <Style Selector="ToggleButton.QuickSetting:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceContainerHighBrush}" />
    </Style>
    <Style Selector="ToggleButton.QuickSetting:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceContainerHighestBrush}" />
    </Style>
    <Style Selector="ToggleButton.QuickSetting TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppOnPrimaryContainerBrush}" />
    </Style>
    <Style Selector="ToggleButton.QuickSetting:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppPrimaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppOnPrimaryContainerBrush}" />
    </Style>
    <Style Selector="ToggleButton.QuickSetting:checked TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppOnPrimaryContainerBrush}" />
    </Style>
    <Style Selector="ToggleButton.QuickSetting:disabled">
      <Setter Property="Opacity" Value="0.48" />
    </Style>
  </Application.Styles>
</Application>
