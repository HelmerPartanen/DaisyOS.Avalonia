<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Widgets.MediaWidget"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="380"
    Height="52"
    HorizontalAlignment="Left"
    VerticalAlignment="Bottom"
    Margin="4,0,0,4">
  <UserControl.Styles>
    <Style Selector="Border.spectrumBar">
      <Setter Property="Background" Value="{DynamicResource ContentPrimaryBrush}" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
  </UserControl.Styles>
  <Border x:Name="MediaFrame"
          Height="52"
          Background="{DynamicResource SurfaceBaseBrush}"
          BorderBrush="{DynamicResource StrokeSubtleBrush}"
          BorderThickness="2"
          CornerRadius="{DynamicResource RoundedXL}"
          ClipToBounds="True">
    <Grid>
      <!-- The adaptive artwork color sits above the shared System Bar material. -->
      <Border x:Name="ArtworkTint" Background="Transparent" IsHitTestVisible="False" CornerRadius="{DynamicResource RoundedXL}"/>
      <Grid Margin="4" ColumnDefinitions="44,*,120,28">
      <Border Width="44" Height="44" CornerRadius="{DynamicResource RoundedLG}" ClipToBounds="True">
        <Grid>
        <Image x:Name="Artwork" Stretch="UniformToFill" IsVisible="False"
               RenderOptions.BitmapInterpolationMode="HighQuality"/>
        <Border x:Name="SourceFallback" Background="{DynamicResource SurfaceSunkenBrush}">
          <Grid>
            <Image x:Name="SourceIcon" Width="24" Height="24" IsVisible="False"
                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
            <TextBlock x:Name="SourceGlyph" Text="music_note" FontSize="22"
                       FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        </Grid>
      </Border>

      <StackPanel Grid.Column="1" Margin="10,0,8,0" Spacing="1" VerticalAlignment="Center">
        <TextBlock x:Name="MediaTitle" Text="Not playing" FontSize="13" FontWeight="Regular" Foreground="{DynamicResource ContentPrimaryBrush}"
                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
        <TextBlock x:Name="MediaArtist" FontSize="11"
                   Foreground="{DynamicResource ContentSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Button Classes="ShellButton" Width="40" Height="40" Click="OnPreviousClicked" ToolTip.Tip="Previous track">
          <TextBlock x:Name="PreviousGlyph" Text="skip_previous" FontFamily="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" FontSize="18" Foreground="{DynamicResource ContentPrimaryBrush}" Opacity="0.8"/>
        </Button>
        <Button x:Name="PlayPauseButton" Classes="ShellButton" Width="40" Height="40" Click="OnPlayPauseClicked" ToolTip.Tip="Play">
          <TextBlock x:Name="PlayPauseGlyph" Text="play_arrow" FontFamily="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" FontSize="18" Foreground="{DynamicResource ContentPrimaryBrush}" Opacity="0.8"/>
        </Button>
        <Button Classes="ShellButton" Width="40" Height="40" Click="OnNextClicked" ToolTip.Tip="Next track">
          <TextBlock x:Name="NextGlyph" Text="skip_next" FontFamily="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" FontSize="18" Foreground="{DynamicResource ContentPrimaryBrush}" Opacity="0.8"/>
        </Button>
      </StackPanel>

      <Canvas x:Name="SpectrumCanvas" Grid.Column="3" Width="28" Height="28"
              VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
    </Grid>
  </Border>

</UserControl>
