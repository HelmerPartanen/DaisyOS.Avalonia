<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Wallpaper.WallpaperLayer"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ClipToBounds="True"
    IsHitTestVisible="False">
  <!-- Layout overscan, rather than a scale transform, keeps the image continuous during parallax. -->
  <Image x:Name="WallpaperImage"
         Source="avares://DaisyOS.Shell/Assets/Wallpapers/Wallpaper.jpg"
         Stretch="UniformToFill"
         HorizontalAlignment="Center"
         VerticalAlignment="Center"
         RenderTransformOrigin="0.5,0.5" />
</UserControl>
