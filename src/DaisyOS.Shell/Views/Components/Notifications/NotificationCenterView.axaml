<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Notifications.NotificationCenterView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="380" MaxHeight="600"
    ClipToBounds="True">

  <UserControl.Styles>
    <Style Selector="Border.NotificationItemCard">
      <Setter Property="Background" Value="{DynamicResource PrimarySurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.NotificationItemCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Padding="16" Background="{DynamicResource ElevatedSurfaceBrush}"
          BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
          CornerRadius="{DynamicResource RoundedXL}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16">

        <!-- 1. Calendar Header Widget -->
        <StackPanel Spacing="10">
          <TextBlock x:Name="CalendarHeading" FontSize="16" FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <Calendar IsTodayHighlighted="True" HorizontalAlignment="Center" />
        </StackPanel>

        <Border Height="1" Background="{DynamicResource DividerBrush}" Opacity="0.6" />

        <!-- 2. Notification Center Header -->
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="notifications" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                       FontSize="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Notifications" FontSize="15" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <Border x:Name="UnreadBadge" Background="{DynamicResource AccentBrush}" CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
              <TextBlock x:Name="UnreadCountText" Text="0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
          </StackPanel>

          <!-- DND Toggle -->
          <Button Grid.Column="1" x:Name="DndButton" Classes="ShellButton" Height="28" Padding="8,0" Margin="0,0,4,0"
                  ToolTip.Tip="Toggle Do Not Disturb" Click="OnDndToggled">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock x:Name="DndIcon" Text="do_not_disturb_on" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                         FontSize="14" VerticalAlignment="Center" />
              <TextBlock x:Name="DndText" Text="DND" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- Clear All Button -->
          <Button Grid.Column="2" x:Name="ClearAllButton" Classes="ShellButton" Height="28" Padding="8,0"
                  ToolTip.Tip="Clear all notifications" Click="OnClearAllClicked">
            <TextBlock Text="Clear All" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
          </Button>
        </Grid>

        <!-- Test Notification Generator Toolbar -->
        <Border Padding="8" Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="{DynamicResource RoundedMD}">
          <Grid ColumnDefinitions="*,*,*">
            <Button Grid.Column="0" Classes="ShellButton" Height="28" Margin="2,0" Padding="4,0"
                    ToolTip.Tip="Post standard test toast" Click="OnPostTestNotificationClicked">
              <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="add_alert" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="Test Toast" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Classes="ShellButton" Height="28" Margin="2,0" Padding="4,0"
                    ToolTip.Tip="Post urgent/critical test toast" Click="OnPostUrgentTestNotificationClicked">
              <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="warning" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="14" Foreground="#FF5252" VerticalAlignment="Center" />
                <TextBlock Text="Urgent" FontSize="11" FontWeight="Bold" Foreground="#FF5252" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="ShellButton" Height="28" Margin="2,0" Padding="4,0"
                    ToolTip.Tip="Post system update test toast" Click="OnPostSystemTestNotificationClicked">
              <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="system_update" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="System" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- 3. Empty State Visual -->
        <Border x:Name="EmptyStateHost" Padding="24,32" IsVisible="True" HorizontalAlignment="Center">
          <StackPanel Spacing="8" HorizontalAlignment="Center">
            <TextBlock Text="done_all" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                       FontSize="36" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="You're all caught up!" FontSize="13" FontWeight="Medium"
                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- 4. Notification List -->
        <ItemsControl x:Name="NotificationList" IsVisible="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="NotificationItemCard">
                <Grid ColumnDefinitions="Auto,*">
                  <!-- Left Column: App Icon Tile -->
                  <Panel Grid.Column="0" Width="40" Height="40" VerticalAlignment="Top" Margin="0,2,14,0">
                    <Border CornerRadius="12" ClipToBounds="True">
                      <Panel>
                        <!-- Fallback System Icon (only visible if Icon is null/empty) -->
                        <Border IsVisible="{Binding Icon, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                          <TextBlock Text="{Binding SystemIconGlyph, FallbackValue='notifications'}"
                                     FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                                     FontSize="32" Foreground="{DynamicResource AccentBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <!-- App Icon (visible if Icon is provided) -->
                        <Image Source="{Binding Icon}" Stretch="UniformToFill"
                               IsVisible="{Binding Icon, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </Panel>
                    </Border>
                  </Panel>

                  <!-- Right Column: Header, Title & Body -->
                  <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="2">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding SourceAppId, FallbackValue='System'}"
                                 FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding CreatedAt, StringFormat='{}{0:HH:mm}'}"
                                 FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,8,0" VerticalAlignment="Center" />
                      <Button Grid.Column="2" Classes="ShellButton" Width="24" Height="24" Padding="0"
                              ToolTip.Tip="Dismiss" Click="OnDismissItemClicked" Tag="{Binding Id}">
                        <TextBlock Text="close" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                                   FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Button>
                    </Grid>

                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />

                    <TextBlock Text="{Binding Body}" FontSize="12" FontWeight="Regular"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" LineHeight="18" />

                    <!-- Optional Action Button -->
                    <Button Classes="SubtleButton" Height="28" Padding="12,4" HorizontalAlignment="Left" Margin="0,8,0,0"
                            IsVisible="{Binding ActionLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Click="OnItemActionClicked" Tag="{Binding}">
                      <TextBlock Text="{Binding ActionLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
