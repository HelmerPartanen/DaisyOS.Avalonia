<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Notifications.NotificationCenterView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="320" MaxHeight="600"
    ClipToBounds="True"
    xmlns:converters="clr-namespace:DaisyOS.Shell.Converters">

  <UserControl.Resources>
    <converters:BitmapAssetValueConverter x:Key="BitmapAssetValueConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.NotificationItemCard">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedMD}" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.NotificationItemCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Padding="1" Background="{DynamicResource ShellFrameOuterEdgeBrush}"
          CornerRadius="{DynamicResource RoundedXL}">
    <Border Padding="1" Background="{DynamicResource ShellFrameInnerHighlightBrush}"
            CornerRadius="{DynamicResource RoundedXLInset}">
      <Border Padding="16,16,16,16" Background="{DynamicResource SurfaceBaseBrush}"
              CornerRadius="{DynamicResource RoundedXLDoubleInset}" ClipToBounds="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16">

        <!-- 1. Notification Center Header -->
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="notifications" FontFamily="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded"
                       FontSize="18" Foreground="{DynamicResource ActionPrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Notifications" FontSize="15" FontWeight="Bold"
                       Foreground="{DynamicResource ContentPrimaryBrush}" VerticalAlignment="Center" />
            <Border x:Name="UnreadBadge" Background="{DynamicResource ActionPrimaryBrush}" CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
              <TextBlock x:Name="UnreadCountText" Text="0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ContentPrimaryBrush}" />
            </Border>
          </StackPanel>



          <!-- Clear All Button -->
          <Button Grid.Column="2" x:Name="ClearAllButton" Classes="ShellButton" Height="28" Padding="8,0"
                  ToolTip.Tip="Clear all notifications" Click="OnClearAllClicked">
            <TextBlock Text="Clear All" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ContentSecondaryBrush}" VerticalAlignment="Center" />
          </Button>
        </Grid>



        <!-- 3. Empty State Visual -->
        <Border x:Name="EmptyStateHost" Padding="24,32" IsVisible="True" HorizontalAlignment="Center">
          <StackPanel Spacing="8" HorizontalAlignment="Center">
            <TextBlock Text="done_all" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                       FontSize="36" Foreground="{DynamicResource ContentDisabledBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="You're all caught up!" FontSize="13" FontWeight="Medium"
                       Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- 4. Notification List -->
        <ItemsControl x:Name="NotificationList" IsVisible="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="NotificationItemCard">
                <Grid ColumnDefinitions="Auto,*">
                  <!-- Left Column: App Icon Tile -->
                  <Panel Grid.Column="0" Width="32" Height="32" VerticalAlignment="Top" Margin="0,2,12,0">
                    <Border CornerRadius="8" ClipToBounds="True">
                      <Panel>
                        <!-- Fallback System Icon (only visible if Icon is null/empty) -->
                        <Border IsVisible="{Binding Icon, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                          <TextBlock Text="{Binding SystemIconGlyph, FallbackValue='notifications'}"
                                     FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                                     FontSize="24" Foreground="{DynamicResource ActionPrimaryBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <!-- App Icon (visible if Icon is provided) -->
                        <Image IsVisible="{Binding Icon, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Source="{Binding Icon, Converter={StaticResource BitmapAssetValueConverter}}"
                               Width="32" Height="32" Stretch="UniformToFill" />
                      </Panel>
                    </Border>
                  </Panel>

                  <!-- Right Column: Header, Title & Body -->
                  <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="2">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding SourceAppId, FallbackValue='System'}"
                                 FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ContentSecondaryBrush}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding CreatedAt, StringFormat='{}{0:HH:mm}'}"
                                 FontSize="10" Foreground="{DynamicResource ContentSecondaryBrush}" Margin="8,0,8,0" VerticalAlignment="Center" />
                      <Button Grid.Column="2" Classes="ShellButton" Width="20" Height="20" Padding="0"
                              ToolTip.Tip="Dismiss" Click="OnDismissItemClicked" Tag="{Binding Id}">
                        <TextBlock Text="close" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                                   FontSize="14" Foreground="{DynamicResource ContentSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Button>
                    </Grid>

                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource ContentPrimaryBrush}"
                               TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />

                    <TextBlock Text="{Binding Body}" FontSize="11" FontWeight="Regular"
                               Foreground="{DynamicResource ContentSecondaryBrush}"
                               TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" LineHeight="16" />

                    <!-- Optional Action Button -->
                    <Button Classes="SubtleButton" Height="24" Padding="10,4" HorizontalAlignment="Left" Margin="0,6,0,0"
                            IsVisible="{Binding ActionLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Click="OnItemActionClicked" Tag="{Binding}">
                      <TextBlock Text="{Binding ActionLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ContentPrimaryBrush}" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>
  </Border>
</UserControl>
