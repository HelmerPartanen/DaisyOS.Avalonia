<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Console.ConsoleHomeView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#090A0F">

  <UserControl.Styles>

    <!-- Square Game Cover Card Button -->
    <Style Selector="Button.GameCoverTile">
      <Setter Property="Width" Value="210" />
      <Setter Property="Height" Value="210" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Background" Value="#3310121A" />
      <Setter Property="BorderBrush" Value="#33FFFFFF" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />

      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Active Focused Card: Increased Size (scale 1.10) & Thicker Active Border (4px) -->
    <Style Selector="Button.GameCoverTile:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#55202432" />
      <Setter Property="BorderBrush" Value="#FFFFFFFF" />
      <Setter Property="BorderThickness" Value="4" />
    </Style>

    <Style Selector="Button.GameCoverTile:focus">
      <Setter Property="RenderTransform" Value="scale(1.10)" />
      <Setter Property="ZIndex" Value="10" />
    </Style>

    <Style Selector="Button.GameCoverTile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#44202432" />
      <Setter Property="BorderBrush" Value="#CCFFFFFF" />
      <Setter Property="BorderThickness" Value="2.5" />
    </Style>

    <Style Selector="Button.GameCoverTile:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.04)" />
    </Style>

    <Style Selector="Button.GameCoverTile:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#66202432" />
    </Style>

    <Style Selector="Button.GameCoverTile:pressed">
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav > TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#BBFFFFFF" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav:focus > TextBlock">
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#22FFFFFF" />
    </Style>

    <Style Selector="TextBlock.ConsoleStatusIcon">
      <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="#CCFFFFFF" />
    </Style>

  </UserControl.Styles>

  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <!-- Dual-Layer Fullscreen Background Images for Smooth Crossfading (High Opacity + Blur) -->
    <Grid x:Name="HeroBackgroundContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      
      <!-- Background Layer 1 -->
      <Image
          x:Name="HeroBackgroundImage1"
          Stretch="UniformToFill"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Opacity="0.0">
        <Image.Effect>
          <BlurEffect Radius="28" />
        </Image.Effect>
        <Image.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseOut" />
          </Transitions>
        </Image.Transitions>
      </Image>

      <!-- Background Layer 2 -->
      <Image
          x:Name="HeroBackgroundImage2"
          Stretch="UniformToFill"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Opacity="0.0">
        <Image.Effect>
          <BlurEffect Radius="28" />
        </Image.Effect>
        <Image.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseOut" />
          </Transitions>
        </Image.Transitions>
      </Image>

    </Grid>

    <!-- TV Vignette & Dark Gradient Mask for Maximum Contrast -->
    <Border IsHitTestVisible="False">
      <Border.Background>
        <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="85%" RadiusY="85%">
          <GradientStop Color="#00000000" Offset="0.0" />
          <GradientStop Color="#99090A0F" Offset="0.65" />
          <GradientStop Color="#F0090A0F" Offset="1.0" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>

    <Border IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#CD090A0F" Offset="0.0" />
          <GradientStop Color="#55090A0F" Offset="0.45" />
          <GradientStop Color="#EE090A0F" Offset="1.0" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <Grid Margin="64,28,64,28">

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Top System Bar Header -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button x:Name="HeaderLibraryButton" Classes="ConsoleHeaderNav" ToolTip.Tip="Library">
            <TextBlock Text="Games" />
          </Button>
          <Button x:Name="HeaderRecentButton" Classes="ConsoleHeaderNav" ToolTip.Tip="Recently played">
            <TextBlock Text="Recent" />
          </Button>
          <Button x:Name="HeaderSettingsButton" Classes="ConsoleHeaderNav" ToolTip.Tip="Settings">
            <TextBlock Text="Settings" />
          </Button>
        </StackPanel>

        <Border Grid.Column="1" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <Border Background="#28FFFFFF" CornerRadius="12" Padding="10,4">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="sports_esports" Classes="ConsoleStatusIcon" FontSize="16" />
                <TextBlock x:Name="ControllerStatusText" Text="Controller" FontSize="13" FontWeight="Medium" Foreground="#DDFFFFFF" />
              </StackPanel>
            </Border>
            <TextBlock Text="wifi" Classes="ConsoleStatusIcon" />
            <TextBlock Text="battery_full" Classes="ConsoleStatusIcon" />
            <TextBlock x:Name="ClockText" Text="14:44" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFFFF" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Center Content: Vertically Centered along Y Axis -->
      <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="28">

        <!-- Active Game Spotlight Header (Clean Title Heading + Source Badge) -->
        <StackPanel Spacing="6" Margin="8,0,0,0">
          
          <!-- Source Badge & Status Subtext -->
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Background="#44FFFFFF" CornerRadius="6" Padding="10,3" VerticalAlignment="Center">
              <TextBlock x:Name="SelectedGameSourceText" Text="STEAM" FontSize="12" FontWeight="Bold" Foreground="#FFFFFFFF" />
            </Border>
            <TextBlock x:Name="SelectedGameSubtext" Text="Installed • Ready to play" FontSize="14" FontWeight="Medium" Foreground="#EEFFFFFF" VerticalAlignment="Center" />
          </StackPanel>

          <!-- Prominent Game Title Heading (Always Visible!) -->
          <TextBlock x:Name="SelectedGameTitleText" Text="Game Title" FontSize="42" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left" />

        </StackPanel>

        <!-- Centered Square App Cards Carousel Track -->
        <Grid Height="250" HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <StackPanel
              x:Name="CarouselTrack"
              Orientation="Horizontal"
              Spacing="24"
              VerticalAlignment="Center">

            <!-- Dynamic square game cards populated at runtime -->

          </StackPanel>
        </Grid>

      </StackPanel>

      <!-- Bottom Controller Action Hints Footer Glass Bar -->
      <Border
          Grid.Row="2"
          Background="#4410121A"
          BorderBrush="#33FFFFFF"
          BorderThickness="1"
          CornerRadius="16"
          Padding="20,12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="32" VerticalAlignment="Center">
            
            <!-- (A) Select / Launch -->
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border Width="26" Height="26" CornerRadius="13" Background="#1E88E5" BorderBrush="#80FFFFFF" BorderThickness="1">
                <TextBlock Text="A" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Select / Launch" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
            </StackPanel>

            <!-- (X) Game Details -->
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border Width="26" Height="26" CornerRadius="13" Background="#43A047" BorderBrush="#80FFFFFF" BorderThickness="1">
                <TextBlock Text="X" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Game Details" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
            </StackPanel>

            <!-- (Y) Options -->
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border Width="26" Height="26" CornerRadius="13" Background="#FB8C00" BorderBrush="#80FFFFFF" BorderThickness="1">
                <TextBlock Text="Y" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Options" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
            </StackPanel>

          </StackPanel>

          <!-- Tab Navigation Hint (LB / RB) -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Background="#33FFFFFF" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,4">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="LB" FontSize="12" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="/" FontSize="12" Foreground="#88FFFFFF" />
                <TextBlock Text="RB" FontSize="12" FontWeight="Bold" Foreground="White" />
              </StackPanel>
            </Border>
            <TextBlock Text="Switch Tab" FontSize="14" FontWeight="SemiBold" Foreground="#EEFFFFFF" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

    </Grid>

  </Grid>

</UserControl>
