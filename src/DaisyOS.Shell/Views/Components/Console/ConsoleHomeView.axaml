<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Console.ConsoleHomeView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#090A0F">

  <UserControl.Styles>

    <!-- Square Game Cover Card Button -->
    <Style Selector="Button.GameCoverTile">
      <Setter Property="Width" Value="210" />
      <Setter Property="Height" Value="210" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Background" Value="#3310121A" />
      <Setter Property="BorderBrush" Value="#33FFFFFF" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />

      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Active Focused Card: Increased Size (scale 1.10) & Thicker Active Border (4px) -->
    <Style Selector="Button.GameCoverTile:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#55202432" />
      <Setter Property="BorderBrush" Value="#FFFFFFFF" />
      <Setter Property="BorderThickness" Value="4" />
    </Style>

    <Style Selector="Button.GameCoverTile:focus">
      <Setter Property="RenderTransform" Value="scale(1.10)" />
      <Setter Property="ZIndex" Value="10" />
    </Style>

    <Style Selector="Button.GameCoverTile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#44202432" />
      <Setter Property="BorderBrush" Value="#CCFFFFFF" />
      <Setter Property="BorderThickness" Value="2.5" />
    </Style>

    <Style Selector="Button.GameCoverTile:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.04)" />
    </Style>

    <Style Selector="Button.GameCoverTile:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#66202432" />
    </Style>

    <Style Selector="Button.GameCoverTile:pressed">
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav > TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#BBFFFFFF" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav:focus > TextBlock">
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#22FFFFFF" />
    </Style>

    <Style Selector="TextBlock.ConsoleStatusIcon">
      <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="#CCFFFFFF" />
    </Style>

  </UserControl.Styles>

  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <!-- Fullscreen Centered Background Image -->
    <Image
        x:Name="HeroBackgroundImage"
        Stretch="UniformToFill"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Opacity="0.50">
      <Image.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseOut" />
        </Transitions>
      </Image.Transitions>
    </Image>

    <!-- TV Vignette & Dark Gradient Mask -->
    <Border IsHitTestVisible="False">
      <Border.Background>
        <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="80%" RadiusY="80%">
          <GradientStop Color="#00000000" Offset="0.0" />
          <GradientStop Color="#CC090A0F" Offset="0.7" />
          <GradientStop Color="#F6090A0F" Offset="1.0" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>

    <Border IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#E6090A0F" Offset="0.0" />
          <GradientStop Color="#77090A0F" Offset="0.45" />
          <GradientStop Color="#FA090A0F" Offset="1.0" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <Grid Margin="64,28,64,32">

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Top System Bar Header -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button x:Name="HeaderLibraryButton" Classes="ConsoleHeaderNav" ToolTip.Tip="Library">
            <TextBlock Text="Games" />
          </Button>
          <Button x:Name="HeaderRecentButton" Classes="ConsoleHeaderNav" ToolTip.Tip="Recently played">
            <TextBlock Text="Recent" />
          </Button>
          <Button x:Name="HeaderSettingsButton" Classes="ConsoleHeaderNav" ToolTip.Tip="Settings">
            <TextBlock Text="Settings" />
          </Button>
        </StackPanel>

        <Border Grid.Column="1" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <Border Background="#22FFFFFF" CornerRadius="12" Padding="10,4">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="sports_esports" Classes="ConsoleStatusIcon" FontSize="16" />
                <TextBlock x:Name="ControllerStatusText" Text="Controller" FontSize="13" FontWeight="Medium" Foreground="#DDFFFFFF" />
              </StackPanel>
            </Border>
            <TextBlock Text="wifi" Classes="ConsoleStatusIcon" />
            <TextBlock Text="battery_full" Classes="ConsoleStatusIcon" />
            <TextBlock x:Name="ClockText" Text="14:40" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFFFF" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Center Content: Vertically Centered along Y Axis -->
      <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="28">

        <!-- Active Game Spotlight Header (Clean Title Heading + Source Badge) -->
        <StackPanel Spacing="6" Margin="8,0,0,0">
          
          <!-- Source Badge & Status Subtext -->
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Background="#3DFFFFFF" CornerRadius="6" Padding="10,3" VerticalAlignment="Center">
              <TextBlock x:Name="SelectedGameSourceText" Text="STEAM" FontSize="12" FontWeight="Bold" Foreground="#FFFFFFFF" />
            </Border>
            <TextBlock x:Name="SelectedGameSubtext" Text="Installed • Ready to play" FontSize="14" FontWeight="Medium" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
          </StackPanel>

          <!-- Prominent Game Title Heading (Always Visible!) -->
          <TextBlock x:Name="SelectedGameTitleText" Text="Game Title" FontSize="42" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left" />

        </StackPanel>

        <!-- Centered Square App Cards Carousel Track (Slightly larger container height for active card scaling) -->
        <Grid Height="250" HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <StackPanel
              x:Name="CarouselTrack"
              Orientation="Horizontal"
              Spacing="24"
              VerticalAlignment="Center">

            <!-- Dynamic square game cards populated at runtime -->

          </StackPanel>
        </Grid>

      </StackPanel>

      <!-- Bottom Controller Action Hints Footer Bar -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom" Margin="8,0">
        <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Width="22" Height="22" CornerRadius="11" Background="#33FFFFFF" BorderBrush="#88FFFFFF" BorderThickness="1">
              <TextBlock Text="A" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Select / Launch" FontSize="13" FontWeight="Medium" Foreground="#BBFFFFFF" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Width="22" Height="22" CornerRadius="11" Background="#33FFFFFF" BorderBrush="#88FFFFFF" BorderThickness="1">
              <TextBlock Text="X" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Game Details" FontSize="13" FontWeight="Medium" Foreground="#BBFFFFFF" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Background="#22FFFFFF" CornerRadius="6" Padding="8,2">
            <TextBlock Text="LB / RB" FontSize="12" FontWeight="Bold" Foreground="#DDFFFFFF" />
          </Border>
          <TextBlock Text="Switch Tab" FontSize="13" FontWeight="Medium" Foreground="#BBFFFFFF" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>

    </Grid>

  </Grid>

</UserControl>
