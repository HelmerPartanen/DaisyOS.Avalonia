<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Console.ConsoleHomeView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">

  <UserControl.Styles>

    <!-- Square Game Cover Card Button -->
    <Style Selector="Button.GameCoverTile">
      <Setter Property="Width" Value="210" />
      <Setter Property="Height" Value="210" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource TertiarySurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedXL}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />

      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Button.GameCoverTile:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.GameCoverTile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
    </Style>

    <Style Selector="Button.GameCoverTile:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
    </Style>

    <Style Selector="Button.GameCoverTile:pressed">
      <Setter Property="RenderTransform" Value="scale(0.985)" />
    </Style>

    <Style Selector="Border.ConsoleFocusRing">
      <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="4" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedXL}" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedMD}" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav > TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav:focus > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OnAccentSurfaceBrush}" />
    </Style>

    <Style Selector="TextBlock.ConsoleStatusIcon">
      <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

  </UserControl.Styles>

  <Grid>

    <!-- Fullscreen Background Image (Unzoomed, Crisp Display) -->
    <Image
        x:Name="HeroBackgroundImage"
        Stretch="UniformToFill"
        Opacity="0.42">
      <Image.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseOut" />
        </Transitions>
      </Image.Transitions>
    </Image>

    <!-- Dark gradient overlay for visual clarity -->
    <Border IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#DD090A0F" Offset="0.0" />
          <GradientStop Color="#99090A0F" Offset="0.5" />
          <GradientStop Color="#F4090A0F" Offset="1.0" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <Grid Margin="64,28,64,36">

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Top System Bar Header -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button x:Name="HeaderLibraryButton" Classes="ConsoleHeaderNav" ToolTip.Tip="Library">
            <TextBlock Text="Games" />
          </Button>
          <Button x:Name="HeaderRecentButton" Classes="ConsoleHeaderNav" ToolTip.Tip="Recently played">
            <TextBlock Text="Recent" />
          </Button>
          <Button x:Name="HeaderSettingsButton" Classes="ConsoleHeaderNav" ToolTip.Tip="Settings">
            <TextBlock Text="Settings" />
          </Button>
        </StackPanel>

        <Border Grid.Column="1">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="wifi" Classes="ConsoleStatusIcon" />
            <TextBlock Text="battery_full" Classes="ConsoleStatusIcon" />
            <TextBlock x:Name="ClockText" Text="14:22" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Center Content: Vertically Centered along Y Axis -->
      <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="24">

        <!-- Active Game Spotlight Header -->
        <StackPanel Spacing="8" Margin="8,0,0,0">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Background="#3AFFFFFF" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
              <TextBlock x:Name="SelectedGameSourceText" Text="STEAM" FontSize="12" FontWeight="Bold" Foreground="#EEFFFFFF" />
            </Border>
            <TextBlock x:Name="SelectedGameSubtext" Text="Ready to play" FontSize="14" Foreground="#AAFFFFFF" VerticalAlignment="Center" />
          </StackPanel>

          <!-- Transparent Logo or Title -->
          <Panel Height="70" HorizontalAlignment="Left">
            <Image x:Name="SelectedGameLogoImage" MaxWidth="380" MaxHeight="70" Stretch="Uniform" HorizontalAlignment="Left" IsVisible="False" />
            <TextBlock x:Name="SelectedGameTitleText" Text="Game Title" FontSize="36" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
          </Panel>
        </StackPanel>

        <!-- Centered Square App Cards Carousel Track -->
        <Grid Height="220" HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <StackPanel
              x:Name="CarouselTrack"
              Orientation="Horizontal"
              Spacing="20"
              VerticalAlignment="Center">

            <!-- Dynamic square game cards populated at runtime -->

          </StackPanel>
        </Grid>

      </StackPanel>

      <!-- Bottom Spacer -->
      <Border Grid.Row="2" Height="20" />

    </Grid>

  </Grid>

</UserControl>
