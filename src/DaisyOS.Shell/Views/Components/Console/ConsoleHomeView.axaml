<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Console.ConsoleHomeView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

  <UserControl.Styles>

    <Style Selector="Button.ConsoleTile">
      <Setter Property="Width" Value="210" />
      <Setter Property="Height" Value="210" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="Background" Value="#1AFFFFFF" />
      <Setter Property="BorderBrush" Value="#1FFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Bottom" />
      <Setter Property="VerticalAlignment" Value="Center" />

      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition
              Property="Opacity"
              Duration="0:0:0.14" />

          <TransformOperationsTransition
              Property="RenderTransform"
              Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Controller focus -->
    <Style Selector="Button.ConsoleTile:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#26FFFFFF" />
      <Setter Property="BorderBrush" Value="#1FFFFFFF" />
    </Style>

    <!-- Mouse hover is quieter than controller focus -->
    <Style Selector="Button.ConsoleTile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#26FFFFFF" />
    </Style>

    <Style Selector="Button.ConsoleTile:pressed">
      <Setter Property="Background" Value="#4DFFFFFF" />
      <Setter Property="RenderTransform" Value="scale(0.985)" />
    </Style>

  </UserControl.Styles>


  <Grid>

    <!-- Keep the shared wallpaper visible -->
    <Border
        Background="#33000000"
        IsHitTestVisible="False" />


    <Grid Margin="72,48">

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>


      <!-- Header -->
      <Grid
          Grid.Row="0"
          ColumnDefinitions="*,Auto"
          VerticalAlignment="Center">


        <StackPanel
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="18"
            VerticalAlignment="Center">

          <TextBlock
              Text="wifi"
              FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
              FontSize="20"
              Foreground="#CCFFFFFF" />

          <TextBlock
              Text="battery_full"
              FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
              FontSize="20"
              Foreground="#CCFFFFFF" />

          <TextBlock
              Text="11:42"
              FontSize="15"
              FontWeight="Medium"
              Foreground="#E6FFFFFF" />

        </StackPanel>

      </Grid>


      <!-- Main console home -->
      <Grid
          Grid.Row="1"
          MaxWidth="1400"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Center">

        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="24" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <StackPanel
            Grid.Row="2"
            Spacing="20">

          <!-- Section header -->
          <Grid ColumnDefinitions="*,Auto">

            <TextBlock
                Text="Home"
                FontSize="21"
                FontWeight="SemiBold"
                Foreground="White" />

          </Grid>


          <!--
              Fixed PS5-style card row.

              Card size: 210 x 210
              Slot:      210 x 210 (5px focus ring overlay)
              Step:      230
          -->
          <Border
              Height="230"
              HorizontalAlignment="Stretch">

            <StackPanel
                x:Name="CarouselTrack"
                Orientation="Horizontal"
                Spacing="20"
                VerticalAlignment="Center">


              <!-- Library -->
              <Grid Width="210" Height="210">
                <Button
                    x:Name="LibraryButton"
                    Classes="ConsoleTile"
                    ToolTip.Tip="Library">

                <StackPanel Spacing="10">

                  <TextBlock
                      Text="stadia_controller"
                      FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                      FontSize="36"
                      Foreground="White" />

                  <TextBlock
                      Text="Library"
                      FontSize="18"
                      FontWeight="SemiBold"
                      Foreground="White" />

                </StackPanel>

                </Button>
                <Border
                    x:Name="LibraryFocusRing"
                    BorderBrush="White"
                    BorderThickness="5"
                    CornerRadius="24"
                    IsHitTestVisible="False"
                    IsVisible="False" />
              </Grid>


              <!-- Recent -->
              <Grid Width="210" Height="210">
                <Button
                    x:Name="RecentButton"
                    Classes="ConsoleTile"
                    ToolTip.Tip="Recently played">

                <StackPanel Spacing="10">

                  <TextBlock
                      Text="history"
                      FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                      FontSize="36"
                      Foreground="White" />

                  <TextBlock
                      Text="Recent"
                      FontSize="18"
                      FontWeight="SemiBold"
                      Foreground="White" />

                </StackPanel>

                </Button>
                <Border
                    x:Name="RecentFocusRing"
                    BorderBrush="White"
                    BorderThickness="5"
                    CornerRadius="24"
                    IsHitTestVisible="False"
                    IsVisible="False" />
              </Grid>


              <!-- Friends -->
              <Grid Width="210" Height="210">
                <Button
                    x:Name="FriendsButton"
                    Classes="ConsoleTile"
                    ToolTip.Tip="Friends">

                <StackPanel Spacing="10">

                  <TextBlock
                      Text="group"
                      FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                      FontSize="36"
                      Foreground="White" />

                  <TextBlock
                      Text="Friends"
                      FontSize="18"
                      FontWeight="SemiBold"
                      Foreground="White" />

                </StackPanel>

                </Button>
                <Border
                    x:Name="FriendsFocusRing"
                    BorderBrush="White"
                    BorderThickness="5"
                    CornerRadius="24"
                    IsHitTestVisible="False"
                    IsVisible="False" />
              </Grid>


              <!-- Settings -->
              <Grid Width="210" Height="210">
                <Button
                    x:Name="SettingsButton"
                    Classes="ConsoleTile"
                    ToolTip.Tip="Settings">

                <StackPanel Spacing="10">

                  <TextBlock
                      Text="settings"
                      FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                      FontSize="36"
                      Foreground="White" />

                  <TextBlock
                      Text="Settings"
                      FontSize="18"
                      FontWeight="SemiBold"
                      Foreground="White" />

                </StackPanel>

                </Button>
                <Border
                    x:Name="SettingsFocusRing"
                    BorderBrush="White"
                    BorderThickness="5"
                    CornerRadius="24"
                    IsHitTestVisible="False"
                    IsVisible="False" />
              </Grid>

            </StackPanel>

          </Border>

        </StackPanel>

      </Grid>

    </Grid>

  </Grid>

</UserControl>
