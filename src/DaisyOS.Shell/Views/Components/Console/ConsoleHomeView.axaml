<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Console.ConsoleHomeView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:console="clr-namespace:DaisyOS.Shell.Views.Components.Console"
    xmlns:vm="clr-namespace:DaisyOS.Shell.ViewModels"
    Background="{DynamicResource ConsoleBackgroundBrush}">

  <UserControl.Resources>
    <DataTemplate x:Key="GameCardTemplate" DataType="vm:ConsoleGameItemViewModel">
      <Button Classes="GameCoverTile" ToolTip.Tip="{Binding Title}" ClipToBounds="False" Click="OnGameTileClicked">
        <Grid>
          <Border Classes="ConsoleCardClipper" CornerRadius="16" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid>
              <!-- 1. Cover Image Layer -->
              <Image Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                     Source="{Binding CoverImage}" IsVisible="{Binding HasCoverImage}" />

              <!-- 2. Logo Card Layer -->
              <Border Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding IsLogoCard}">
                <Image Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="174" MaxHeight="140"
                       Source="{Binding LogoImage}" />
              </Border>

              <!-- 3. Fallback Layer -->
              <Border Padding="14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding ShowFallbackUI}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                  <Image Width="48" Height="48" HorizontalAlignment="Center"
                         Source="{Binding IconImage}" IsVisible="{Binding HasIconImage}" />
                  <TextBlock Classes="ConsoleFallbackTitle" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                             TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>

    <!-- Square Game Cover Card Button -->
    <Style Selector="Button.GameCoverTile">
      <Setter Property="Width" Value="210" />
      <Setter Property="Height" Value="210" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />

      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>

      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <!-- Outer Offsetted White Outline Ring (6px gap, 22px CornerRadius) -->
            <Border x:Name="PART_FocusRing"
                    BorderBrush="#FFFFFF"
                    BorderThickness="2.5"
                    CornerRadius="22"
                    Margin="-2"
                    Opacity="0"
                    ClipToBounds="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="LinearEasing" />
                  <ThicknessTransition Property="Margin" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>

            <!-- Inner Image Cropper & ContentPresenter -->
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              ClipToBounds="True">
              <ContentPresenter.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
              </ContentPresenter.Transitions>
            </ContentPresenter>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.GameCoverTile:focus /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Margin" Value="-6" />
    </Style>

    <Style Selector="Button.GameCoverTile:focus">
      <Setter Property="RenderTransform" Value="scale(1.06)" />
      <Setter Property="ZIndex" Value="10" />
    </Style>

    <Style Selector="Button.GameCoverTile:pointerover /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="Margin" Value="-6" />
    </Style>

    <Style Selector="Button.GameCoverTile:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.04)" />
    </Style>

    <Style Selector="Button.GameCoverTile:pressed">
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <!-- Fix for ItemsControl container Z-Index overlapping and clipping -->
    <Style Selector="ItemsControl > ContentPresenter">
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    
    <Style Selector="ItemsControl > ContentPresenter:focus-within">
      <Setter Property="ZIndex" Value="10" />
    </Style>
    
    <Style Selector="ItemsControl > ContentPresenter:pointerover">
      <Setter Property="ZIndex" Value="10" />
    </Style>

    <!-- Restore margins for library cards within WrapPanel -->
    <Style Selector="ItemsControl#LibraryGrid > ContentPresenter">
      <Setter Property="Margin" Value="0,0,28,32" />
    </Style>

    <!-- OSTheme Classes for Dynamically Created Tile Elements -->
    <Style Selector="Border.ConsoleCardClipper">
      <Setter Property="Background" Value="{DynamicResource ConsoleElevatedSurfaceBrush}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.ConsoleTitleScrim">
      <Setter Property="Background" Value="{DynamicResource ConsoleSurfaceBrush}" />
    </Style>

    <Style Selector="TextBlock.ConsoleCardTitleText">
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.ConsoleFallbackTitle">
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextPrimaryBrush}" />
    </Style>

    <!-- Top Header Tab Navigation Buttons -->
    <Style Selector="Button.ConsoleHeaderNav">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="22,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />

      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <!-- Outer Offsetted White Outline Ring (5px gap, 25px CornerRadius) -->
            <Border x:Name="PART_FocusRing"
                    BorderBrush="{DynamicResource ConsoleAccentBrush}"
                    BorderThickness="3"
                    CornerRadius="17"
                    Margin="-5"
                    Opacity="0"
                    ClipToBounds="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>

            <!-- Main Inner Pill ContentPresenter -->
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ClipToBounds="True">
              <ContentPresenter.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
              </ContentPresenter.Transitions>
            </ContentPresenter>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.ConsoleHeaderNav TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- State 1: Active Tab -> Solid White Pill, Solid Black Text, NO GLOW -->
    <Style Selector="Button.ConsoleHeaderNav.Active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ConsolePrimaryButtonBgBrush}" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav.Active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ConsolePrimaryButtonFgBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- State 2: Focused State -> Show Outer Offsetted White Ring -->
    <Style Selector="Button.ConsoleHeaderNav:focus /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.ConsoleHeaderNav:pointerover /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav:focus TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Ensure Active Focused Text stays solid black on the white pill -->
    <Style Selector="Button.ConsoleHeaderNav.Active:focus TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ConsolePrimaryButtonFgBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- State 3: Hover State -> Show Outer Offsetted White Ring -->
    <Style Selector="Button.ConsoleHeaderNav:pointerover:not(.Active) /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav:pointerover:not(.Active) TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="TextBlock.ConsoleStatusIcon">
      <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextSecondaryBrush}" />
    </Style>

    <Style Selector="Button.ConsolePrimaryBtn">
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="24,0" />
      <Setter Property="Background" Value="{DynamicResource ConsolePrimaryButtonBgBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ConsolePrimaryButtonFgBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedMD}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="ClipToBounds" Value="False" />

      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <Border x:Name="PART_FocusRing"
                    BorderBrush="#FFFFFF"
                    BorderThickness="2"
                    CornerRadius="16"
                    Margin="-5"
                    Opacity="0"
                    ClipToBounds="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>

            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ClipToBounds="True">
              <ContentPresenter.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
              </ContentPresenter.Transitions>
            </ContentPresenter>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.ConsolePrimaryBtn /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ConsolePrimaryButtonBgBrush}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource ConsolePrimaryButtonFgBrush}" />
    </Style>

    <Style Selector="Button.ConsolePrimaryBtn:focus /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.ConsolePrimaryBtn:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ConsolePrimaryButtonHoverBgBrush}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource ConsolePrimaryButtonFgBrush}" />
    </Style>

    <Style Selector="Button.ConsoleActionBtn">
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="20,0" />
      <Setter Property="Background" Value="{DynamicResource ConsoleSecondaryButtonBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ConsoleDividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedMD}" />
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextPrimaryBrush}" />
      <Setter Property="ClipToBounds" Value="False" />

      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <Border x:Name="PART_FocusRing"
                    BorderBrush="#FFFFFF"
                    BorderThickness="2"
                    CornerRadius="16"
                    Margin="-5"
                    Opacity="0"
                    ClipToBounds="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>

            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ClipToBounds="True">
              <ContentPresenter.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
              </ContentPresenter.Transitions>
            </ContentPresenter>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.ConsoleActionBtn:focus /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.ConsoleActionBtn:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ConsolePrimaryButtonBgBrush}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource ConsolePrimaryButtonFgBrush}" />
    </Style>

    <Style Selector=":is(Control).HomeTabContent">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.08" Easing="QuadraticEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector=":is(Control).HomeTabContent.ActiveTab">
      <Setter Property="IsHitTestVisible" Value="True" />
      <Setter Property="Opacity" Value="1" />
    </Style>

  </UserControl.Styles>

  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <!-- Dual-Layer Fullscreen Background Hero Images (Low Opacity Ambient Background) -->
    <Grid x:Name="HeroBackgroundContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="True">
      <Image x:Name="HeroBackgroundImage1" Stretch="UniformToFill" Opacity="0.20">
        <Image.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="LinearEasing" />
          </Transitions>
        </Image.Transitions>
      </Image>
      <Image x:Name="HeroBackgroundImage2" Stretch="UniformToFill" Opacity="0.20">
        <Image.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="LinearEasing" />
          </Transitions>
        </Image.Transitions>
      </Image>

      <!-- Subtle Dark Gradient Vignette for UI Text Readability -->
      <Border IsHitTestVisible="False">
<Border Background="{DynamicResource ConsoleOverlayBrush}"
        IsHitTestVisible="False" />
      </Border>
    </Grid>

    <Grid Margin="16,16,16,16" ClipToBounds="False">

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Top System Bar Header (Modular Component) -->
      <console:ConsoleHeaderBar x:Name="HeaderBar" Grid.Row="0" TabSelected="OnHeaderTabSelected" SettingsClicked="OnHeaderSettingsClicked" />

      <!-- Main Content Area: PS5/PS6 Discrete Tab View Containers (Zero Layout Confusion) -->
      <Grid Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ClipToBounds="False">

        <!-- TAB 1: RECENTS TAB CONTENT (Spotlight Header + Hero Carousel Track) -->
        <Grid x:Name="RecentsTabContent" Classes="HomeTabContent ActiveTab" VerticalAlignment="Center" HorizontalAlignment="Stretch" ClipToBounds="False">
          <StackPanel Spacing="24" ClipToBounds="False">

            <!-- Active Game Spotlight Header -->
            <StackPanel Spacing="8" Margin="8,0,0,0">
              <!-- Title + Badge Row -->
              <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock x:Name="SelectedGameTitleText" Text="Game Title" FontSize="42" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                <Border Background="#33FFFFFF" CornerRadius="999" Padding="14,6" VerticalAlignment="Center" Margin="0,4,0,0">
                  <TextBlock x:Name="SelectedGameSourceText" Text="STEAM" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </Border>
              </StackPanel>

              <!-- Subtext Row (Optically Aligned) -->
              <TextBlock x:Name="SelectedGameSubtext" Text="Recently Played • Ready to play" FontSize="14" FontWeight="Medium" Foreground="White" VerticalAlignment="Center" Margin="2,0,0,0" />
            </StackPanel>

            <!-- Carousel Container (290px Height guarantees zero clipping) -->
            <Grid Height="290" Margin="0,10,0,10" HorizontalAlignment="Stretch" VerticalAlignment="Center" ClipToBounds="False">
              <ItemsControl x:Name="RecentGamesList" ItemsSource="{Binding RecentGames}" ItemTemplate="{StaticResource GameCardTemplate}" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="28" Margin="24,0,0,0" VerticalAlignment="Center" ClipToBounds="False" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </Grid>

          </StackPanel>
        </Grid>

        <!-- TAB 2: LIBRARY TAB CONTENT (Clean Multi-Row Scrollable Game Grid) -->
        <ScrollViewer x:Name="LibraryTabContent" Classes="HomeTabContent" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" ClipToBounds="False" Padding="24,16,24,40">
          <StackPanel Spacing="20" ClipToBounds="False">
            
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,0,16">
              <TextBlock Text="grid_view" Classes="ConsoleStatusIcon" FontSize="26" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Game Library" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Spacing="0" ClipToBounds="False">
              <TextBlock x:Name="LibraryCountText" Text="0 Games" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" Margin="0,0,0,24" />
              
              <!-- Grid Container -->
              <ItemsControl x:Name="LibraryGrid" ItemsSource="{Binding AllLibraryGames}" ItemTemplate="{StaticResource GameCardTemplate}" ClipToBounds="False" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" ClipToBounds="False" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

      </Grid>

      <!-- Bottom Controller Action Hints Bar (Modular Component) -->
      <console:ConsoleActionBar x:Name="ActionBar" Grid.Row="2" />

    </Grid>

  </Grid>

</UserControl>
