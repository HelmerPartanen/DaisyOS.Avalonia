<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Console.ConsoleHomeView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource PrimarySurfaceBrush}">

  <UserControl.Styles>

    <!-- Square Game Cover Card Button -->
    <Style Selector="Button.GameCoverTile">
      <Setter Property="Width" Value="210" />
      <Setter Property="Height" Value="210" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Background" Value="{DynamicResource TertiarySurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />

      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Active Focused Card: Uses OSTheme TextPrimaryBrush for focus border -->
    <Style Selector="Button.GameCoverTile:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="4" />
    </Style>

    <Style Selector="Button.GameCoverTile:focus">
      <Setter Property="RenderTransform" Value="scale(1.10)" />
      <Setter Property="ZIndex" Value="10" />
    </Style>

    <Style Selector="Button.GameCoverTile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="2.5" />
    </Style>

    <Style Selector="Button.GameCoverTile:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.04)" />
    </Style>

    <Style Selector="Button.GameCoverTile:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
    </Style>

    <Style Selector="Button.GameCoverTile:pressed">
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <!-- OSTheme Classes for Dynamically Created Tile Elements -->
    <Style Selector="Border.ConsoleCardClipper">
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
    </Style>

    <Style Selector="Border.ConsoleTitleScrim">
      <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
    </Style>

    <Style Selector="TextBlock.ConsoleCardTitleText">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.ConsoleFallbackTitle">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav > TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav:focus > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OnAccentSurfaceBrush}" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource GhostHoverBrush}" />
    </Style>

    <Style Selector="TextBlock.ConsoleStatusIcon">
      <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

  </UserControl.Styles>

  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <!-- Dual-Layer Fullscreen Background Images for Smooth Crossfading (Zoomed scale 1.15x for Seamless Edge Blur) -->
    <Grid x:Name="HeroBackgroundContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      
      <!-- Background Layer 1 -->
      <Image
          x:Name="HeroBackgroundImage1"
          Stretch="UniformToFill"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          RenderTransformOrigin="50%,50%"
          RenderTransform="scale(1.15)"
          Opacity="0.0">
        <Image.Effect>
          <BlurEffect Radius="32" />
        </Image.Effect>
        <Image.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseOut" />
          </Transitions>
        </Image.Transitions>
      </Image>

      <!-- Background Layer 2 -->
      <Image
          x:Name="HeroBackgroundImage2"
          Stretch="UniformToFill"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          RenderTransformOrigin="50%,50%"
          RenderTransform="scale(1.15)"
          Opacity="0.0">
        <Image.Effect>
          <BlurEffect Radius="32" />
        </Image.Effect>
        <Image.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseOut" />
          </Transitions>
        </Image.Transitions>
      </Image>

    </Grid>

    <!-- OSTheme Surface Overlay for High Contrast Readability -->
    <Border IsHitTestVisible="False" Background="{DynamicResource SecondarySurfaceBrush}" Opacity="0.85" />

    <Grid Margin="64,28,64,28">

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Top System Bar Header -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button x:Name="HeaderLibraryButton" Classes="ConsoleHeaderNav" ToolTip.Tip="Library">
            <TextBlock Text="Games" />
          </Button>
          <Button x:Name="HeaderRecentButton" Classes="ConsoleHeaderNav" ToolTip.Tip="Recently played">
            <TextBlock Text="Recent" />
          </Button>
          <Button x:Name="HeaderSettingsButton" Classes="ConsoleHeaderNav" ToolTip.Tip="Settings">
            <TextBlock Text="Settings" />
          </Button>
        </StackPanel>

        <Border Grid.Column="1" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <Border Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="12" Padding="10,4">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="sports_esports" Classes="ConsoleStatusIcon" FontSize="16" />
                <TextBlock x:Name="ControllerStatusText" Text="Controller" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Border>
            <TextBlock Text="wifi" Classes="ConsoleStatusIcon" />
            <TextBlock Text="battery_full" Classes="ConsoleStatusIcon" />
            <TextBlock x:Name="ClockText" Text="14:54" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Center Content: Vertically Centered along Y Axis -->
      <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="28">

        <!-- Active Game Spotlight Header -->
        <StackPanel Spacing="6" Margin="8,0,0,0">
          
          <!-- Source Badge & Status Subtext (White Badge Background & White Text) -->
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Background="#33FFFFFF" CornerRadius="6" Padding="10,3" VerticalAlignment="Center">
              <TextBlock x:Name="SelectedGameSourceText" Text="STEAM" FontSize="12" FontWeight="Bold" Foreground="White" />
            </Border>
            <TextBlock x:Name="SelectedGameSubtext" Text="Installed • Ready to play" FontSize="14" FontWeight="Medium" Foreground="White" VerticalAlignment="Center" />
          </StackPanel>

          <!-- Prominent Game Title Heading (White Text) -->
          <TextBlock x:Name="SelectedGameTitleText" Text="Game Title" FontSize="42" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left" />

        </StackPanel>

        <!-- Centered Square App Cards Carousel Track -->
        <Grid Height="250" HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <StackPanel
              x:Name="CarouselTrack"
              Orientation="Horizontal"
              Spacing="24"
              VerticalAlignment="Center">

            <!-- Dynamic square game cards populated at runtime -->

          </StackPanel>
        </Grid>

      </StackPanel>

      <!-- Bottom Controller Action Hints Bar -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom" Margin="8,0">
        <StackPanel Orientation="Horizontal" Spacing="32" VerticalAlignment="Center">
          
          <!-- (A) Select / Launch -->
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="26" Height="26" CornerRadius="13" Background="#1C1C1C" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
              <TextBlock Text="A" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Select / Launch" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
          </StackPanel>

          <!-- (X) Game Details -->
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="26" Height="26" CornerRadius="13" Background="#1C1C1C" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
              <TextBlock Text="X" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Game Details" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
          </StackPanel>

          <!-- (Y) Options -->
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="26" Height="26" CornerRadius="13" Background="#1C1C1C" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
              <TextBlock Text="Y" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Options" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
          </StackPanel>

        </StackPanel>

        <!-- Tab Navigation Hint (LB / RB) -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Background="#1C1C1C" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="LB" FontSize="12" FontWeight="Bold" Foreground="White" />
              <TextBlock Text="/" FontSize="12" Foreground="#AAFFFFFF" />
              <TextBlock Text="RB" FontSize="12" FontWeight="Bold" Foreground="White" />
            </StackPanel>
          </Border>
          <TextBlock Text="Switch Tab" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>

    </Grid>

  </Grid>

</UserControl>
