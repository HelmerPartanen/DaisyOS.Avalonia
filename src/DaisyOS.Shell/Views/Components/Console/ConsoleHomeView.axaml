<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Console.ConsoleHomeView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource ConsoleBackgroundBrush}">

  <UserControl.Styles>

    <!-- Square Game Cover Card Button -->
    <Style Selector="Button.GameCoverTile">
      <Setter Property="Width" Value="210" />
      <Setter Property="Height" Value="210" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />

      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Button.GameCoverTile /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#33FFFFFF" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <!-- Active Focused Card: Pure White Focus Border & Glowing Halo -->
    <Style Selector="Button.GameCoverTile:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#FFFFFF" />
      <Setter Property="BorderThickness" Value="3.5" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Button.GameCoverTile:focus">
      <Setter Property="RenderTransform" Value="scale(1.08)" />
      <Setter Property="ZIndex" Value="10" />
    </Style>

    <Style Selector="Button.GameCoverTile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#FFFFFF" />
      <Setter Property="BorderThickness" Value="2.5" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Button.GameCoverTile:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.04)" />
    </Style>

    <Style Selector="Button.GameCoverTile:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.GameCoverTile:pressed">
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <!-- OSTheme Classes for Dynamically Created Tile Elements -->
    <Style Selector="Border.ConsoleCardClipper">
      <Setter Property="Background" Value="{DynamicResource ConsoleElevatedSurfaceBrush}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.ConsoleTitleScrim">
      <Setter Property="Background" Value="{DynamicResource ConsoleSurfaceBrush}" />
    </Style>

    <Style Selector="TextBlock.ConsoleCardTitleText">
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.ConsoleFallbackTitle">
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextPrimaryBrush}" />
    </Style>

    <!-- Top Header Tab Navigation Buttons (Active tab = White Primary Button; Selected/Focused = No BG + White Outline) -->
    <Style Selector="Button.ConsoleHeaderNav">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="20,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Active Header Tab: Primary Button Styling (Solid White Background, Solid Black Text) -->
    <Style Selector="Button.ConsoleHeaderNav.Active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ConsolePrimaryButtonBgBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="BoxShadow" Value="0 2 12 0 #33FFFFFF" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav.Active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ConsolePrimaryButtonFgBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Selected / Focused Header Tab (Not Active): No BG + 2px White Outline -->
    <Style Selector="Button.ConsoleHeaderNav:focus:not(.Active) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#FFFFFF" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="BoxShadow" Value="0 0 16 0 #80FFFFFF" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav:focus:not(.Active) TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Hover Header Tab (Not Active): No BG + 50% White Outline -->
    <Style Selector="Button.ConsoleHeaderNav:pointerover:not(.Active) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#80FFFFFF" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav:pointerover:not(.Active) TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="TextBlock.ConsoleStatusIcon">
      <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextSecondaryBrush}" />
    </Style>

    <Style Selector="Button.ConsolePrimaryBtn">
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="24,0" />
      <Setter Property="Background" Value="{DynamicResource ConsolePrimaryButtonBgBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ConsolePrimaryButtonFgBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedMD}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.ConsolePrimaryBtn /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ConsolePrimaryButtonBgBrush}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource ConsolePrimaryButtonFgBrush}" />
      <Setter Property="BoxShadow" Value="0 4 16 0 #33FFFFFF" />
    </Style>

    <Style Selector="Button.ConsolePrimaryBtn:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ConsolePrimaryButtonHoverBgBrush}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource ConsolePrimaryButtonFgBrush}" />
      <Setter Property="BorderBrush" Value="#FFFFFF" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BoxShadow" Value="0 0 24 0 #E6FFFFFF" />
    </Style>

    <Style Selector="Button.ConsoleActionBtn">
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="20,0" />
      <Setter Property="Background" Value="{DynamicResource ConsoleSecondaryButtonBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ConsoleDividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedMD}" />
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.ConsoleActionBtn:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ConsolePrimaryButtonBgBrush}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource ConsolePrimaryButtonFgBrush}" />
      <Setter Property="BorderBrush" Value="#FFFFFF" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BoxShadow" Value="0 0 24 0 #E6FFFFFF" />
    </Style>

  </UserControl.Styles>

  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <!-- Dual-Layer Fullscreen Background Images (Permanently 0% Opacity) -->
    <Grid x:Name="HeroBackgroundContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.0" IsVisible="False">
      <Image x:Name="HeroBackgroundImage1" Stretch="UniformToFill" Opacity="0.0" />
      <Image x:Name="HeroBackgroundImage2" Stretch="UniformToFill" Opacity="0.0" />
    </Grid>

    <!-- OSTheme Surface Overlay for High Contrast Readability -->
    <Border IsHitTestVisible="False" Background="{DynamicResource ConsoleBackgroundBrush}" />

    <Grid Margin="64,24,64,24" ClipToBounds="False">

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Top System Bar Header -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Top" Margin="0,0,0,16" ZIndex="20">
        
        <!-- Header Navigation Tabs -->
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          
          <Button x:Name="HeaderRecentButton" Classes="ConsoleHeaderNav Active" Click="OnHeaderRecentClicked" ToolTip.Tip="Recents">
            <TextBlock Text="Recents" />
          </Button>

          <Button x:Name="HeaderLibraryButton" Classes="ConsoleHeaderNav" Click="OnHeaderLibraryClicked" ToolTip.Tip="Library">
            <TextBlock Text="Library" />
          </Button>

          <Button x:Name="HeaderSettingsButton" Classes="ConsoleHeaderNav" Click="OnHeaderSettingsClicked" ToolTip.Tip="Settings">
            <TextBlock Text="Settings" />
          </Button>

        </StackPanel>

        <!-- Right System Status Icons -->
        <Border Grid.Column="1" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <Button Click="OnHeaderSettingsClicked" Background="Transparent" BorderThickness="0" Padding="0">
              <Border Background="{DynamicResource ConsoleSubtleSurfaceBrush}" CornerRadius="{DynamicResource RoundedMD}" Padding="10,4">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="sports_esports" Classes="ConsoleStatusIcon" FontSize="16" />
                  <TextBlock x:Name="ControllerStatusText" Text="Controller" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
                </StackPanel>
              </Border>
            </Button>

            <TextBlock Text="wifi" Classes="ConsoleStatusIcon" />
            <TextBlock Text="battery_full" Classes="ConsoleStatusIcon" />
            <TextBlock x:Name="ClockText" Text="20:18" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
          </StackPanel>
        </Border>

      </Grid>

      <!-- Main Content Area: PS5/PS6 Discrete Tab View Containers (Zero Layout Confusion) -->
      <Grid Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ClipToBounds="False">

        <!-- TAB 1: RECENTS TAB CONTENT (Spotlight Header + Hero Carousel Track) -->
        <Grid x:Name="RecentsTabContent" IsVisible="True" VerticalAlignment="Center" HorizontalAlignment="Stretch" ClipToBounds="False">
          <StackPanel Spacing="24" ClipToBounds="False">

            <!-- Active Game Spotlight Header -->
            <StackPanel Spacing="6" Margin="8,0,0,0">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="#33FFFFFF" CornerRadius="{DynamicResource RoundedSM}" Padding="10,3" VerticalAlignment="Center">
                  <TextBlock x:Name="SelectedGameSourceText" Text="STEAM" FontSize="12" FontWeight="Bold" Foreground="White" />
                </Border>
                <TextBlock x:Name="SelectedGameSubtext" Text="Recently Played • Ready to play" FontSize="14" FontWeight="Medium" Foreground="White" VerticalAlignment="Center" />
              </StackPanel>

              <TextBlock x:Name="SelectedGameTitleText" Text="Game Title" FontSize="42" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Carousel Container (290px Height guarantees zero clipping) -->
            <Grid Height="290" Margin="0,10,0,10" HorizontalAlignment="Stretch" VerticalAlignment="Center" ClipToBounds="False">
              <StackPanel
                  x:Name="CarouselTrack"
                  Orientation="Horizontal"
                  Spacing="28"
                  Margin="24,0,0,0"
                  VerticalAlignment="Center"
                  ClipToBounds="False">

                <!-- Dynamic recent game cards populated at runtime -->

              </StackPanel>
            </Grid>

          </StackPanel>
        </Grid>

        <!-- TAB 2: LIBRARY TAB CONTENT (Clean Multi-Row Scrollable Game Grid) -->
        <ScrollViewer x:Name="LibraryTabContent" IsVisible="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" ClipToBounds="False">
          <StackPanel Spacing="20" Margin="8,12,0,40" ClipToBounds="False">
            
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="grid_view" Classes="ConsoleStatusIcon" FontSize="22" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
                <TextBlock Text="Game Library" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" VerticalAlignment="Center" />
              </StackPanel>

              <TextBlock Grid.Column="1" x:Name="LibraryCountText" Text="0 Games" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>

            <!-- Multi-Row Grid of All Installed Games -->
            <WrapPanel x:Name="LibraryGrid" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,10,0,0" ClipToBounds="False">

              <!-- Dynamic all-games library cards populated at runtime -->

            </WrapPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- TAB 3: SETTINGS TAB CONTENT (Direct Launch & Overview) -->
        <Grid x:Name="SettingsTabContent" IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Border Background="{DynamicResource ConsoleElevatedSurfaceBrush}" BorderBrush="{DynamicResource ConsoleDividerBrush}" BorderThickness="1" CornerRadius="{DynamicResource RoundedXL}" Padding="36,32" MaxWidth="560">
            <StackPanel Spacing="20" HorizontalAlignment="Center">
              <TextBlock Text="settings" Classes="ConsoleStatusIcon" FontSize="48" HorizontalAlignment="Center" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
              <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="Console Settings" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Manage Audio devices, Mic mute, Wi-Fi networks, and System preferences." FontSize="14" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
              <Button Click="OnOpenQuickSettingsClicked" Classes="ConsoleActionBtn" HorizontalAlignment="Center" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <TextBlock Text="tune" Classes="ConsoleStatusIcon" FontSize="20" />
                  <TextBlock Text="Open Quick Settings Overlay" FontSize="15" FontWeight="Bold" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </Grid>

      </Grid>

      <!-- Bottom Controller Action Hints Bar using Real PNG Asset Icons -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom" Margin="8,0" ZIndex="20" RenderOptions.BitmapInterpolationMode="HighQuality">
        <StackPanel Orientation="Horizontal" Spacing="28" VerticalAlignment="Center">
          
          <!-- Confirm (A / ✕) Select / Launch -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Image x:Name="ConfirmBtnImage" Width="26" Height="26" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="Select / Launch" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <!-- Quick Settings (X / ▫) -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Image x:Name="SettingsBtnImage" Width="26" Height="26" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="Quick Settings" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" VerticalAlignment="Center" />
          </StackPanel>

        </StackPanel>

        <!-- Tab Navigation Hint (LB / RB or L1 / R1) -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Background="#1C1C24" BorderBrush="{DynamicResource ConsoleDividerBrush}" BorderThickness="1" CornerRadius="{DynamicResource RoundedSM}" Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Image x:Name="TabLeftBtnImage" Width="24" Height="20" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
              <TextBlock Text="/" FontSize="12" Foreground="#AAFFFFFF" VerticalAlignment="Center" />
              <Image x:Name="TabRightBtnImage" Width="24" Height="20" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
              <TextBlock Text="Switch Tab" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" Margin="4,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>

      </Grid>

    </Grid>

  </Grid>

</UserControl>
