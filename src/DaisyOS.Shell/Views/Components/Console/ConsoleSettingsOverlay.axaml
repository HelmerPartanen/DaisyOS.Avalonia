<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Console.ConsoleSettingsOverlay"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
    IsVisible="False"
    IsHitTestVisible="False"
    Opacity="0"
    ZIndex="700"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

  <UserControl.Transitions>
    <Transitions>
      <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
    </Transitions>
  </UserControl.Transitions>

  <UserControl.Styles>

    <Style Selector="TextBlock.SettingsIcon">
      <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="{DynamicResource ContentSecondaryBrush}" />
    </Style>

    <!-- Top Header Navigation Icon Button (Chevron Back) -->
    <Style Selector="Button.ConsoleHeaderNavIcon">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />

      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <Border x:Name="PART_FocusRing"
                    BorderBrush="{DynamicResource ActionPrimaryBrush}"
                    BorderThickness="2"
                    CornerRadius="23"
                    Margin="-5"
                    Opacity="0"
                    ClipToBounds="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>

            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ClipToBounds="True">
              <ContentPresenter.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
              </ContentPresenter.Transitions>
            </ContentPresenter>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.ConsoleHeaderNavIcon:focus /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNavIcon:pointerover /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Sidebar Category Tab Buttons -->
    <Style Selector="Button.SettingsCategoryBtn">
      <Setter Property="Height" Value="46" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="23" />
      <Setter Property="Foreground" Value="{DynamicResource ContentSecondaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ClipToBounds" Value="False" />

      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <Border x:Name="PART_FocusRing"
                    BorderBrush="{DynamicResource ActionPrimaryBrush}"
                    BorderThickness="2"
                    CornerRadius="27"
                    Margin="-4"
                    Opacity="0"
                    ClipToBounds="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>

            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ClipToBounds="True">
              <ContentPresenter.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
              </ContentPresenter.Transitions>
            </ContentPresenter>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.SettingsCategoryBtn.Active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ActionPrimaryBrush}" />
    </Style>

    <Style Selector="Button.SettingsCategoryBtn.Active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ContentOnActionBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.SettingsCategoryBtn:focus /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.SettingsCategoryBtn:pointerover:not(.Active) /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.SettingsCategoryBtn:focus TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
    </Style>

    <Style Selector="Button.SettingsCategoryBtn.Active:focus TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ContentOnActionBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Settings Row Fully Rounded Capsule Button Container with Offset Focus Ring -->
    <Style Selector="Button.ConsoleSettingRow">
      <Setter Property="Height" Value="60" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="30" />
      <Setter Property="Padding" Value="28,0" />
      <Setter Property="Margin" Value="6,6" />
      <Setter Property="MaxWidth" Value="1080" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ClipToBounds" Value="False" />

      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <!-- White Offset Capsule Focus Ring -->
            <Border x:Name="PART_FocusRing"
                    BorderBrush="{DynamicResource ActionPrimaryBrush}"
                    BorderThickness="2"
                    CornerRadius="35"
                    Margin="-5"
                    Opacity="0"
                    ClipToBounds="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>

            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ClipToBounds="True">
              <ContentPresenter.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
              </ContentPresenter.Transitions>
            </ContentPresenter>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.ConsoleSettingRow:focus /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.ConsoleSettingRow:pointerover /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Inner Device Picker Pill -->
    <Style Selector="Border.ConsoleDevicePill">
      <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="24,8" />
      <Setter Property="MinWidth" Value="180" />
    </Style>

    <Style Selector="StackPanel.SettingsTabPanel">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="StackPanel.SettingsTabPanel.ActiveTab">
      <Setter Property="IsHitTestVisible" Value="True" />
      <Setter Property="Opacity" Value="1" />
    </Style>

  </UserControl.Styles>

  <!-- Fullscreen Main Canvas -->
  <Grid Background="{DynamicResource SurfaceCanvasBrush}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        RowDefinitions="Auto,*,Auto">

    <!-- Top Header Row -->
    <Grid Grid.Row="0"
          Margin="32,36,36,24"
          ColumnDefinitions="Auto,*,Auto"
          VerticalAlignment="Center">

      <StackPanel Grid.Column="0"
                  Orientation="Horizontal"
                  Spacing="8"
                  VerticalAlignment="Center">

        <Button x:Name="BackButton"
                Click="OnCloseClicked"
                Classes="ConsoleHeaderNavIcon"
                ToolTip.Tip="Back">
          <TextBlock Text="arrow_back"
                     Classes="SettingsIcon"
                     FontSize="20"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource ContentPrimaryBrush}" />
        </Button>

        <TextBlock Text="Settings"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{DynamicResource ContentPrimaryBrush}"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0" />

      </StackPanel>

      <TextBlock Grid.Column="2"
                 x:Name="ClockText"
                 Text="20:20"
                 FontSize="13"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource ContentSecondaryBrush}"
                 VerticalAlignment="Center" />
    </Grid>

    <!-- Main Section Grid (Full Height Sidebar + Settings Content Area) -->
    <Grid Grid.Row="1"
          ColumnDefinitions="240,*"
          Margin="32,4,36,12"
          VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch"
          ClipToBounds="False">

      <!-- Full Height Categories Sidebar -->
      <Border Grid.Column="0"
              Background="{DynamicResource SurfaceBaseBrush}"
              CornerRadius="32"
              BorderBrush="{DynamicResource StrokeDefaultBrush}"
              BorderThickness="1"
              Padding="12,16"
              VerticalAlignment="Top"
              ClipToBounds="False">

        <StackPanel Spacing="6" ClipToBounds="False">

          <TextBlock Text="CATEGORIES"
                     FontSize="10"
                     FontWeight="Bold"
                     Foreground="{DynamicResource ContentDisabledBrush}"
                     Margin="12,4,0,10"
                     LetterSpacing="1" />

          <Button x:Name="TabAudioBtn"
                  Classes="SettingsCategoryBtn Active"
                  Click="OnTabClicked"
                  Tag="Audio">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="volume_up" Classes="SettingsIcon" FontSize="20" VerticalAlignment="Center" />
              <TextBlock Text="Sound" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button x:Name="TabNetworkBtn"
                  Classes="SettingsCategoryBtn"
                  Click="OnTabClicked"
                  Tag="Network">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="wifi" Classes="SettingsIcon" FontSize="20" VerticalAlignment="Center" />
              <TextBlock Text="Network" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button x:Name="TabBluetoothBtn"
                  Classes="SettingsCategoryBtn"
                  Click="OnTabClicked"
                  Tag="Bluetooth">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="bluetooth" Classes="SettingsIcon" FontSize="20" VerticalAlignment="Center" />
              <TextBlock Text="Bluetooth" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button x:Name="TabDisplayBtn"
                  Classes="SettingsCategoryBtn"
                  Click="OnTabClicked"
                  Tag="Display">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="desktop_windows" Classes="SettingsIcon" FontSize="20" VerticalAlignment="Center" />
              <TextBlock Text="Display" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button x:Name="TabControlsBtn"
                  Classes="SettingsCategoryBtn"
                  Click="OnTabClicked"
                  Tag="Controls">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="sports_esports" Classes="SettingsIcon" FontSize="20" VerticalAlignment="Center" />
              <TextBlock Text="Controller" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button x:Name="TabSystemBtn"
                  Classes="SettingsCategoryBtn"
                  Click="OnTabClicked"
                  Tag="System">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="tune" Classes="SettingsIcon" FontSize="20" VerticalAlignment="Center" />
              <TextBlock Text="System" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

        </StackPanel>
      </Border>

      <!-- Main Content Area (Right Column) -->
      <Grid Grid.Column="1"
            Margin="36,0,0,0"
            RowDefinitions="Auto,*"
            VerticalAlignment="Stretch"
            ClipToBounds="False">

        <TextBlock x:Name="CategoryTitleText"
                   Grid.Row="0"
                   Text="Audio"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="{DynamicResource ContentPrimaryBrush}"
                   Margin="0,0,0,24" />

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden">

          <Panel ClipToBounds="False" Margin="0,0,0,40">

            <Grid ClipToBounds="False">

              <!-- PANEL 1: SOUND / AUDIO -->
              <StackPanel x:Name="AudioPanel"
                          Spacing="8"
                          Classes="SettingsTabPanel"
                          ClipToBounds="False">

                <!-- Row 1: Volume -->
                <Button x:Name="VolumeRowBtn" Classes="ConsoleSettingRow">
                  <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <TextBlock Text="Volume"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ContentPrimaryBrush}"
                               VerticalAlignment="Center" />

                    <controls:ConsolePillSlider Grid.Column="1"
                                                x:Name="MasterVolumePillSlider"
                                                Icon="volume_up"
                                                Value="50"
                                                Width="360"
                                                ValueChanged="OnMasterVolumePillChanged" />
                  </Grid>
                </Button>

                <!-- Row 2: Mic level -->
                <Button x:Name="MicRowBtn" Classes="ConsoleSettingRow">
                  <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <TextBlock Text="Mic level"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ContentPrimaryBrush}"
                               VerticalAlignment="Center" />

                    <controls:ConsolePillSlider Grid.Column="1"
                                                x:Name="MicVolumePillSlider"
                                                Icon="mic"
                                                Value="50"
                                                Width="360"
                                                ValueChanged="OnMicVolumePillChanged" />
                  </Grid>
                </Button>

                <!-- Subtle 1px Divider -->
                <Border Height="1"
                        Background="{DynamicResource StrokeDefaultBrush}"
                        Margin="6,6,6,6"
                        MaxWidth="1080"
                        HorizontalAlignment="Stretch" />

                <!-- Row 3: Output device -->
                <Button x:Name="OutputDeviceRowBtn"
                        Classes="ConsoleSettingRow"
                        Click="OnToggleOutputDeviceClicked">

                  <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">

                    <TextBlock Text="Output device"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ContentPrimaryBrush}"
                               VerticalAlignment="Center" />

                    <Border Grid.Column="1" Classes="ConsoleDevicePill">
                      <TextBlock x:Name="OutputDeviceText"
                                 Text="Default"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource ContentPrimaryBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Border>

                  </Grid>
                </Button>

                <!-- Row 4: Input device -->
                <Button x:Name="InputDeviceRowBtn"
                        Classes="ConsoleSettingRow"
                        Click="OnToggleInputDeviceClicked">

                  <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">

                    <TextBlock Text="Input device"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ContentPrimaryBrush}"
                               VerticalAlignment="Center" />

                    <Border Grid.Column="1" Classes="ConsoleDevicePill">
                      <TextBlock x:Name="InputDeviceText"
                                 Text="Default"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource ContentPrimaryBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Border>

                  </Grid>
                </Button>

              </StackPanel>

              <!-- PANEL 2: NETWORK -->
              <StackPanel x:Name="NetworkPanel"
                          Spacing="8"
                          Classes="SettingsTabPanel"
                          ClipToBounds="False">

                <Button x:Name="WifiRowBtn"
                        Classes="ConsoleSettingRow"
                        Click="OnRefreshWifiClicked">

                  <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">

                    <StackPanel Spacing="4">
                      <TextBlock Text="Wi-Fi Connection"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource ContentPrimaryBrush}" />

                      <TextBlock x:Name="NetworkStatusText"
                                 Text="Checking network status…"
                                 FontSize="13"
                                 Foreground="{DynamicResource ContentSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">

                      <ToggleSwitch x:Name="WifiToggleSwitch"
                                    IsChecked="True"
                                    VerticalAlignment="Center" />

                      <Border Classes="ConsoleDevicePill">
                        <TextBlock Text="Scan Networks"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ContentPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>

                    </StackPanel>

                  </Grid>
                </Button>

                <StackPanel x:Name="WifiListStack" Spacing="8" />

              </StackPanel>

              <!-- PANEL 3: BLUETOOTH -->
              <StackPanel x:Name="BluetoothPanel"
                          Spacing="8"
                          Classes="SettingsTabPanel"
                          ClipToBounds="False">

                <Button x:Name="BluetoothRowBtn"
                        Classes="ConsoleSettingRow"
                        Click="OnRefreshBluetoothClicked">

                  <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">

                    <StackPanel Spacing="4">
                      <TextBlock Text="Bluetooth Connection"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource ContentPrimaryBrush}" />

                      <TextBlock x:Name="BluetoothStatusText"
                                 Text="Checking bluetooth status…"
                                 FontSize="13"
                                 Foreground="{DynamicResource ContentSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">

                      <ToggleSwitch x:Name="BluetoothToggleSwitch"
                                    IsChecked="True"
                                    VerticalAlignment="Center" />

                      <Border Classes="ConsoleDevicePill">
                        <TextBlock Text="Scan Devices"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ContentPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>

                    </StackPanel>

                  </Grid>
                </Button>

                <StackPanel x:Name="BluetoothListStack" Spacing="8" />

              </StackPanel>

              <!-- PANEL 4: DISPLAY -->
              <StackPanel x:Name="DisplayPanel"
                          Spacing="8"
                          Classes="SettingsTabPanel"
                          ClipToBounds="False">

                <Button x:Name="BrightnessRowBtn" Classes="ConsoleSettingRow">

                  <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">

                    <TextBlock Text="Brightness"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ContentPrimaryBrush}"
                               VerticalAlignment="Center" />

                    <controls:ConsolePillSlider Grid.Column="1"
                                                x:Name="BrightnessPillSlider"
                                                Icon="light_mode"
                                                Value="100"
                                                Width="360" />

                  </Grid>
                </Button>

                <Button x:Name="ResolutionRowBtn"
                        Classes="ConsoleSettingRow"
                        Click="OnToggleResolutionClicked">

                  <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">

                    <TextBlock Text="Resolution"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ContentPrimaryBrush}"
                               VerticalAlignment="Center" />

                    <Border Grid.Column="1" Classes="ConsoleDevicePill">
                      <TextBlock x:Name="ResolutionText"
                                 Text="1920x1080"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource ContentPrimaryBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Border>

                  </Grid>
                </Button>

              </StackPanel>

              <!-- PANEL 5: CONTROLLER & KEYBINDINGS -->
              <StackPanel x:Name="ControlsPanel"
                          Spacing="8"
                          Classes="SettingsTabPanel"
                          ClipToBounds="False">

                <Button x:Name="RemapInfoRowBtn" Classes="ConsoleSettingRow">
                  <StackPanel Spacing="6">

                    <TextBlock Text="Controller Button Remapping"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ContentPrimaryBrush}" />

                    <TextBlock Text="Click Remap on any action, then press your controller button to reassign."
                               FontSize="13"
                               Foreground="{DynamicResource ContentSecondaryBrush}" />

                  </StackPanel>
                </Button>

                <StackPanel x:Name="KeybindingsListStack" Spacing="8" />

                <Border Classes="ConsoleSettingRow"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        MaxWidth="1080"
                        Margin="6,6">

                  <StackPanel Spacing="6">

                    <TextBlock Text="LIVE CONTROLLER TEST FEED"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ContentPrimaryBrush}"
                               LetterSpacing="1" />

                    <TextBlock x:Name="LiveTestFeedText"
                               Text="Press any controller button to test input live..."
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource ContentSecondaryBrush}"
                               TextWrapping="Wrap" />

                  </StackPanel>
                </Border>

                <Button x:Name="ResetKeybindingsRowBtn"
                        Classes="ConsoleSettingRow"
                        Click="OnResetKeybindingsClicked">

                  <TextBlock Text="Reset Keybindings to Defaults"
                             FontSize="15"
                             FontWeight="Bold"
                             Foreground="{DynamicResource ContentPrimaryBrush}" />

                </Button>

              </StackPanel>

              <!-- PANEL 6: SYSTEM & POWER -->
              <StackPanel x:Name="SystemPanel"
                          Spacing="8"
                          Classes="SettingsTabPanel"
                          ClipToBounds="False">

                <Button x:Name="PerfOverlayRowBtn"
                        Classes="ConsoleSettingRow"
                        Click="OnPerfOverlayToggled">

                  <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">

                    <StackPanel Spacing="4">

                      <TextBlock Text="Performance Overlay"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource ContentPrimaryBrush}" />

                      <TextBlock Text="Show live FPS, CPU &amp; GPU stats"
                                 FontSize="13"
                                 Foreground="{DynamicResource ContentSecondaryBrush}" />

                    </StackPanel>

                    <ToggleSwitch Grid.Column="1"
                                  x:Name="PerfOverlayToggle"
                                  IsHitTestVisible="False"
                                  VerticalAlignment="Center" />

                  </Grid>
                </Button>

                <Button x:Name="ReturnDesktopRowBtn"
                        Classes="ConsoleSettingRow"
                        Click="OnReturnToDesktopClicked">

                  <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">

                    <StackPanel Spacing="4">

                      <TextBlock Text="Return to Desktop"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource ContentPrimaryBrush}" />

                      <TextBlock Text="Exit console mode to DaisyOS desktop"
                                 FontSize="13"
                                 Foreground="{DynamicResource ContentSecondaryBrush}" />

                    </StackPanel>

                    <Border Grid.Column="1" Classes="ConsoleDevicePill">

                      <TextBlock Text="Exit to Desktop"
                                 FontSize="13"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource ContentPrimaryBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />

                    </Border>

                  </Grid>
                </Button>

                <Button x:Name="RestartRowBtn"
                        Classes="ConsoleSettingRow"
                        Click="OnRestartClicked">

                  <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">

                    <StackPanel Spacing="4">

                      <TextBlock Text="Restart Console"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource ContentPrimaryBrush}" />

                      <TextBlock Text="Reboot DaisyOS operating system"
                                 FontSize="13"
                                 Foreground="{DynamicResource ContentSecondaryBrush}" />

                    </StackPanel>

                    <Border Grid.Column="1" Classes="ConsoleDevicePill">

                      <TextBlock Text="Restart"
                                 FontSize="13"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource ContentPrimaryBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />

                    </Border>

                  </Grid>
                </Button>

                <Button x:Name="ShutdownRowBtn"
                        Classes="ConsoleSettingRow"
                        Click="OnShutdownClicked">

                  <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">

                    <StackPanel Spacing="4">

                      <TextBlock Text="Power Off"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource ContentPrimaryBrush}" />

                      <TextBlock Text="Shut down DaisyOS system completely"
                                 FontSize="13"
                                 Foreground="{DynamicResource ContentSecondaryBrush}" />

                    </StackPanel>

                    <Border Grid.Column="1" Classes="ConsoleDevicePill">

                      <TextBlock Text="Power Off"
                                 FontSize="13"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource ContentPrimaryBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />

                    </Border>

                  </Grid>
                </Button>

              </StackPanel>

            </Grid>

          </Panel>

        </ScrollViewer>

      </Grid>

    </Grid>

    <!-- Bottom Footer Row (Hints Only) -->
    <Border Grid.Row="2"
            Padding="32,8,36,20"
            Background="Transparent"
            VerticalAlignment="Bottom">

      <Grid RenderOptions.BitmapInterpolationMode="HighQuality">

        <StackPanel Orientation="Horizontal"
                    Spacing="24"
                    VerticalAlignment="Center">

          <!-- LB / RB Switch Tab -->
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center">

            <Border Background="{DynamicResource StrokeDefaultBrush}"
                    CornerRadius="6"
                    Padding="6,2">

              <TextBlock Text="LB/RB"
                         FontSize="11"
                         FontWeight="Bold"
                         Foreground="{DynamicResource ContentPrimaryBrush}" />

            </Border>

            <TextBlock Text="Switch Tab"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="{DynamicResource ContentSecondaryBrush}"
                       VerticalAlignment="Center" />

          </StackPanel>

          <!-- D-Pad Navigate -->
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center">

            <Image x:Name="HintDpadImage"
                   Width="18"
                   Height="18"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />

            <TextBlock Text="Navigate"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="{DynamicResource ContentSecondaryBrush}"
                       VerticalAlignment="Center" />

          </StackPanel>

          <!-- Select -->
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center">

            <Image x:Name="HintConfirmImage"
                   Width="18"
                   Height="18"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />

            <TextBlock Text="Select"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="{DynamicResource ContentSecondaryBrush}"
                       VerticalAlignment="Center" />

          </StackPanel>

          <!-- Details -->
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center">

            <Image x:Name="HintDetailsImage"
                   Width="18"
                   Height="18"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />

            <TextBlock Text="Details"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="{DynamicResource ContentSecondaryBrush}"
                       VerticalAlignment="Center" />

          </StackPanel>

          <!-- Back -->
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center">

            <Image x:Name="HintBackImage"
                   Width="18"
                   Height="18"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />

            <TextBlock Text="Back"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="{DynamicResource ContentSecondaryBrush}"
                       VerticalAlignment="Center" />

          </StackPanel>

        </StackPanel>
      </Grid>
    </Border>

  </Grid>

</UserControl>