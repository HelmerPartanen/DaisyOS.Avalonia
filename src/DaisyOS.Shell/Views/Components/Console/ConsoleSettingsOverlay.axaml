<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Console.ConsoleSettingsOverlay"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
    IsVisible="False"
    ZIndex="700">

  <UserControl.Styles>
    <Style Selector="TextBlock.ConsoleSettingsIcon">
      <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.ConsoleSettingsAction">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedMD}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.ConsoleSettingsAction:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.ConsoleSettingsListItem">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedSM}" />
    </Style>
    <Style Selector="Button.ConsoleSettingsListItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource GhostHoverBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <Border Background="#B8090A0F" PointerPressed="OnBackdropPointerPressed" />

    <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="480"
            Padding="24,20" Background="{DynamicResource PrimarySurfaceBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="tune" Classes="ConsoleSettingsIcon" FontSize="26" Foreground="{DynamicResource TextPrimaryBrush}" />
            <StackPanel Spacing="1">
              <TextBlock Text="Quick settings" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="System controls for this session" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </StackPanel>
          <Button x:Name="CloseButton" Grid.Column="1" Classes="ConsoleSettingsAction" Width="44" Padding="0" Click="OnCloseClicked" ToolTip.Tip="Close quick settings">
            <TextBlock Text="close" Classes="ConsoleSettingsIcon" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="18">
            <!-- These are the exact tile and range primitives used by desktop Quick Settings. -->
            <Grid ColumnDefinitions="96,96,96" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12" HorizontalAlignment="Center">
              <controls:QuickSettingTile x:Name="WifiTile" Grid.Row="0" Grid.Column="0" Icon="wifi" Label="Wi-Fi" HasDetails="True"
                                         ToolTipText="Toggle Wi-Fi" DetailsToolTipText="Wi-Fi networks"
                                         Toggled="OnWifiTileToggled" DetailsClicked="OnWifiDetailsClicked" />
              <controls:QuickSettingTile x:Name="BluetoothTile" Grid.Row="0" Grid.Column="1" Icon="bluetooth" Label="Bluetooth"
                                         ToolTipText="Toggle Bluetooth" Toggled="OnBluetoothTileToggled" />
              <controls:QuickSettingTile x:Name="FocusTile" Grid.Row="0" Grid.Column="2" Icon="do_not_disturb_on" Label="Focus"
                                         ToolTipText="Do not disturb" Toggled="OnFocusTileToggled" />
              <controls:QuickSettingTile x:Name="GamingTile" Grid.Row="1" Grid.Column="0" Icon="sports_esports" Label="Gaming"
                                         ToolTipText="Gaming mode" Toggled="OnGamingTileToggled" />
            </Grid>

            <StackPanel Spacing="8">
              <TextBlock Text="Volume" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <Grid ColumnDefinitions="*,44">
                <controls:QuickSettingsSlider x:Name="VolumeSlider" Grid.Column="0" Icon="volume_up" Minimum="0" Maximum="100"
                                              ValueChanged="OnVolumeChanged" TrackBorderBrush="{DynamicResource DividerBrush}" TrackBorderThickness="1" />
                <Button x:Name="OutputDetailsButton" Grid.Column="1" Classes="ConsoleSettingsAction" Padding="0" Margin="8,0,0,0"
                        Click="OnOutputDetailsClicked" ToolTip.Tip="Choose output device">
                  <TextBlock Text="speaker" Classes="ConsoleSettingsIcon" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
              </Grid>
            </StackPanel>

            <Border x:Name="DetailsCard" IsVisible="False" Padding="12" Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="{DynamicResource RoundedLG}">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="DetailsTitle" Text="Details" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <Button Grid.Column="1" Classes="ConsoleSettingsAction" Height="32" Padding="10,0" Click="OnDetailsCloseClicked">
                    <TextBlock Text="Back" FontSize="12" />
                  </Button>
                </Grid>
                <StackPanel x:Name="DetailsHost" Spacing="2" />
              </StackPanel>
            </Border>

            <Border Padding="14" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource RoundedLG}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                  <TextBlock Text="Desktop mode" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="Return to the full DaisyOS desktop." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="DesktopModeButton" Grid.Column="1" Classes="ConsoleSettingsAction" Click="OnReturnToDesktopClicked">
                  <TextBlock Text="Desktop" FontSize="13" FontWeight="SemiBold" />
                </Button>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0" ColumnDefinitions="*,Auto">
          <TextBlock x:Name="ControllerHintText" Text="D-pad  Navigate   A  Select   Y  Details   B  Back" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
          <Button x:Name="DoneButton" Grid.Column="1" Classes="ConsoleSettingsAction" Click="OnCloseClicked">
            <TextBlock x:Name="DoneButtonText" Text="B  Back to console" FontSize="14" FontWeight="SemiBold" />
          </Button>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
