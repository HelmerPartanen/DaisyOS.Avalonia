<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Console.ConsoleSettingsOverlay"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsVisible="False"
    ZIndex="700">

  <UserControl.Styles>

    <Style Selector="TextBlock.SettingsIcon">
      <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.SettingsTabBtn">
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style Selector="Button.SettingsTabBtn > StackPanel > TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.SettingsTabBtn.Active > StackPanel > TextBlock">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.SettingsTabBtn:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style Selector="Button.SettingsTabBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource GhostHoverBrush}" />
    </Style>

    <Style Selector="Border.SettingCard">
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16,14" />
    </Style>

    <Style Selector="Button.ConsoleActionBtn">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.ConsoleActionBtn:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

  </UserControl.Styles>

  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <!-- Dark Backdrop Mask -->
    <Border x:Name="BackdropMask" Background="{DynamicResource PrimarySurfaceBrush}" Opacity="0.75" PointerPressed="OnBackdropPointerPressed" />

    <!-- Right Side Glass Panel -->
    <Border
        HorizontalAlignment="Right"
        VerticalAlignment="Stretch"
        Width="520"
        Background="{DynamicResource SecondarySurfaceBrush}"
        BorderBrush="{DynamicResource DividerBrush}"
        BorderThickness="1,0,0,0">
      
      <Grid RowDefinitions="Auto,*,Auto" Margin="24,20,24,20">

        <!-- Top Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="settings" Classes="SettingsIcon" FontSize="26" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="Console Settings" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <Button Grid.Column="1" Click="OnCloseClicked" Classes="ConsoleActionBtn" Width="40" Height="40" Padding="0">
            <TextBlock Text="close" Classes="SettingsIcon" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </Grid>

        <!-- Subnav Tabs & Content Stack -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">

          <!-- Category Subnav Tabs -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,20">
            <Button x:Name="TabAudioBtn" Classes="SettingsTabBtn Active" Click="OnTabClicked" Tag="Audio">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="volume_up" Classes="SettingsIcon" />
                <TextBlock Text="Audio &amp; Sound" />
              </StackPanel>
            </Button>

            <Button x:Name="TabNetworkBtn" Classes="SettingsTabBtn" Click="OnTabClicked" Tag="Network">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="wifi" Classes="SettingsIcon" />
                <TextBlock Text="Network" />
              </StackPanel>
            </Button>

            <Button x:Name="TabSystemBtn" Classes="SettingsTabBtn" Click="OnTabClicked" Tag="System">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="tune" Classes="SettingsIcon" />
                <TextBlock Text="Quick Actions" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Content Panels Area -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

              <!-- 1. AUDIO & SOUND PANEL -->
              <StackPanel x:Name="AudioPanel" Spacing="16" IsVisible="True">

                <!-- Master Volume Card -->
                <Border Classes="SettingCard">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="volume_up" Classes="SettingsIcon" />
                        <TextBlock Text="Master Output Volume" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" x:Name="VolumeValueText" Text="80%" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <Slider
                        x:Name="MasterVolumeSlider"
                        Minimum="0"
                        Maximum="100"
                        Value="80"
                        ValueChanged="OnMasterVolumeChanged" />
                  </StackPanel>
                </Border>

                <!-- Output Device Card -->
                <Border Classes="SettingCard">
                  <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                      <TextBlock Text="speaker" Classes="SettingsIcon" />
                      <TextBlock Text="Output Audio Device" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>

                    <ComboBox x:Name="OutputDeviceCombo" HorizontalAlignment="Stretch" SelectionChanged="OnOutputDeviceSelected" />
                  </StackPanel>
                </Border>

                <!-- Microphone & Input Card -->
                <Border Classes="SettingCard">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="mic" Classes="SettingsIcon" />
                        <TextBlock Text="Microphone Input" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                      </StackPanel>

                      <Button Grid.Column="1" x:Name="MuteMicBtn" Classes="ConsoleActionBtn" Click="OnMuteMicClicked" Height="36" Padding="12,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <TextBlock x:Name="MuteMicIcon" Text="mic" Classes="SettingsIcon" FontSize="16" />
                          <TextBlock x:Name="MuteMicText" Text="Mute Mic" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                      </Button>
                    </Grid>

                    <ComboBox x:Name="InputDeviceCombo" HorizontalAlignment="Stretch" SelectionChanged="OnInputDeviceSelected" />

                    <!-- Mic Level Slider -->
                    <StackPanel Spacing="6" Margin="0,4,0,0">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Microphone Volume" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" x:Name="MicVolumeText" Text="75%" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                      </Grid>
                      <Slider x:Name="MicVolumeSlider" Minimum="0" Maximum="100" Value="75" ValueChanged="OnMicVolumeChanged" />
                    </StackPanel>

                  </StackPanel>
                </Border>

              </StackPanel>

              <!-- 2. NETWORK PANEL -->
              <StackPanel x:Name="NetworkPanel" Spacing="16" IsVisible="False">

                <!-- Wi-Fi Status & Toggle Card -->
                <Border Classes="SettingCard">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="wifi" Classes="SettingsIcon" />
                        <TextBlock Text="Wi-Fi Wireless Network" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                      </StackPanel>
                      <TextBlock x:Name="NetworkStatusText" Text="Connected to HomeNetwork (192.168.1.105)" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="30,0,0,0" />
                    </StackPanel>

                    <ToggleSwitch Grid.Column="1" x:Name="WifiToggleSwitch" IsChecked="True" IsCheckedChanged="OnWifiToggled" VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <!-- Available Networks Card -->
                <Border Classes="SettingCard">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Available Wi-Fi Networks" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Click="OnRefreshWifiClicked" Classes="ConsoleActionBtn" Height="34" Padding="10,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <TextBlock Text="refresh" Classes="SettingsIcon" FontSize="16" />
                          <TextBlock Text="Scan" FontSize="13" />
                        </StackPanel>
                      </Button>
                    </Grid>

                    <StackPanel x:Name="WifiListStack" Spacing="8">
                      <!-- Populated dynamically at runtime -->
                    </StackPanel>
                  </StackPanel>
                </Border>

              </StackPanel>

              <!-- 3. QUICK ACTIONS & SYSTEM PANEL -->
              <StackPanel x:Name="SystemPanel" Spacing="16" IsVisible="False">

                <!-- Performance & Desktop Options -->
                <Border Classes="SettingCard">
                  <StackPanel Spacing="16">
                    
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Performance Overlay" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Show FPS, CPU, GPU, and RAM usage on screen" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" x:Name="PerfOverlayToggle" IsCheckedChanged="OnPerfOverlayToggled" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{DynamicResource DividerBrush}" Height="1" />

                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Desktop Mode" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Exit Console Mode and return to DaisyOS desktop" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                      </StackPanel>
                      <Button Grid.Column="1" Click="OnReturnToDesktopClicked" Classes="ConsoleActionBtn" Height="40" Padding="14,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <TextBlock Text="desktop_windows" Classes="SettingsIcon" FontSize="18" />
                          <TextBlock Text="Switch to Desktop" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                      </Button>
                    </Grid>

                  </StackPanel>
                </Border>

                <!-- Power Controls Card -->
                <Border Classes="SettingCard">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Power Options" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                    <Grid ColumnDefinitions="*,*">
                      <Button Grid.Column="0" Click="OnRestartClicked" Classes="ConsoleActionBtn" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock Text="restart_alt" Classes="SettingsIcon" FontSize="18" />
                          <TextBlock Text="Restart" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                      </Button>

                      <Button Grid.Column="1" Click="OnShutdownClicked" Classes="ConsoleActionBtn" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock Text="power_settings_new" Classes="SettingsIcon" FontSize="18" />
                          <TextBlock Text="Shutdown" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </StackPanel>
                </Border>

              </StackPanel>

            </StackPanel>
          </ScrollViewer>

        </Grid>

        <!-- Bottom Footer Button -->
        <Border Grid.Row="2" Margin="0,16,0,0">
          <Button Click="OnCloseClicked" Classes="ConsoleActionBtn" HorizontalAlignment="Stretch">
            <TextBlock Text="Done / Back to Game" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </Border>

      </Grid>

    </Border>

  </Grid>

</UserControl>
