<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Console.ConsoleSettingsOverlay"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
    IsVisible="False"
    ZIndex="700"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

  <UserControl.Styles>

    <Style Selector="TextBlock.SettingsIcon">
      <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextSecondaryBrush}" />
    </Style>

    <!-- Top Header Navigation Icon Button (Chevron Back) -->
    <Style Selector="Button.ConsoleHeaderNavIcon">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />

      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <Border x:Name="PART_FocusRing"
                    BorderBrush="{DynamicResource ConsoleAccentBrush}"
                    BorderThickness="2"
                    CornerRadius="23"
                    Margin="-5"
                    IsVisible="False"
                    ClipToBounds="False" />

            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ClipToBounds="True" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.ConsoleHeaderNavIcon:focus /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNavIcon:pointerover /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Sidebar Category Tab Buttons -->
    <Style Selector="Button.SettingsCategoryBtn">
      <Setter Property="Height" Value="46" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextSecondaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ClipToBounds" Value="False" />

      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <Border x:Name="PART_FocusRing"
                    BorderBrush="{DynamicResource ConsoleAccentBrush}"
                    BorderThickness="2"
                    CornerRadius="17"
                    Margin="-4"
                    IsVisible="False"
                    ClipToBounds="False" />

            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ClipToBounds="True" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.SettingsCategoryBtn.Active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ConsolePrimaryButtonBgBrush}" />
    </Style>

    <Style Selector="Button.SettingsCategoryBtn.Active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ConsolePrimaryButtonFgBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.SettingsCategoryBtn:focus /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="Button.SettingsCategoryBtn:pointerover:not(.Active) /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="Button.SettingsCategoryBtn:focus TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.SettingsCategoryBtn.Active:focus TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ConsolePrimaryButtonFgBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Settings Row Fully Rounded Capsule Button Container with Offset Focus Ring -->
    <Style Selector="Button.ConsoleSettingRow">
      <Setter Property="Height" Value="60" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="30" />
      <Setter Property="Padding" Value="28,0" />
      <Setter Property="Margin" Value="6,6" />
      <Setter Property="MaxWidth" Value="1080" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ClipToBounds" Value="False" />

      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <!-- White Offset Capsule Focus Ring -->
            <Border x:Name="PART_FocusRing"
                    BorderBrush="{DynamicResource ConsoleAccentBrush}"
                    BorderThickness="2"
                    CornerRadius="35"
                    Margin="-5"
                    IsVisible="False"
                    ClipToBounds="False" />

            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ClipToBounds="True" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.ConsoleSettingRow:focus /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="Button.ConsoleSettingRow:pointerover /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Inner Device Picker Pill -->
    <Style Selector="Border.ConsoleDevicePill">
      <Setter Property="Background" Value="{DynamicResource ConsoleSubtleSurfaceBrush}" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="24,8" />
      <Setter Property="MinWidth" Value="180" />
    </Style>

  </UserControl.Styles>

  <!-- Fullscreen Main Canvas -->
  <Grid Background="{DynamicResource ConsoleBackgroundBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RowDefinitions="Auto,*,Auto">
    
    <!-- Top Header Row -->
    <Grid Grid.Row="0" Margin="32,24,36,8" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
      <Button Grid.Column="0" Click="OnCloseClicked" Classes="ConsoleHeaderNavIcon" ToolTip.Tip="Back">
        <TextBlock Text="arrow_back" Classes="SettingsIcon" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
      </Button>

      <TextBlock Grid.Column="2" x:Name="ClockText" Text="20:20" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" VerticalAlignment="Center" />
    </Grid>

    <!-- Main Section Grid (Full Height Sidebar + Settings Content Area) -->
    <Grid Grid.Row="1" ColumnDefinitions="240,*" Margin="32,4,36,12" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ClipToBounds="False">
      
      <!-- Full Height Categories Sidebar -->
      <Border Grid.Column="0" Background="{DynamicResource ConsoleSurfaceBrush}" CornerRadius="20" Padding="12,16" VerticalAlignment="Stretch" ClipToBounds="False">
        <StackPanel Spacing="6" ClipToBounds="False">
          <TextBlock Text="CATEGORIES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextMutedBrush}" Margin="12,4,0,10" LetterSpacing="1" />

          <Button x:Name="TabAudioBtn" Classes="SettingsCategoryBtn Active" Click="OnTabClicked" Tag="Audio">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="volume_up" Classes="SettingsIcon" FontSize="20" VerticalAlignment="Center" />
              <TextBlock Text="Sound" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button x:Name="TabNetworkBtn" Classes="SettingsCategoryBtn" Click="OnTabClicked" Tag="Network">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="wifi" Classes="SettingsIcon" FontSize="20" VerticalAlignment="Center" />
              <TextBlock Text="Network" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button x:Name="TabControlsBtn" Classes="SettingsCategoryBtn" Click="OnTabClicked" Tag="Controls">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="sports_esports" Classes="SettingsIcon" FontSize="20" VerticalAlignment="Center" />
              <TextBlock Text="Controller" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button x:Name="TabSystemBtn" Classes="SettingsCategoryBtn" Click="OnTabClicked" Tag="System">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="tune" Classes="SettingsIcon" FontSize="20" VerticalAlignment="Center" />
              <TextBlock Text="System" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Main Content Area (Right Column) -->
      <Grid Grid.Column="1" Margin="36,0,0,0" RowDefinitions="Auto,*" VerticalAlignment="Stretch" ClipToBounds="False">
        
        <!-- Page Title -->
        <TextBlock Grid.Row="0" Text="Settings" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" Margin="10,0,0,16" />

        <!-- Scrollable Settings Content Panels -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,12,20,12" ClipToBounds="False">
          <Grid ClipToBounds="False">

            <!-- PANEL 1: SOUND / AUDIO -->
            <StackPanel x:Name="AudioPanel" Spacing="8" IsVisible="True" ClipToBounds="False">
              
              <!-- Row 1: Volume -->
              <Button x:Name="VolumeRowBtn" Classes="ConsoleSettingRow">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <TextBlock Text="Volume" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" VerticalAlignment="Center" />
                  <controls:ConsolePillSlider Grid.Column="1" x:Name="MasterVolumePillSlider" Icon="volume_up" Value="50" ValueChanged="OnMasterVolumePillChanged" />
                </Grid>
              </Button>

              <!-- Row 2: Mic level -->
              <Button x:Name="MicRowBtn" Classes="ConsoleSettingRow">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <TextBlock Text="Mic level" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" VerticalAlignment="Center" />
                  <controls:ConsolePillSlider Grid.Column="1" x:Name="MicVolumePillSlider" Icon="mic" Value="50" ValueChanged="OnMicVolumePillChanged" />
                </Grid>
              </Button>

              <!-- Subtle 1px Divider -->
              <Border Height="1" Background="{DynamicResource ConsoleDividerBrush}" Margin="6,6,6,6" MaxWidth="1080" HorizontalAlignment="Stretch" />

              <!-- Row 3: Output device -->
              <Button x:Name="OutputDeviceRowBtn" Classes="ConsoleSettingRow" Click="OnToggleOutputDeviceClicked">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <TextBlock Text="Output device" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="ConsoleDevicePill">
                    <TextBlock x:Name="OutputDeviceText" Text="Default" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Button>

              <!-- Row 4: Input device -->
              <Button x:Name="InputDeviceRowBtn" Classes="ConsoleSettingRow" Click="OnToggleInputDeviceClicked">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <TextBlock Text="Input device" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="ConsoleDevicePill">
                    <TextBlock x:Name="InputDeviceText" Text="Default" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Button>

            </StackPanel>

            <!-- PANEL 2: NETWORK -->
            <StackPanel x:Name="NetworkPanel" Spacing="8" IsVisible="False" ClipToBounds="False">
              <Button x:Name="WifiRowBtn" Classes="ConsoleSettingRow" Click="OnRefreshWifiClicked">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Wi-Fi Connection" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
                    <TextBlock x:Name="NetworkStatusText" Text="Checking network status…" FontSize="13" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" />
                  </StackPanel>

                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ToggleSwitch x:Name="WifiToggleSwitch" IsChecked="True" VerticalAlignment="Center" />
                    <Border Classes="ConsoleDevicePill">
                      <TextBlock Text="Scan Networks" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </StackPanel>
                </Grid>
              </Button>

              <StackPanel x:Name="WifiListStack" Spacing="8" />
            </StackPanel>

            <!-- PANEL 3: CONTROLLER & KEYBINDINGS -->
            <StackPanel x:Name="ControlsPanel" Spacing="8" IsVisible="False" ClipToBounds="False">
              <Button x:Name="RemapInfoRowBtn" Classes="ConsoleSettingRow">
                <StackPanel Spacing="6">
                  <TextBlock Text="Controller Button Remapping" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
                  <TextBlock Text="Click Remap on any action, then press your controller button to reassign." FontSize="13" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" />
                </StackPanel>
              </Button>

              <StackPanel x:Name="KeybindingsListStack" Spacing="8" />

              <Border Classes="ConsoleSettingRow" Background="{DynamicResource ConsoleSurfaceBrush}" MaxWidth="1080" Margin="6,6">
                <StackPanel Spacing="6">
                  <TextBlock Text="LIVE CONTROLLER TEST FEED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" LetterSpacing="1" />
                  <TextBlock x:Name="LiveTestFeedText" Text="Press any controller button to test input live..." FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Button x:Name="ResetKeybindingsRowBtn" Classes="ConsoleSettingRow" Click="OnResetKeybindingsClicked">
                <TextBlock Text="Reset Keybindings to Defaults" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
              </Button>
            </StackPanel>

            <!-- PANEL 4: SYSTEM & POWER -->
            <StackPanel x:Name="SystemPanel" Spacing="8" IsVisible="False" ClipToBounds="False">
              
              <Button x:Name="PerfOverlayRowBtn" Classes="ConsoleSettingRow" Click="OnPerfOverlayToggled">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Performance Overlay" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
                    <TextBlock Text="Show live FPS, CPU &amp; GPU stats" FontSize="13" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" x:Name="PerfOverlayToggle" IsHitTestVisible="False" VerticalAlignment="Center" />
                </Grid>
              </Button>

              <Button x:Name="ReturnDesktopRowBtn" Classes="ConsoleSettingRow" Click="OnReturnToDesktopClicked">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Return to Desktop" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
                    <TextBlock Text="Exit console mode to DaisyOS desktop" FontSize="13" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" />
                  </StackPanel>

                  <Border Grid.Column="1" Classes="ConsoleDevicePill">
                    <TextBlock Text="Exit to Desktop" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Button>

              <Button x:Name="RestartRowBtn" Classes="ConsoleSettingRow" Click="OnRestartClicked">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Restart Console" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
                    <TextBlock Text="Reboot DaisyOS operating system" FontSize="13" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" />
                  </StackPanel>

                  <Border Grid.Column="1" Classes="ConsoleDevicePill">
                    <TextBlock Text="Restart" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Button>

              <Button x:Name="ShutdownRowBtn" Classes="ConsoleSettingRow" Click="OnShutdownClicked">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Power Off" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
                    <TextBlock Text="Shut down DaisyOS system completely" FontSize="13" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" />
                  </StackPanel>

                  <Border Grid.Column="1" Classes="ConsoleDevicePill">
                    <TextBlock Text="Power Off" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Button>

            </StackPanel>

          </Grid>
        </ScrollViewer>

      </Grid>

    </Grid>

    <!-- Bottom Footer Row (Hints Only) -->
    <Border Grid.Row="2" Padding="32,8,36,20" Background="Transparent" VerticalAlignment="Bottom">
      <Grid RenderOptions.BitmapInterpolationMode="HighQuality">
        <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
          
          <!-- LB / RB Switch Tab -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Background="{DynamicResource ConsoleDividerBrush}" CornerRadius="6" Padding="6,2">
              <TextBlock Text="LB/RB" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
            </Border>
            <TextBlock Text="Switch Tab" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <!-- D-Pad Navigate -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Image x:Name="HintDpadImage" Width="18" Height="18" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="Navigate" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <!-- Select -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Image x:Name="HintConfirmImage" Width="18" Height="18" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="Select" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <!-- Details -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Image x:Name="HintDetailsImage" Width="18" Height="18" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="Details" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <!-- Back -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Image x:Name="HintBackImage" Width="18" Height="18" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="Back" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" VerticalAlignment="Center" />
          </StackPanel>

        </StackPanel>
      </Grid>
    </Border>

  </Grid>

</UserControl>
