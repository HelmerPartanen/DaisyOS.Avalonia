<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Console.ConsoleMediaWidget"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="48"
    HorizontalAlignment="Left"
    VerticalAlignment="Center">
  <UserControl.Styles>
    <Style Selector="Border.spectrumBar">
      <Setter Property="Background" Value="{DynamicResource ConsoleTextPrimaryBrush}" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    
    <!-- Focusable Console Media Buttons -->
    <Style Selector="Button.ConsoleMediaIconBtn">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />

      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <Border x:Name="PART_FocusRing"
                    BorderBrush="{DynamicResource ConsoleAccentBrush}"
                    BorderThickness="2"
                    CornerRadius="21"
                    Margin="-5"
                    Opacity="0"
                    ClipToBounds="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ClipToBounds="True">
              <ContentPresenter.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
              </ContentPresenter.Transitions>
            </ContentPresenter>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.ConsoleMediaIconBtn:focus /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.ConsoleMediaIconBtn:pointerover /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.ConsoleMediaIconBtn TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextSecondaryBrush}" />
    </Style>

    <Style Selector="Button.ConsoleMediaIconBtn:focus TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Button.ConsoleMediaIconBtn:pointerover TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
  </UserControl.Styles>

  <Border x:Name="MediaFrame"
          Height="48"
          Background="Transparent"
          ClipToBounds="False">
    <Grid Margin="0,0,16,0" ColumnDefinitions="Auto,*,Auto,Auto">
      <!-- Artwork -->
      <Border Width="40" Height="40" CornerRadius="{DynamicResource RoundedMD}" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center">
        <Grid>
          <Image x:Name="Artwork" Stretch="UniformToFill" IsVisible="False" RenderOptions.BitmapInterpolationMode="HighQuality"/>
          <Border x:Name="SourceFallback" Background="{DynamicResource ConsoleSubtleSurfaceBrush}">
            <Grid>
              <Image x:Name="SourceIcon" Width="20" Height="20" IsVisible="False" RenderOptions.BitmapInterpolationMode="HighQuality"/>
              <TextBlock x:Name="SourceGlyph" Text="music_note" FontSize="20"
                         FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                         Foreground="{DynamicResource ConsoleTextSecondaryBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- Track Info -->
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0" MinWidth="100" MaxWidth="240" Margin="0,0,16,0">
        <TextBlock x:Name="MediaTitle" Text="Not playing" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
        <TextBlock x:Name="MediaArtist" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
      </StackPanel>

      <!-- Buttons -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" ClipToBounds="False">
        <Button x:Name="PreviousButton" Classes="ConsoleMediaIconBtn" Focusable="True" Click="OnPreviousClicked" ToolTip.Tip="Previous track">
          <TextBlock x:Name="PreviousGlyph" Text="skip_previous" FontFamily="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" FontSize="18"/>
        </Button>
        <Button x:Name="PlayPauseButton" Classes="ConsoleMediaIconBtn" Focusable="True" Click="OnPlayPauseClicked" ToolTip.Tip="Play">
          <TextBlock x:Name="PlayPauseGlyph" Text="play_arrow" FontFamily="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" FontSize="18"/>
        </Button>
        <Button x:Name="NextButton" Classes="ConsoleMediaIconBtn" Focusable="True" Click="OnNextClicked" ToolTip.Tip="Next track">
          <TextBlock x:Name="NextGlyph" Text="skip_next" FontFamily="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" FontSize="18"/>
        </Button>
      </StackPanel>

      <!-- Spectrum -->
      <Canvas x:Name="SpectrumCanvas" Grid.Column="3" Width="36" Height="24" Margin="12,0,0,0"
              VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
  </Border>
</UserControl>
