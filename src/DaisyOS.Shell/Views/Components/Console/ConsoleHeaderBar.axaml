<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Console.ConsoleHeaderBar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Styles>
    <!-- Top Header Tab Navigation Buttons -->
    <Style Selector="Button.ConsoleHeaderNav">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="22,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />

      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <!-- Outer Offsetted White Outline Ring (5px gap, 25px CornerRadius) -->
            <Border x:Name="PART_FocusRing"
                    BorderBrush="#FFFFFF"
                    BorderThickness="2"
                    CornerRadius="25"
                    Margin="-5"
                    IsVisible="False"
                    ClipToBounds="False" />

            <!-- Main Inner Pill ContentPresenter -->
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ClipToBounds="True" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.ConsoleHeaderNav TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- State 1: Active Tab -> Solid White Pill, Solid Black Text, NO GLOW -->
    <Style Selector="Button.ConsoleHeaderNav.Active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ConsolePrimaryButtonBgBrush}" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav.Active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ConsolePrimaryButtonFgBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- State 2: Focused State -> Show Outer Offsetted White Ring -->
    <Style Selector="Button.ConsoleHeaderNav:focus /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav:focus TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Ensure Active Focused Text stays solid black on the white pill -->
    <Style Selector="Button.ConsoleHeaderNav.Active:focus TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ConsolePrimaryButtonFgBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- State 3: Hover State -> Show Outer Offsetted White Ring -->
    <Style Selector="Button.ConsoleHeaderNav:pointerover:not(.Active) /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav:pointerover:not(.Active) TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNavIcon">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />

      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <Border x:Name="PART_FocusRing"
                    BorderBrush="#FFFFFF"
                    BorderThickness="2"
                    CornerRadius="23"
                    Margin="-5"
                    IsVisible="False"
                    ClipToBounds="False" />

            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ClipToBounds="True" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.ConsoleHeaderNavIcon:focus /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNavIcon:pointerover /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNavIcon TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextSecondaryBrush}" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNavIcon:focus TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNavIcon:pointerover TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="TextBlock.ConsoleStatusIcon">
      <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextSecondaryBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- Top System Bar Header -->
  <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Top" Margin="0,0,0,16" ZIndex="20" ClipToBounds="False">
    
    <!-- Header Navigation Tabs -->
    <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center" Margin="8,8" ClipToBounds="False">
      
      <Button x:Name="HeaderRecentButton" Classes="ConsoleHeaderNav Active" Click="OnHeaderRecentClicked" ToolTip.Tip="Recents">
        <TextBlock Text="Recents" />
      </Button>

      <Button x:Name="HeaderLibraryButton" Classes="ConsoleHeaderNav" Click="OnHeaderLibraryClicked" ToolTip.Tip="Library">
        <TextBlock Text="Library" />
      </Button>

    </StackPanel>

    <!-- Right System Status Icons & Settings Gear -->
    <Border Grid.Column="1" VerticalAlignment="Center" Margin="8,8" ClipToBounds="False">
      <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center" Margin="0,0,8,0" ClipToBounds="False">
        <TextBlock Text="wifi" Classes="ConsoleStatusIcon" VerticalAlignment="Center" />
        <TextBlock Text="battery_full" Classes="ConsoleStatusIcon" VerticalAlignment="Center" />
        <TextBlock x:Name="ClockText" Text="20:18" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" VerticalAlignment="Center" />

        <!-- Settings Gear Icon Button -->
        <Button x:Name="HeaderSettingsIconButton" Classes="ConsoleHeaderNavIcon" Click="OnSettingsButtonClicked" ToolTip.Tip="Settings">
          <TextBlock Text="settings" Classes="ConsoleStatusIcon" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Button>
      </StackPanel>
    </Border>

  </Grid>

</UserControl>
