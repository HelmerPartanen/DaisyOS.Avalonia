<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Console.ConsoleQuickMenuOverlay"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
    IsVisible="False"
    IsHitTestVisible="False"
    Opacity="0"
    ZIndex="800"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

  <UserControl.Transitions>
    <Transitions>
      <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
    </Transitions>
  </UserControl.Transitions>

  <UserControl.Styles>

    <Style Selector="TextBlock.QuickIcon">
      <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextSecondaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Round Quick Bar Icon Button with White Focus Ring -->
    <Style Selector="Button.QuickBarIconBtn">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource ConsoleSubtleSurfaceBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />

      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <Border x:Name="PART_FocusRing"
                    BorderBrush="{DynamicResource ConsoleAccentBrush}"
                    BorderThickness="2.5"
                    CornerRadius="29"
                    Margin="-5"
                    Opacity="0"
                    ClipToBounds="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>

            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ClipToBounds="True" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.QuickBarIconBtn.Active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ConsolePrimaryButtonBgBrush}" />
    </Style>

    <Style Selector="Button.QuickBarIconBtn.Active TextBlock.QuickIcon">
      <Setter Property="Foreground" Value="{DynamicResource ConsolePrimaryButtonFgBrush}" />
    </Style>

    <Style Selector="Button.QuickBarIconBtn:focus /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.QuickBarIconBtn:pointerover /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Non-focusable Setting Row Container -->
    <Style Selector="Border.ConsoleRowContainer">
      <Setter Property="Height" Value="64" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="28,0" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="MaxWidth" Value="960" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Interactive Action Pill Button inside Row with Focus Ring -->
    <Style Selector="Button.ConsoleActionButton">
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="24,0" />
      <Setter Property="Background" Value="{DynamicResource ConsoleSubtleSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="21" />
      <Setter Property="MinWidth" Value="140" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ClipToBounds" Value="False" />

      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <!-- White Offset Capsule Focus Ring Around Button Only -->
            <Border x:Name="PART_FocusRing"
                    BorderBrush="{DynamicResource ConsoleAccentBrush}"
                    BorderThickness="2.5"
                    CornerRadius="26"
                    Margin="-5"
                    Opacity="0"
                    ClipToBounds="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>

            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ClipToBounds="True" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.ConsoleActionButton:focus /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.ConsoleActionButton:pointerover /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Border.ConsoleDevicePill">
      <Setter Property="Background" Value="{DynamicResource ConsoleSubtleSurfaceBrush}" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="22,8" />
      <Setter Property="MinWidth" Value="150" />
    </Style>

  </UserControl.Styles>

  <!-- Full-Screen Dark Overlay Canvas -->
  <Grid Background="{DynamicResource ConsoleOverlayBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <!-- MAIN CONTENT AREA (Spacious Overlay Area with Action Buttons Outlined On Focus) -->
    <Grid x:Name="QuickCardBorder"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Margin="48,80,48,150">
      
      <!-- 1. HOME PANEL -->
      <StackPanel x:Name="CardHomePanel" Spacing="4" IsVisible="True" HorizontalAlignment="Stretch" MaxWidth="960" VerticalAlignment="Center">
        <Border Classes="ConsoleRowContainer">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Return to Home Dashboard" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
              <TextBlock Text="Exit quick overlay and return to main console launcher" FontSize="13" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="BtnGoHome" Classes="ConsoleActionButton" Click="OnGoHomeClicked">
              <TextBlock Text="Go Home" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </Grid>
        </Border>

        <Border Height="1" Background="{DynamicResource ConsoleDividerBrush}" Margin="0,2" HorizontalAlignment="Stretch" />

        <Border Classes="ConsoleRowContainer">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Exit to DaisyOS Desktop" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
              <TextBlock Text="Leave console mode and return to standard desktop session" FontSize="13" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="BtnExitDesktop" Classes="ConsoleActionButton" Click="OnQuickReturnDesktopClicked">
              <TextBlock Text="Exit Desktop" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </Grid>
        </Border>
      </StackPanel>

      <!-- 2. SWITCHER PANEL -->
      <StackPanel x:Name="CardSwitcherPanel" Spacing="12" IsVisible="False" HorizontalAlignment="Stretch" MaxWidth="960" VerticalAlignment="Center">
        <Border Classes="ConsoleRowContainer">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Recent Games &amp; Applications" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
              <TextBlock Text="Quickly switch to running or recent titles" FontSize="13" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" />
            </StackPanel>
            <StackPanel x:Name="RecentGamesStack" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </StackPanel>

      <!-- 3. NOTIFICATIONS PANEL -->
      <StackPanel x:Name="CardNotificationsPanel" Spacing="12" IsVisible="False" HorizontalAlignment="Stretch" MaxWidth="960" VerticalAlignment="Center">
        <Border Classes="ConsoleRowContainer">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock x:Name="SystemStatusTitle" Text="DaisyOS System Status" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
              <TextBlock x:Name="SystemStatusDescription" Text="Controller connected • High Performance Mode Active" FontSize="13" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Classes="ConsoleDevicePill">
              <TextBlock x:Name="SystemStatusPillText" Text="System Active" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Border>
      </StackPanel>

      <!-- 4. SOUND & MIC PANEL -->
      <StackPanel x:Name="CardSoundPanel" Spacing="4" IsVisible="False" HorizontalAlignment="Stretch" MaxWidth="960" VerticalAlignment="Center">
        <Border Classes="ConsoleRowContainer">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <TextBlock Text="Master Volume" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" VerticalAlignment="Center" />
            <controls:ConsolePillSlider Grid.Column="1" x:Name="QuickMasterVolumeSlider" Icon="volume_up" Value="50" ValueChanged="OnQuickMasterVolumeChanged" />
          </Grid>
        </Border>

        <Border Height="1" Background="{DynamicResource ConsoleDividerBrush}" Margin="0,2" HorizontalAlignment="Stretch" />

        <Border Classes="ConsoleRowContainer">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <TextBlock Text="Microphone Level" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" VerticalAlignment="Center" />
            <controls:ConsolePillSlider Grid.Column="1" x:Name="QuickMicVolumeSlider" Icon="mic" Value="50" ValueChanged="OnQuickMicVolumeChanged" />
          </Grid>
        </Border>

        <Border Height="1" Background="{DynamicResource ConsoleDividerBrush}" Margin="0,2" HorizontalAlignment="Stretch" />

        <Border Classes="ConsoleRowContainer">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Microphone Mute" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
              <TextBlock Text="Toggle microphone audio input" FontSize="13" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="QuickMuteMicBtn" Classes="ConsoleActionButton" Click="OnQuickToggleMicMute">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="QuickMuteMicIcon" Text="mic" Classes="QuickIcon" FontSize="18" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="QuickMuteMicText" Text="Mute Mic" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
      </StackPanel>

      <!-- 6. CONTROLLER / ACCESSORIES PANEL -->
      <StackPanel x:Name="CardControllerPanel" Spacing="12" IsVisible="False" HorizontalAlignment="Stretch" MaxWidth="960" VerticalAlignment="Center">
        <Border Classes="ConsoleRowContainer">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
              <TextBlock Text="sports_esports" Classes="QuickIcon" FontSize="26" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" VerticalAlignment="Center" />
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="QuickControllerStatusText" Text="DualSense Wireless Controller" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
                <TextBlock x:Name="QuickControllerBatteryText" Text="Battery: 100% (Charging)" FontSize="13" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" />
              </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Classes="ConsoleDevicePill">
              <TextBlock Text="Connected" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Border>
      </StackPanel>

      <!-- 7. POWER PANEL -->
      <StackPanel x:Name="CardPowerPanel" Spacing="4" IsVisible="False" HorizontalAlignment="Stretch" MaxWidth="960" VerticalAlignment="Center">
        <Border Classes="ConsoleRowContainer">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Restart System" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
              <TextBlock Text="Reboot DaisyOS completely" FontSize="13" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="BtnPowerRestart" Classes="ConsoleActionButton" Click="OnQuickRestartClicked">
              <TextBlock Text="Restart" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </Grid>
        </Border>

        <Border Height="1" Background="{DynamicResource ConsoleDividerBrush}" Margin="0,2" HorizontalAlignment="Stretch" />

        <Border Classes="ConsoleRowContainer">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Exit to Desktop" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
              <TextBlock Text="Switch back to DaisyOS Desktop mode" FontSize="13" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="BtnPowerDesktop" Classes="ConsoleActionButton" Click="OnQuickReturnDesktopClicked">
              <TextBlock Text="Exit Desktop" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </Grid>
        </Border>

        <Border Height="1" Background="{DynamicResource ConsoleDividerBrush}" Margin="0,2" HorizontalAlignment="Stretch" />

        <Border Classes="ConsoleRowContainer">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Power Off" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
              <TextBlock Text="Turn off system power completely" FontSize="13" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="BtnPowerShutdown" Classes="ConsoleActionButton" Click="OnQuickShutdownClicked">
              <TextBlock Text="Power Off" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </Grid>
        </Border>
      </StackPanel>

    </Grid>

    <!-- FOCUSED CATEGORY TITLE LABEL FLOATING ABOVE ICON BAR -->
    <TextBlock x:Name="QuickBarCategoryTitle"
               Text="Home"
               FontSize="13"
               FontWeight="SemiBold"
               Foreground="{DynamicResource ConsoleTextSecondaryBrush}"
               HorizontalAlignment="Center"
               VerticalAlignment="Bottom"
               Margin="0,0,0,118">
      <TextBlock.RenderTransform>
        <TranslateTransform X="-186" />
      </TextBlock.RenderTransform>
    </TextBlock>

    <!-- PS5-STYLE BOTTOM HORIZONTAL ICON BAR -->
    <Border HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,38"
            Background="{DynamicResource ConsoleSurfaceBrush}"
            CornerRadius="100"
            Padding="14,10"
            ClipToBounds="False">
      <StackPanel x:Name="IconBarStack" Orientation="Horizontal" Spacing="14" ClipToBounds="False">
        
        <!-- 0. Home -->
        <Button x:Name="BtnQuickHome" Classes="QuickBarIconBtn Active" Click="OnIconBarItemClicked" Tag="Home" ToolTip.Tip="Home">
          <TextBlock Text="home" Classes="QuickIcon" />
        </Button>

        <!-- 1. Switcher -->
        <Button x:Name="BtnQuickSwitcher" Classes="QuickBarIconBtn" Click="OnIconBarItemClicked" Tag="Switcher" ToolTip.Tip="Switcher">
          <TextBlock Text="view_carousel" Classes="QuickIcon" />
        </Button>

        <!-- 2. Notifications -->
        <Button x:Name="BtnQuickNotifications" Classes="QuickBarIconBtn" Click="OnIconBarItemClicked" Tag="Notifications" ToolTip.Tip="Notifications">
          <TextBlock Text="notifications" Classes="QuickIcon" />
        </Button>

        <!-- 3. Sound -->
        <Button x:Name="BtnQuickSound" Classes="QuickBarIconBtn" Click="OnIconBarItemClicked" Tag="Sound" ToolTip.Tip="Sound">
          <TextBlock Text="volume_up" Classes="QuickIcon" />
        </Button>



        <!-- 5. Controller -->
        <Button x:Name="BtnQuickController" Classes="QuickBarIconBtn" Click="OnIconBarItemClicked" Tag="Controller" ToolTip.Tip="Accessories">
          <TextBlock Text="sports_esports" Classes="QuickIcon" />
        </Button>

        <!-- 6. Power -->
        <Button x:Name="BtnQuickPower" Classes="QuickBarIconBtn" Click="OnIconBarItemClicked" Tag="Power" ToolTip.Tip="Power">
          <TextBlock Text="power_settings_new" Classes="QuickIcon" />
        </Button>

      </StackPanel>
    </Border>

    <!-- BOTTOM CONTROLLER HINTS WITH PLAYSTATION / XBOX ASSETS -->
    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="24" RenderOptions.BitmapInterpolationMode="HighQuality">
        
        <!-- Change Category / Navigate -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Image x:Name="HintCategoryDpadImage" Width="18" Height="18" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="False" />
          <Image x:Name="HintTabLeftImage" Width="24" Height="18" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock x:Name="HintSlashText" Text="/" FontSize="12" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" VerticalAlignment="Center" />
          <Image x:Name="HintTabRightImage" Width="24" Height="18" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock x:Name="HintNavText" Text="Change Category" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Image x:Name="HintConfirmImage" Width="18" Height="18" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock x:Name="HintConfirmText" Text="Open Section" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Image x:Name="HintBackImage" Width="18" Height="18" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock x:Name="HintBackText" Text="Close" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>

      </StackPanel>
    </Border>

  </Grid>

</UserControl>