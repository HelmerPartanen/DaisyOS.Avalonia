<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Console.ConsoleQuickMenuOverlay"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
    xmlns:local="clr-namespace:DaisyOS.Shell.Views.Components.Console"
    IsVisible="False"
    IsHitTestVisible="False"
    Opacity="0"
    ZIndex="800"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

  <UserControl.Transitions>
    <Transitions>
      <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
    </Transitions>
  </UserControl.Transitions>

  <UserControl.Styles>

    <Style Selector="TextBlock.QuickIcon">
      <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextSecondaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.StatusIcon">
      <Setter Property="FontFamily" Value="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextPrimaryBrush}" />
    </Style>

    <!-- Side Panel Pill Button Style -->
    <Style Selector="Button.SidePanelActionBtn">
      <Setter Property="Height" Value="60" />
      <Setter Property="Background" Value="{DynamicResource ConsoleSubtleSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ConsoleTextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <Border x:Name="PART_FocusRing"
                    BorderBrush="{DynamicResource ConsoleAccentBrush}"
                    BorderThickness="2.5"
                    CornerRadius="19"
                    Margin="-3"
                    Opacity="0"
                    ClipToBounds="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ClipToBounds="True" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.SidePanelActionBtn:focus /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.SidePanelActionBtn:pointerover /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Recent Game Horizontal Button Style -->
    <Style Selector="Button.RecentGameBtn">
      <Setter Property="Width" Value="112" />
      <Setter Property="Height" Value="64" />
      <Setter Property="Background" Value="{DynamicResource ConsoleSubtleSurfaceBrush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <Border x:Name="PART_FocusRing"
                    BorderBrush="{DynamicResource ConsoleAccentBrush}"
                    BorderThickness="2.5"
                    CornerRadius="15"
                    Margin="-3"
                    Opacity="0"
                    ClipToBounds="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ClipToBounds="True" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.RecentGameBtn:focus /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.RecentGameBtn:pointerover /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid Background="{DynamicResource ConsoleOverlayBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <!-- Unified Left-Side Panel -->
    <Border Width="440" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Stretch" 
            Margin="16,16,0,16" 
            Background="{DynamicResource ConsoleSurfaceBrush}" 
            CornerRadius="24"
            ClipToBounds="True">
      
      <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        
        <!-- HEADER (Clock, Battery, Wifi) -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,24">
          <!-- Profile/User Placeholder (Optional) -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource ConsoleAccentBrush}">
              <TextBlock Text="person" FontFamily="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded Filled" FontSize="24" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="DaisyOS" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
              <TextBlock x:Name="SystemStatusDescription" Text="System Active" FontSize="12" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" />
            </StackPanel>
          </StackPanel>
          
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="wifi" Classes="StatusIcon" />
            <TextBlock Text="battery_full" Classes="StatusIcon" />
            <TextBlock x:Name="ClockText" Text="00:00" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ConsoleTextPrimaryBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>

        <!-- SCROLLABLE CONTENT DASHBOARD -->
        <ScrollViewer x:Name="PanelScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
          <StackPanel Spacing="24" Margin="0,0,0,32">
            
            <!-- 1. QUICK ACTIONS GRID -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,0,0,0">
              <!-- Go Home -->
              <Button Grid.Row="0" Grid.Column="0" x:Name="BtnGoHome" Classes="SidePanelActionBtn" Margin="0,0,6,6" Click="OnGoHomeClicked">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="home" Classes="QuickIcon" Foreground="{DynamicResource ConsoleTextPrimaryBrush}"/>
                  <TextBlock Text="Go Home" FontSize="15" FontWeight="Bold" />
                </StackPanel>
              </Button>
              
              <!-- Exit Desktop -->
              <Button Grid.Row="0" Grid.Column="1" x:Name="BtnExitDesktop" Classes="SidePanelActionBtn" Margin="6,0,0,6" Click="OnQuickReturnDesktopClicked">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="desktop_windows" Classes="QuickIcon" Foreground="{DynamicResource ConsoleTextPrimaryBrush}"/>
                  <TextBlock Text="Desktop" FontSize="15" FontWeight="Bold" />
                </StackPanel>
              </Button>
              
              <!-- Restart -->
              <Button Grid.Row="1" Grid.Column="0" x:Name="BtnRestart" Classes="SidePanelActionBtn" Margin="0,6,6,0" Click="OnQuickRestartClicked">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="restart_alt" Classes="QuickIcon" Foreground="{DynamicResource ConsoleTextPrimaryBrush}"/>
                  <TextBlock Text="Restart" FontSize="15" FontWeight="Bold" />
                </StackPanel>
              </Button>
              
              <!-- Power Off -->
              <Button Grid.Row="1" Grid.Column="1" x:Name="BtnPowerOff" Classes="SidePanelActionBtn" Margin="6,6,0,0" Click="OnQuickShutdownClicked">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="power_settings_new" Classes="QuickIcon" Foreground="{DynamicResource ConsoleTextPrimaryBrush}"/>
                  <TextBlock Text="Power Off" FontSize="15" FontWeight="Bold" />
                </StackPanel>
              </Button>
            </Grid>

            <!-- 2. SLIDERS (VOLUME & MIC) -->
            <StackPanel Spacing="12">
              <TextBlock Text="Volume &amp; Audio" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" Margin="4,0,0,0"/>
              <Border Background="{DynamicResource ConsoleSubtleSurfaceBrush}" CornerRadius="16" Padding="16,20">
                <StackPanel Spacing="24">
                  <controls:ConsolePillSlider x:Name="QuickMasterVolumeSlider" Icon="volume_up" Value="50" ValueChanged="OnQuickMasterVolumeChanged" />
                  <controls:ConsolePillSlider x:Name="QuickMicVolumeSlider" Icon="mic" Value="50" ValueChanged="OnQuickMicVolumeChanged" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- 3. MEDIA WIDGET -->
            <StackPanel Spacing="12">
              <TextBlock Text="Now Playing" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" Margin="4,0,0,0"/>
              <local:ConsoleMediaWidget x:Name="PanelMediaWidget" HorizontalAlignment="Stretch" />
            </StackPanel>

            <!-- 4. RECENT GAMES -->
            <StackPanel Spacing="12">
              <TextBlock Text="Recent Titles" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" Margin="4,0,0,0"/>
              <!-- ScrollViewer for games -->
              <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="RecentGamesStack" Orientation="Horizontal" Spacing="12" ClipToBounds="False" Margin="4">
                  <!-- Games populated via code-behind -->
                </StackPanel>
              </ScrollViewer>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- FOOTER: CONTROLLER HINTS -->
        <Border Grid.Row="2" Padding="0,16,0,0" BorderBrush="{DynamicResource ConsoleDividerBrush}" BorderThickness="0,1,0,0">
          <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image x:Name="HintCategoryDpadImage" Width="18" Height="18" VerticalAlignment="Center" />
              <TextBlock Text="Navigate" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image x:Name="HintConfirmImage" Width="18" Height="18" VerticalAlignment="Center" />
              <TextBlock Text="Select" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image x:Name="HintBackImage" Width="18" Height="18" VerticalAlignment="Center" />
              <TextBlock Text="Close" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ConsoleTextSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

      </Grid>
    </Border>
  </Grid>

</UserControl>