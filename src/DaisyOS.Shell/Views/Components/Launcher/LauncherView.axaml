<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
             xmlns:vm="clr-namespace:DaisyOS.Shell.ViewModels"
             x:Class="DaisyOS.Shell.Views.Components.Launcher.LauncherView"
             x:DataType="vm:LauncherViewModel"
             Width="600" Height="500">

  <Border Background="{DynamicResource SurfaceBaseBrush}"
          BorderBrush="{DynamicResource StrokeSubtleBrush}"
          BorderThickness="2"
          CornerRadius="{DynamicResource RoundedXL}"
          ClipToBounds="True">
    <Grid RowDefinitions="Auto,*">
      <Grid.Styles>
        <Style Selector="Button.LauncherUtility">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="CornerRadius" Value="{DynamicResource RoundedMD}"/>
          <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="Button.LauncherUtility:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource StateHoverBrush}"/>
        </Style>

        <Style Selector="Button.LauncherLibraryItem">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="CornerRadius" Value="{DynamicResource RoundedMD}"/>
          <Setter Property="HorizontalAlignment" Value="Stretch"/>
          <Setter Property="Padding" Value="10"/>
          <Setter Property="Margin" Value="0,0,0,4"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.LauncherLibraryItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource StateHoverBrush}"/>
        </Style>
        <Style Selector="Button.LauncherLibraryItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource StatePressedBrush}"/>
        </Style>
      </Grid.Styles>

      <Border Grid.Row="0" Padding="22,12" BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <controls:SearchBar x:Name="LauncherSearchBar"
                                Height="40"
                                CornerRadius="{DynamicResource RoundedSM}"
                                Text="{Binding SearchText, Mode=TwoWay}"
                                PlaceholderText="Search apps" />
            <Button Grid.Column="1" Classes="LauncherUtility" Width="40" Height="40" Padding="0" ToolTip.Tip="Power">
              <TextBlock Text="power_settings_new"
                         FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                         FontSize="20" Foreground="{DynamicResource ContentPrimaryBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Sleep" Click="OnSuspendClicked"/>
                  <MenuItem Header="Restart" Click="OnRestartClicked"/>
                  <MenuItem Header="Shut down" Click="OnShutdownClicked"/>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="18,16,18,18">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
          <ItemsControl ItemsSource="{Binding FilteredApps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LauncherItemViewModel">
                <Button Classes="LauncherLibraryItem" Click="OnAppItemClick" ToolTip.Tip="{Binding Description}">
                  <Grid ColumnDefinitions="34,*" ColumnSpacing="10">
                    <Panel Width="34" Height="34" VerticalAlignment="Center">
                      <Image Source="{Binding IconBitmap}" IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"
                             RenderOptions.BitmapInterpolationMode="HighQuality" Width="34" Height="34"/>
                      <Border IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNull}}"
                              Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{DynamicResource RoundedMD}" Width="34" Height="34">
                        <TextBlock Text="{Binding Name[0]}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                    </Panel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource ContentSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <StackPanel IsVisible="{Binding ShowNoResults}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="search_off" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                     FontSize="28" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="No apps found" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
