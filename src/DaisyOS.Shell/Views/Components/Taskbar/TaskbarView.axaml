<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Taskbar.TaskbarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Center"
    VerticalAlignment="Bottom"
    Margin="0,0,0,8">

  <UserControl.Styles>
    <Style Selector="Button.TaskbarApp">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.TaskbarApp:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TaskbarHoverBrush}"/>
    </Style>
    <Style Selector="Button.TaskbarApp:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TaskbarPressedBrush}"/>
    </Style>

    <!-- Reorderable app icon. Positioned absolutely inside AppIconsCanvas via Canvas.Left,
         which is animated in code-behind so items glide into their new slot. -->
    <Style Selector="Button.TaskbarAppIcon">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.TaskbarAppIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TaskbarHoverBrush}"/>
    </Style>
    <Style Selector="Button.TaskbarAppIcon:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TaskbarPressedBrush}"/>
    </Style>
    <Style Selector="Button.TaskbarAppIcon.dragging /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TaskbarPressedBrush}"/>
    </Style>
  </UserControl.Styles>

  <!-- Floating Island Container with Animated Width Smooth Morphing -->
  <Border x:Name="MainBorder"
          Height="48" 
          Padding="4"
          Background="{DynamicResource TaskbarBackgroundBrush}" 
          BorderBrush="{DynamicResource TaskbarBorderBrush}" 
          BorderThickness="1"
          CornerRadius="14"
          ClipToBounds="True"
          BoxShadow="0 8 32 0 #60000000">
    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.35" Easing="CubicEaseOut"/>
      </Transitions>
    </Border.Transitions>

    <Grid>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">

        <!-- Start Button -->
        <Button x:Name="StartButton" Classes="TaskbarApp" ToolTip.Tip="Start Menu">
          <Grid Width="20" Height="20" ColumnDefinitions="*,*" RowDefinitions="*,*">
            <Border Grid.Row="0" Grid.Column="0" Background="White" Margin="0,0,1,1" CornerRadius="1" />
            <Border Grid.Row="0" Grid.Column="1" Background="White" Margin="1,0,0,1" CornerRadius="1" />
            <Border Grid.Row="1" Grid.Column="0" Background="White" Margin="0,1,1,0" CornerRadius="1" />
            <Border Grid.Row="1" Grid.Column="1" Background="White" Margin="1,1,0,0" CornerRadius="1" />
          </Grid>
        </Button>

        <!-- Reorderable App Icons Canvas -->
        <Canvas x:Name="AppIconsCanvas" Height="40">
          <Button Classes="TaskbarAppIcon" Tag="settings" ToolTip.Tip="Settings">
            <Image Source="avares://DaisyOS.Shell/Assets/AppIcons/SettingsIcon.png"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   Width="24" Height="24" IsHitTestVisible="False"/>
          </Button>

          <Button Classes="TaskbarAppIcon" Tag="files" ToolTip.Tip="Files">
            <Image Source="avares://DaisyOS.Shell/Assets/AppIcons/FilesIcon.png"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   Width="24" Height="24" IsHitTestVisible="False"/>
          </Button>
        </Canvas>

      </StackPanel>
    </Grid>
  </Border>
</UserControl>