<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Taskbar.TaskbarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
    HorizontalAlignment="Center"
    VerticalAlignment="Bottom"
    Margin="0,0,0,4">

  <UserControl.Styles>
    <Style Selector="Button.TaskbarApp">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
    </Style>
    <Style Selector="Button.TaskbarApp.LauncherActive /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TaskbarHoverBrush}"/>
    </Style>

    <!-- Reorderable app icon. Positioned absolutely inside AppIconsCanvas via Canvas.Left,
         which is animated in code-behind so items glide into their new slot. -->
    <Style Selector="Button.TaskbarAppIcon">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
    </Style>
    <Style Selector="Button.TaskbarAppIcon.dragging /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TaskbarPressedBrush}"/>
    </Style>
  </UserControl.Styles>

  <!--
    Floating Island - no explicit Width set here.
    The Border auto-sizes to its StackPanel child + Padding,
    guaranteeing perfectly symmetric edge spacing on both sides.
    The Width Transition animates smoothly as the Canvas inside resizes.
  -->
  <Border Height="52"
          Padding="6"
          Background="Transparent"
          BorderThickness="0"
          CornerRadius="12"
          ClipToBounds="True"
          BoxShadow="0 8 32 0 #60000000">
    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.35" Easing="CubicEaseOut"/>
      </Transitions>
    </Border.Transitions>

    <!-- StackPanel is the direct child - Border wraps it tightly via Padding -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">

      <!-- Start Button -->
      <Button x:Name="StartButton" Classes="ShellButton TaskbarApp" ToolTip.Tip="Start Menu">
        <Border Background="Transparent" CornerRadius="8" BoxShadow="0 3 10 0 #80000000">
          <!-- The favicon uses currentColor, allowing it to follow the dynamic primary role. -->
          <svg:Svg Width="22" Height="22"
                   Path="avares://DaisyOS.Shell/Assets/Brand/favicon.svg"
                   CurrentColor="{DynamicResource AppPrimaryColor}"
                   Stretch="Uniform"/>
        </Border>
      </Button>

      <!-- Reorderable App Icons Canvas. Width is set from code-behind. -->
      <Canvas x:Name="AppIconsCanvas" Height="40">
        <Button Classes="ShellButton TaskbarApp TaskbarAppIcon" Tag="settings" ToolTip.Tip="Settings">
          <Border Background="Transparent" CornerRadius="8" BoxShadow="0 3 10 0 #80000000">
            <Image Source="avares://DaisyOS.Shell/Assets/AppIcons/SettingsIcon.png"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   Width="24" Height="24" IsHitTestVisible="False"/>
          </Border>
        </Button>

        <Button Classes="ShellButton TaskbarApp TaskbarAppIcon" Tag="files" ToolTip.Tip="Files">
          <Border Background="Transparent" CornerRadius="8" BoxShadow="0 3 10 0 #80000000">
            <Image Source="avares://DaisyOS.Shell/Assets/AppIcons/FilesIcon.png"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   Width="24" Height="24" IsHitTestVisible="False"/>
          </Border>
        </Button>
      </Canvas>

    </StackPanel>
  </Border>
</UserControl>
