<UserControl
    x:Class="DaisyOS.Shell.Views.Components.SystemBar.SystemBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
    xmlns:notifications="clr-namespace:DaisyOS.Shell.Views.Components.Notifications"
    xmlns:systemBar="clr-namespace:DaisyOS.Shell.Views.Components.SystemBar"
    HorizontalAlignment="Right"
    VerticalAlignment="Bottom"
    Margin="0,0,4,4">

  <UserControl.Resources>
    <!-- Flyout has no second opaque frame; each popover owns its material card. -->
    <ControlTheme x:Key="SystemBarFlyoutPresenter" TargetType="FlyoutPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedNone}"/>
    </ControlTheme>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Subtle shadow for the System Bar button glyphs and clock text. -->
    <Style Selector="Border#SystemBarFrame Button TextBlock">
      <Setter Property="Effect">
        <DropShadowEffect OffsetX="0" OffsetY="1" BlurRadius="2" Color="Black" Opacity="0.30"/>
      </Setter>
    </Style>
    <Style Selector="Button.VolumeOutputDetails">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource ActionSecondaryBrush}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedMDRight}"/>
    </Style>
    <Style Selector="Button.VolumeOutputDetails:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ActionSecondaryHoverBrush}"/>
    </Style>
    <Style Selector="Button.VolumeOutputDetails:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ActionSecondaryPressedBrush}"/>
    </Style>
    <Style Selector="Button.OutputDevicesButton">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Background" Value="{DynamicResource ActionSecondaryBrush}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedMD}"/>
    </Style>
    <Style Selector="Button.OutputDevicesButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ActionSecondaryHoverBrush}"/>
    </Style>
    <Style Selector="Button.OutputDevicesButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ActionSecondaryPressedBrush}"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem">
      <Setter Property="Height" Value="44"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="10,0"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StateHoverBrush}"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem.SelectedOutputDevice">
      <Setter Property="Background" Value="{DynamicResource ActionPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem.SelectedOutputDevice TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem.SelectedOutputDevice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ActionPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem.ConnectedWifiNetwork">
      <Setter Property="Background" Value="{DynamicResource ActionPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem.ConnectedWifiNetwork:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ActionPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem.ConnectedBluetoothDevice">
      <Setter Property="Background" Value="{DynamicResource ActionPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem.ConnectedBluetoothDevice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ActionPrimaryBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid>
  <!-- Same opaque in-window surface, height, padding, and radius as TaskbarView. -->
  <Border x:Name="SystemBarFrame" Height="52"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          Padding="6"
          Background="{DynamicResource SurfaceBaseBrush}"
          BorderBrush="{DynamicResource StrokeSubtleBrush}"
          BorderThickness="2"
          CornerRadius="{DynamicResource RoundedXL}"
          ClipToBounds="True">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">

      <!-- Network and sound are one Quick Settings action, laid out on an even two-icon grid. -->
      <Button x:Name="QuickSettingsButton" Classes="ShellButton" Width="96" Height="40" ToolTip.Tip="Quick settings"
              Click="OnQuickSettingsRequested">
        <Border Width="96" Height="40" Background="Transparent" CornerRadius="{DynamicResource RoundedSM}">
          <Grid ColumnDefinitions="*,*,*">
            <TextBlock Grid.Column="0" Text="wifi"
                       FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="bluetooth"
                       FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="volume_up"
                       FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Border>
      </Button>
      <Button x:Name="CalendarButton" Classes="ShellButton" Height="40" Padding="10,0" ToolTip.Tip="Calendar" Click="OnCalendarRequested">
        <Border Background="Transparent" CornerRadius="{DynamicResource RoundedSM}">
          <TextBlock x:Name="ClockText" FontSize="13" FontWeight="Regular" TextAlignment="Center"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </Button>
      <Button x:Name="NotificationsButton" Classes="ShellButton" Width="40" Height="40" Padding="0" ToolTip.Tip="Notifications" Click="OnNotificationsRequested">
        <Border Background="Transparent" CornerRadius="{DynamicResource RoundedSM}">
          <Grid>
            <!-- Using the filled version of Material Symbols Rounded -->
            <TextBlock Text="notifications" FontFamily="avares://DaisyOS.Shell/Assets/Icons/MaterialSymbolsRounded-Filled.ttf#Material Symbols Rounded"
                       FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border x:Name="NotificationBadge" Width="8" Height="8" CornerRadius="4"
                    Background="{DynamicResource ActionPrimaryBrush}" IsVisible="False"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                    ToolTip.Tip="Unread notifications" />
          </Grid>
        </Border>
      </Button>
    </StackPanel>
  </Border>

  <!-- In-window overlay anchored 12px above the System Bar. -->
  <Border x:Name="QuickSettingsPanel" IsVisible="False"
          Width="336" Height="304" Padding="16,16,16,0"
          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,64"
          Background="{DynamicResource SurfaceBaseBrush}"
          BorderBrush="{DynamicResource StrokeSubtleBrush}"
          BorderThickness="2"
          CornerRadius="{DynamicResource RoundedXL}"
          ClipToBounds="True">
    <Grid>
      <Grid x:Name="QuickSettingsMainPage" RowDefinitions="*,Auto">
        <StackPanel Grid.Row="0" Spacing="12">
          <Grid Width="304" HorizontalAlignment="Center"
                ColumnDefinitions="96,96,96" ColumnSpacing="8"
                RowDefinitions="Auto,Auto" RowSpacing="8">
            <controls:QuickSettingTile Grid.Row="0" Grid.Column="0" x:Name="WifiTile"
                                       Icon="wifi" Label="Wi-Fi" HasDetails="True"
                                       ToolTipText="Toggle Wi-Fi" DetailsToolTipText="Wi-Fi networks"
                                       Toggled="OnWifiTileToggled" DetailsClicked="OnWifiNetworksButtonClicked"/>
            <controls:QuickSettingTile Grid.Row="0" Grid.Column="1" x:Name="BluetoothTile"
                                       Icon="bluetooth" Label="Bluetooth" HasDetails="True"
                                       ToolTipText="Toggle Bluetooth" DetailsToolTipText="Bluetooth devices"
                                       Toggled="OnBluetoothTileToggled" DetailsClicked="OnBluetoothDevicesButtonClicked"/>
            <controls:QuickSettingTile Grid.Row="0" Grid.Column="2" x:Name="FocusTile"
                                       Icon="do_not_disturb_on" Label="Focus" ToolTipText="Do not disturb"
                                       Toggled="OnFocusTileToggled"/>
            <controls:QuickSettingTile Grid.Row="1" Grid.Column="0" x:Name="NightLightTile"
                                       Icon="dark_mode" Label="Night light" ToolTipText="Not available in this session" IsEnabled="False"/>
            <controls:QuickSettingTile Grid.Row="1" Grid.Column="1" x:Name="ThemeTile"
                                       Icon="contrast" Label="Theme" ToolTipText="Change theme" Toggled="OnThemeTileToggled"/>
            <controls:QuickSettingTile Grid.Row="1" Grid.Column="2" x:Name="GamingTile"
                                       Icon="sports_esports" Label="Gaming" HasDetails="True"
                                       ToolTipText="Gaming mode" DetailsToolTipText="Open console mode"
                                       Toggled="OnGamingTileToggled" DetailsClicked="OnGamingDetailsClicked"/>
          </Grid>
          <Grid ColumnDefinitions="*,1,40">
            <controls:QuickSettingsSlider x:Name="VolumeSlider" Grid.Column="0" Icon="volume_up"
                                          Minimum="0" Maximum="100" ValueChanged="OnVolumeChanged" ShowThumb="False" />
            <Border Grid.Column="1" Background="{DynamicResource StrokeDefaultBrush}" IsHitTestVisible="False"/>
            <Button Grid.Column="2" Classes="ShellButton VolumeOutputDetails" ToolTip.Tip="Choose output device"
                    Click="OnOutputDevicesButtonClicked">
              <TextBlock Text="chevron_right" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                         FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
          </Grid>
        </StackPanel>
        <Grid Grid.Row="1" Height="52" RowDefinitions="1,*">
          <Border Grid.Row="0" Background="{DynamicResource StrokeDefaultBrush}" Opacity="0.7"/>
          <Grid Grid.Row="1" ColumnDefinitions="*,40">
            <StackPanel x:Name="BatteryStatusHost" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="False">
              <TextBlock Text="battery_full" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                         FontSize="18" Foreground="{DynamicResource ContentPrimaryBrush}"/>
              <TextBlock x:Name="BatteryText" Text="Battery unavailable" FontSize="13" VerticalAlignment="Center"
                         Foreground="{DynamicResource ContentPrimaryBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="ShellButton" Width="40" Height="40" VerticalAlignment="Center"
                    ToolTip.Tip="Settings" Click="OnSettingsClicked">
              <TextBlock Text="settings" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18"/>
            </Button>
          </Grid>
        </Grid>
      </Grid>
      <StackPanel x:Name="OutputDevicesPage" IsVisible="False" Spacing="12">
        <controls:FlyoutPageHeader Title="Output devices" BackClicked="OnOutputDevicesBackClicked"/>
        <StackPanel x:Name="OutputDevicesHost" Spacing="2"><TextBlock Text="Loading devices…" Foreground="{DynamicResource ContentSecondaryBrush}" Margin="10,8"/></StackPanel>
      </StackPanel>
      <StackPanel x:Name="WifiNetworksPage" IsVisible="False" Spacing="12">
        <controls:FlyoutPageHeader Title="Wi-Fi networks" BackClicked="OnWifiNetworksBackClicked"/>
        <StackPanel x:Name="WifiNetworksHost" Spacing="2"><TextBlock Text="Loading networks…" Foreground="{DynamicResource ContentSecondaryBrush}" Margin="10,8"/></StackPanel>
      </StackPanel>
      <StackPanel x:Name="BluetoothDevicesPage" IsVisible="False" Spacing="12">
        <controls:FlyoutPageHeader Title="Bluetooth devices" BackClicked="OnBluetoothDevicesBackClicked"/>
        <StackPanel x:Name="BluetoothDevicesHost" Spacing="2"><TextBlock Text="Loading devices…" Foreground="{DynamicResource ContentSecondaryBrush}" Margin="10,8"/></StackPanel>
      </StackPanel>
    </Grid>
  </Border>
  
  <notifications:NotificationCenterView x:Name="NotificationDrawer" IsVisible="False"
          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,64"/>
          
    <!-- Calendar Overlay -->
  <Border x:Name="CalendarPanel" IsVisible="False"
          Padding="16" Background="{DynamicResource SurfaceBaseBrush}"
          BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="2"
          CornerRadius="{DynamicResource RoundedXL}"
          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,64">
    <systemBar:CustomCalendarView x:Name="CalendarView" />
  </Border>
  </Grid>
</UserControl>