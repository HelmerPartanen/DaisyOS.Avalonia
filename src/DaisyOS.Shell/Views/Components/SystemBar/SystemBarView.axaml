<UserControl
    x:Class="DaisyOS.Shell.Views.Components.SystemBar.SystemBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
    HorizontalAlignment="Right"
    VerticalAlignment="Bottom"
    Margin="0,0,12,4">

  <UserControl.Resources>
    <!-- Flyout has no second opaque frame; each popover owns its material card. -->
    <ControlTheme x:Key="SystemBarFlyoutPresenter" TargetType="FlyoutPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
    </ControlTheme>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Mirrors TaskbarView: 40 px targets inside the same 52 px floating surface. -->
    <Style Selector="Button.StatusClusterButton">
      <Setter Property="Width" Value="64"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.StatusClusterButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TaskbarHoverBrush}"/>
    </Style>
    <Style Selector="Button.StatusClusterButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TaskbarPressedBrush}"/>
    </Style>
    <Style Selector="Button.ClockButton">
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinWidth" Value="140"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.ClockButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TaskbarHoverBrush}"/>
    </Style>
    <Style Selector="Button.ClockButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TaskbarPressedBrush}"/>
    </Style>
    <Style Selector="ToggleButton.QuickAction">
      <!-- Full-width matrix: 92 px squares separated by a shared 6 px rhythm. -->
      <Setter Property="Width" Value="92"/>
      <Setter Property="Height" Value="92"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.OutputDevicesButton">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Background" Value="{DynamicResource QuickSettingBackgroundBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.OutputDevicesButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource QuickSettingHoverBrush}"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem">
      <Setter Property="Height" Value="44"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="10,0"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource QuickSettingHoverBrush}"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem.SelectedOutputDevice">
      <Setter Property="Background" Value="{DynamicResource AppPrimaryContainerBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppOnPrimaryContainerBrush}"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem.SelectedOutputDevice TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppOnPrimaryContainerBrush}"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem.SelectedOutputDevice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppPrimaryContainerBrush}"/>
    </Style>
  </UserControl.Styles>

  <!-- Same material, height, padding, corner radius and shadow as TaskbarView. -->
  <Border Height="52"
          Padding="6"
          Background="{DynamicResource SystemBarMaterialBrush}"
          BorderBrush="{DynamicResource TaskbarBorderBrush}"
          BorderThickness="1"
          CornerRadius="12"
          ClipToBounds="True"
          BoxShadow="0 8 32 0 #60000000">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">

      <!-- Network and sound are one Quick Settings action, laid out on an even two-icon grid. -->
      <Button x:Name="QuickSettingsButton" Classes="StatusClusterButton" ToolTip.Tip="Quick settings">
        <Grid Width="64" ColumnDefinitions="*,*">
          <TextBlock Grid.Column="0" Text="wifi"
                     FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="16"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="volume_up"
                     FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="16"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <Button.Flyout>
          <Flyout Placement="TopEdgeAlignedRight" VerticalOffset="-14" FlyoutPresenterTheme="{StaticResource SystemBarFlyoutPresenter}">
            <Border Width="320" Height="304" Padding="16,14"
                    Background="{DynamicResource SystemBarMaterialBrush}"
                    BorderBrush="{DynamicResource TaskbarBorderBrush}"
                    BorderThickness="1" CornerRadius="14"
                    BoxShadow="0 12 36 0 #60000000">
              <Grid>
                <StackPanel x:Name="QuickSettingsMainPage" Spacing="14">
                  <TextBlock Text="Quick settings" FontSize="15" FontWeight="Regular"/>
                <!-- The square matrix spans the same content width as the volume rail. -->
                <Grid Width="288" HorizontalAlignment="Center"
                      ColumnDefinitions="92,92,92" ColumnSpacing="6"
                      RowDefinitions="Auto,Auto" RowSpacing="6">
                  <ToggleButton Grid.Row="0" Grid.Column="0" Classes="QuickAction QuickSetting" IsChecked="True" ToolTip.Tip="Choose a network">
                    <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="wifi" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18" HorizontalAlignment="Center"/>
                      <TextBlock Text="Wi-Fi" FontSize="11" FontWeight="Regular" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </ToggleButton>
                  <ToggleButton Grid.Row="0" Grid.Column="1" Classes="QuickAction QuickSetting" ToolTip.Tip="Bluetooth">
                    <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="bluetooth" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18" HorizontalAlignment="Center"/>
                      <TextBlock Text="Bluetooth" FontSize="11" FontWeight="Regular" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </ToggleButton>
                  <ToggleButton Grid.Row="0" Grid.Column="2" Classes="QuickAction QuickSetting" ToolTip.Tip="Do not disturb">
                    <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="do_not_disturb_on" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18" HorizontalAlignment="Center"/>
                      <TextBlock Text="Focus" FontSize="11" FontWeight="Regular" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </ToggleButton>
                  <ToggleButton Grid.Row="1" Grid.Column="0" Classes="QuickAction QuickSetting" ToolTip.Tip="Night light">
                    <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="nightlight" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18" HorizontalAlignment="Center"/>
                      <TextBlock Text="Night light" FontSize="11" FontWeight="Regular" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </ToggleButton>
                  <ToggleButton x:Name="ThemeToggle" Grid.Row="1" Grid.Column="1" Classes="QuickAction QuickSetting" IsChecked="True" ToolTip.Tip="Dark theme"
                                Click="OnThemeToggleClicked">
                    <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="contrast" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18" HorizontalAlignment="Center"/>
                      <TextBlock Text="Theme" FontSize="11" FontWeight="Regular" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </ToggleButton>
                  <ToggleButton Grid.Row="1" Grid.Column="2" Classes="QuickAction QuickSetting" ToolTip.Tip="Gaming mode">
                    <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="sports_esports" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18" HorizontalAlignment="Center"/>
                      <TextBlock Text="Gaming" FontSize="11" FontWeight="Regular" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </ToggleButton>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <controls:QuickSettingsSlider Icon="volume_up"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="72" />
                  <Button Grid.Column="1" Classes="OutputDevicesButton" ToolTip.Tip="Choose output device"
                          Click="OnOutputDevicesButtonClicked">
                    <TextBlock Text="chevron_right"
                               FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                  </Button>
                </Grid>
                </StackPanel>

                <StackPanel x:Name="OutputDevicesPage" IsVisible="False" Spacing="12">
                  <Grid ColumnDefinitions="40,*,40">
                    <Button Classes="OutputDevicesButton"
                            Click="OnOutputDevicesBackClicked" ToolTip.Tip="Back to quick settings">
                      <TextBlock Text="chevron_left"
                                 FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                                 FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock Grid.Column="1" Text="Output devices" FontSize="15" FontWeight="Regular"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border Grid.Column="2" Width="40" Height="40"/>
                  </Grid>
                  <StackPanel x:Name="OutputDevicesHost" Spacing="2">
                    <TextBlock Text="Loading devices…" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,8"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </Flyout>
        </Button.Flyout>
      </Button>

      <Button Classes="ClockButton" ToolTip.Tip="Calendar and notifications">
        <TextBlock x:Name="ClockText" FontSize="13" FontWeight="Regular" TextAlignment="Center"/>
        <Button.Flyout>
          <Flyout Placement="TopEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource SystemBarFlyoutPresenter}">
            <Border Padding="16" Background="{DynamicResource DropdownMenuBackgroundBrush}"
                    BorderBrush="{DynamicResource TaskbarBorderBrush}" BorderThickness="1" CornerRadius="12">
              <StackPanel Spacing="12">
                <TextBlock x:Name="CalendarHeading" FontWeight="Regular"/>
                <Calendar IsTodayHighlighted="True"/>
              </StackPanel>
            </Border>
          </Flyout>
        </Button.Flyout>
      </Button>
    </StackPanel>
  </Border>
</UserControl>
