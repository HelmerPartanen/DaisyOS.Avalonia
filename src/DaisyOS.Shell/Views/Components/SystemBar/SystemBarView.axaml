<UserControl
    x:Class="DaisyOS.Shell.Views.Components.SystemBar.SystemBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
    HorizontalAlignment="Right"
    VerticalAlignment="Bottom"
    Margin="0,0,4,4">

  <UserControl.Resources>
    <!-- Flyout has no second opaque frame; each popover owns its material card. -->
    <ControlTheme x:Key="SystemBarFlyoutPresenter" TargetType="FlyoutPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
    </ControlTheme>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="ToggleButton.QuickAction">
      <!-- Labels sit below the interactive tile, so the hit target stays visually quiet. -->
      <Setter Property="Width" Value="92"/>
      <Setter Property="Height" Value="56"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.QuickSettingDetails">
      <Setter Property="Width" Value="27"/>
      <Setter Property="Height" Value="56"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="0,10,10,0"/>
      <Setter Property="Background" Value="{DynamicResource QuickSettingBackgroundBrush}"/>
    </Style>
    <Style Selector="Button.QuickSettingDetails.Active">
      <Setter Property="Background" Value="{DynamicResource AppPrimaryContainerBrush}"/>
    </Style>
    <Style Selector="Button.QuickSettingDetails.Active > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.QuickSettingDetails.Active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppPrimaryContainerHoverBrush}"/>
    </Style>
    <Style Selector="Button.QuickSettingDetails.Active:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppPrimaryContainerPressedBrush}"/>
    </Style>
    <Style Selector="Border.QuickSettingSplitDivider">
      <Setter Property="Background" Value="{DynamicResource QuickSettingInactiveDividerBrush}"/>
    </Style>
    <Style Selector="Border.QuickSettingSplitDivider.Active">
      <Setter Property="Background" Value="{DynamicResource QuickSettingActiveDividerBrush}"/>
    </Style>
    <Style Selector="Button.VolumeOutputDetails">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Background" Value="{DynamicResource QuickSettingBackgroundBrush}"/>
      <Setter Property="CornerRadius" Value="0,10,10,0"/>
    </Style>
    <Style Selector="Button.VolumeOutputDetails:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource QuickSettingHoverBrush}"/>
    </Style>
    <Style Selector="TextBlock.QuickSettingLabel">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.OutputDevicesButton">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Background" Value="{DynamicResource QuickSettingBackgroundBrush}"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.OutputDevicesButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource QuickSettingHoverBrush}"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem">
      <Setter Property="Height" Value="44"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="10,0"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource QuickSettingHoverBrush}"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem.SelectedOutputDevice">
      <Setter Property="Background" Value="{DynamicResource AppPrimaryContainerBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem.SelectedOutputDevice TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem.SelectedOutputDevice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppPrimaryContainerBrush}"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem.ConnectedWifiNetwork">
      <Setter Property="Background" Value="{DynamicResource AppPrimaryContainerBrush}"/>
    </Style>
    <Style Selector="Button.OutputDeviceItem.ConnectedWifiNetwork:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppPrimaryContainerBrush}"/>
    </Style>
  </UserControl.Styles>

  <!-- Same material, height, padding, corner radius and shadow as TaskbarView. -->
  <Border Height="52"
          Padding="6"
          Background="{DynamicResource SystemBarMaterialBrush}"
          BorderBrush="{DynamicResource ShellSurfaceBorderBrush}"
          BorderThickness="1"
          CornerRadius="12"
          ClipToBounds="True"
          BoxShadow="0 8 32 0 #60000000">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">

      <!-- Network and sound are one Quick Settings action, laid out on an even two-icon grid. -->
      <Button x:Name="QuickSettingsButton" Classes="ShellButton" Width="96" Height="40" ToolTip.Tip="Quick settings">
        <!-- Matches TaskbarView's button content surface exactly; only the icons differ. -->
        <Border Width="96" Height="40" Background="Transparent" CornerRadius="8">
          <Grid ColumnDefinitions="*,*,*">
            <TextBlock Grid.Column="0" Text="wifi"
                       FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="bluetooth"
                       FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="volume_up"
                       FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <Button.Flyout>
          <Flyout Placement="TopEdgeAlignedRight" VerticalOffset="-14" FlyoutPresenterTheme="{StaticResource SystemBarFlyoutPresenter}"
                  Opened="OnQuickSettingsFlyoutOpened" Closed="OnQuickSettingsFlyoutClosed">
            <Border Width="336" Height="304" Padding="16,16,16,0"
                    Background="{DynamicResource SystemBarMaterialBrush}"
                    BorderBrush="{DynamicResource ShellSurfaceBorderBrush}"
                    BorderThickness="1" CornerRadius="14"
                    BoxShadow="0 12 36 0 #60000000">
              <Grid>
                <Grid x:Name="QuickSettingsMainPage" RowDefinitions="*,Auto">
                  <StackPanel Grid.Row="0" Spacing="12">
                    <!-- Labels remain outside the controls; Wi-Fi and Bluetooth split into action + details. -->
                    <Grid Width="304" HorizontalAlignment="Center"
                          ColumnDefinitions="96,96,96" ColumnSpacing="8"
                          RowDefinitions="Auto,Auto" RowSpacing="8">
                  <StackPanel Grid.Row="0" Grid.Column="0" Width="96" Spacing="6">
                    <Grid Height="56" ColumnDefinitions="68,1,27">
                      <ToggleButton x:Name="WifiToggle" Grid.Column="0" Classes="ShellButton QuickAction QuickSetting" Width="68" CornerRadius="10,0,0,10" IsChecked="True" Click="OnWifiToggleStateChanged" ToolTip.Tip="Toggle Wi-Fi">
                        <TextBlock Text="wifi" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18"/>
                      </ToggleButton>
                      <Border x:Name="WifiSplitDivider" Grid.Column="1" Classes="QuickSettingSplitDivider Active" IsHitTestVisible="False"/>
                      <Button x:Name="WifiDetailsButton" Grid.Column="2" Classes="ShellButton QuickSettingDetails Active" Click="OnWifiNetworksButtonClicked">
                        <ToolTip.Tip>
                          <TextBlock Text="Wi-Fi networks" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </ToolTip.Tip>
                        <TextBlock Text="chevron_right" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18"/>
                      </Button>
                    </Grid>
                    <TextBlock Classes="QuickSettingLabel" Text="Wi-Fi"/>
                  </StackPanel>
                  <StackPanel Grid.Row="0" Grid.Column="1" Width="96" Spacing="6">
                    <Grid Height="56" ColumnDefinitions="68,1,27">
                      <ToggleButton x:Name="BluetoothToggle" Grid.Column="0" Classes="ShellButton QuickAction QuickSetting" Width="68" CornerRadius="10,0,0,10" Click="OnBluetoothToggleStateChanged" ToolTip.Tip="Toggle Bluetooth">
                        <TextBlock Text="bluetooth" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18"/>
                      </ToggleButton>
                      <Border x:Name="BluetoothSplitDivider" Grid.Column="1" Classes="QuickSettingSplitDivider" IsHitTestVisible="False"/>
                      <Button x:Name="BluetoothDetailsButton" Grid.Column="2" Classes="ShellButton QuickSettingDetails" Click="OnBluetoothDevicesButtonClicked">
                        <ToolTip.Tip>
                          <TextBlock Text="Bluetooth devices" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </ToolTip.Tip>
                        <TextBlock Text="chevron_right" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18"/>
                      </Button>
                    </Grid>
                    <TextBlock Classes="QuickSettingLabel" Text="Bluetooth"/>
                  </StackPanel>
                  <StackPanel Grid.Row="0" Grid.Column="2" Width="96" Spacing="6">
                    <ToggleButton Classes="ShellButton QuickAction QuickSetting" ToolTip.Tip="Do not disturb">
                      <TextBlock Text="do_not_disturb_on" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18"/>
                    </ToggleButton>
                    <TextBlock Classes="QuickSettingLabel" Text="Focus"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="0" Width="96" Spacing="6">
                    <ToggleButton Classes="ShellButton QuickAction QuickSetting" ToolTip.Tip="Night light">
                      <TextBlock Text="nightlight" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18"/>
                    </ToggleButton>
                    <TextBlock Classes="QuickSettingLabel" Text="Night light"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Width="96" Spacing="6">
                    <ToggleButton x:Name="ThemeToggle" Classes="ShellButton QuickAction QuickSetting" IsChecked="True" ToolTip.Tip="Dark theme" Click="OnThemeToggleClicked">
                      <TextBlock Text="contrast" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18"/>
                    </ToggleButton>
                    <TextBlock Classes="QuickSettingLabel" Text="Theme"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="2" Width="96" Spacing="6">
                    <ToggleButton Classes="ShellButton QuickAction QuickSetting" ToolTip.Tip="Gaming mode">
                      <TextBlock Text="sports_esports" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" FontSize="18"/>
                    </ToggleButton>
                    <TextBlock Classes="QuickSettingLabel" Text="Gaming"/>
                  </StackPanel>
                </Grid>
                    <Grid ColumnDefinitions="*,1,40">
                      <controls:QuickSettingsSlider Grid.Column="0" Icon="volume_up"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    Value="72" />
                      <Border Grid.Column="1" Background="{DynamicResource QuickSettingInactiveDividerBrush}" IsHitTestVisible="False"/>
                      <Button Grid.Column="2" Classes="ShellButton VolumeOutputDetails" ToolTip.Tip="Choose output device"
                              Click="OnOutputDevicesButtonClicked">
                        <TextBlock Text="chevron_right"
                                   FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                      </Button>
                    </Grid>
                  </StackPanel>

                  <!-- Mock footer; its actions are intentionally not wired until their surfaces are available. -->
                  <Grid Grid.Row="1" Height="52" RowDefinitions="1,*">
                    <Border Grid.Row="0" Background="{DynamicResource TaskbarBorderBrush}" Opacity="0.7"/>
                    <Grid Grid.Row="1" ColumnDefinitions="*,40,40">
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="battery_full"
                                   FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                                   FontSize="18"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="100%" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                      </StackPanel>
                      <Button Grid.Column="1" Classes="ShellButton" Width="40" Height="40" VerticalAlignment="Center" ToolTip.Tip="Edit quick settings">
                        <TextBlock Text="edit"
                                   FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                                   FontSize="18"/>
                      </Button>
                      <Button Grid.Column="2" Classes="ShellButton" Width="40" Height="40" VerticalAlignment="Center" ToolTip.Tip="Settings">
                        <TextBlock Text="settings"
                                   FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                                   FontSize="18"/>
                      </Button>
                    </Grid>
                  </Grid>
                </Grid>

                <StackPanel x:Name="OutputDevicesPage" IsVisible="False" Spacing="12">
                  <Grid ColumnDefinitions="40,*,40">
                    <Button Classes="ShellButton OutputDevicesButton"
                            Click="OnOutputDevicesBackClicked" ToolTip.Tip="Back to quick settings">
                      <TextBlock Text="chevron_left"
                                 FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                                 FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock Grid.Column="1" Text="Output devices" FontSize="15" FontWeight="Regular"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border Grid.Column="2" Width="40" Height="40"/>
                  </Grid>
                  <StackPanel x:Name="OutputDevicesHost" Spacing="2">
                    <TextBlock Text="Loading devices…" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,8"/>
                  </StackPanel>
                </StackPanel>

                <StackPanel x:Name="WifiNetworksPage" IsVisible="False" Spacing="12">
                  <Grid ColumnDefinitions="40,*,40">
                    <Button Classes="ShellButton OutputDevicesButton"
                            Click="OnWifiNetworksBackClicked" ToolTip.Tip="Back to quick settings">
                      <TextBlock Text="chevron_left"
                                 FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                                 FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock Grid.Column="1" Text="Wi-Fi networks" FontSize="15" FontWeight="Regular"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border Grid.Column="2" Width="40" Height="40"/>
                  </Grid>
                  <StackPanel x:Name="WifiNetworksHost" Spacing="2">
                    <TextBlock Text="Loading networks…" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,8"/>
                  </StackPanel>
                </StackPanel>

                <StackPanel x:Name="BluetoothDevicesPage" IsVisible="False" Spacing="12">
                  <Grid ColumnDefinitions="40,*,40">
                    <Button Classes="ShellButton OutputDevicesButton"
                            Click="OnBluetoothDevicesBackClicked" ToolTip.Tip="Back to quick settings">
                      <TextBlock Text="chevron_left"
                                 FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded"
                                 FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock Grid.Column="1" Text="Bluetooth devices" FontSize="15" FontWeight="Regular"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border Grid.Column="2" Width="40" Height="40"/>
                  </Grid>
                  <StackPanel x:Name="BluetoothDevicesHost" Spacing="2">
                    <TextBlock Text="Loading devices…" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,8"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </Flyout>
        </Button.Flyout>
      </Button>

      <Button x:Name="CalendarButton" Classes="ShellButton" Height="40" MinWidth="140" Padding="10,0" ToolTip.Tip="Calendar and notifications">
        <!-- Same taskbar button content surface, with the clock as its icon/content. -->
        <Border Background="Transparent" CornerRadius="8">
          <TextBlock x:Name="ClockText" FontSize="13" FontWeight="Regular" TextAlignment="Center"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Button.Flyout>
          <Flyout Placement="TopEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource SystemBarFlyoutPresenter}"
                  Opened="OnCalendarFlyoutOpened" Closed="OnCalendarFlyoutClosed">
            <Border Padding="16" Background="{DynamicResource DropdownMenuBackgroundBrush}"
                    BorderBrush="{DynamicResource TaskbarBorderBrush}" BorderThickness="1" CornerRadius="12">
              <StackPanel Spacing="12">
                <TextBlock x:Name="CalendarHeading" FontWeight="Regular"/>
                <Calendar IsTodayHighlighted="True"/>
              </StackPanel>
            </Border>
          </Flyout>
        </Button.Flyout>
      </Button>
    </StackPanel>
  </Border>
</UserControl>
