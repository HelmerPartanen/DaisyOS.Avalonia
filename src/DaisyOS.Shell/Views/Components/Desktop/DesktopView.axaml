<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Desktop.DesktopView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:DaisyOS.Shell.ViewModels"
    xmlns:controls="clr-namespace:DaisyOS.Shell.Controls">
  <Grid
      x:Name="InteractionSurface"
      Focusable="True"
      Background="Transparent">

    <!-- Items Layer -->
    <ItemsControl
        x:Name="ItemsControl"
        ItemsSource="{Binding Items}"
        DoubleTapped="OnDesktopItemDoubleTapped">
      <ItemsControl.Styles>
        <Style Selector="ItemsControl > ContentPresenter">
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
            </Transitions>
          </Setter>
        </Style>
      </ItemsControl.Styles>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <controls:DesktopReorderPanel
              x:Name="ItemsPanel"
              Metrics="{Binding $parent[UserControl].CurrentMetrics}"
              ViewModel="{Binding $parent[UserControl].ViewModel}" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:DesktopItemViewModel}">
          <controls:DesktopItemView />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
