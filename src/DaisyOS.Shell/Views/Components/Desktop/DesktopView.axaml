<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Desktop.DesktopView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:DaisyOS.Shell.ViewModels"
    xmlns:controls="clr-namespace:DaisyOS.Shell.Controls">
  <Grid
      x:Name="WallpaperRoot"
      Classes="Wallpaper"
      Background="Black">
    <Image
        x:Name="WallpaperImage"
        Source="avares://DaisyOS.Shell/Assets/Wallpapers/Green.jpg"
        Stretch="UniformToFill"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        IsHitTestVisible="False" />
        
    <ItemsControl ItemsSource="{Binding Items}"
                  PointerPressed="ItemsControl_PointerPressed"
                  PointerMoved="ItemsControl_PointerMoved"
                  PointerReleased="ItemsControl_PointerReleased">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Canvas />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:DesktopItemViewModel}">
          <controls:DesktopItemView />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
      <ItemsControl.Styles>
        <Style Selector="ItemsControl > ContentPresenter">
          <Setter Property="Canvas.Left" Value="{Binding X}" />
          <Setter Property="Canvas.Top" Value="{Binding Y}" />
          <!-- Tag the presenter with a "dragging" class while its item is the one under the pointer,
               so it can opt out of the transition below and follow the cursor 1:1. -->
          <Setter Property="Classes.dragging" Value="{Binding IsDragging}" />
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Canvas.Left" Duration="0:0:0.22" Easing="CubicEaseOut" />
              <DoubleTransition Property="Canvas.Top" Duration="0:0:0.22" Easing="CubicEaseOut" />
            </Transitions>
          </Setter>
        </Style>

        <!-- The item actively being dragged should not animate - it must track the pointer directly.
             Every other item (including one being displaced to make room) keeps the transition above,
             which is what produces the "flip" glide. -->
        <Style Selector="ItemsControl > ContentPresenter.dragging">
          <Setter Property="Transitions" Value="{x:Null}" />
        </Style>
      </ItemsControl.Styles>
    </ItemsControl>
  </Grid>
</UserControl>