<UserControl
    x:Class="DaisyOS.Shell.Views.ShellView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:desktop="clr-namespace:DaisyOS.Shell.Views.Components.Desktop"
    xmlns:taskbar="clr-namespace:DaisyOS.Shell.Views.Components.Taskbar"
    xmlns:launcher="clr-namespace:DaisyOS.Shell.Views.Components.Launcher"
    xmlns:views="clr-namespace:DaisyOS.Shell.Views">
    <Grid>
        <desktop:DesktopView x:Name="Desktop" />
        
        <!-- Launcher (floats 8px above taskbar; visibility managed via opacity+hit-testing for pre-warm) -->
        <launcher:LauncherView x:Name="Launcher" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Bottom" 
                               Margin="0,0,0,64" 
                               ZIndex="10"/>

        <!-- Taskbar -->
        <taskbar:TaskbarView x:Name="Taskbar" VerticalAlignment="Bottom" ZIndex="20"/>
    </Grid>
</UserControl>
