<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
             x:Class="DaisyOS.Shell.Views.LauncherView"
             Width="640" Height="720">
  
  <Border Background="{DynamicResource TaskbarBackgroundBrush}"
          BorderBrush="{DynamicResource TaskbarBorderBrush}"
          BorderThickness="1"
          CornerRadius="12"
          ClipToBounds="True"
          BoxShadow="0 8 32 0 #40000000">
    <Grid RowDefinitions="Auto,*">
      <Grid.Styles>
        <Style Selector="Button.LauncherApp">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="CornerRadius" Value="8"/>
          <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="Button.LauncherApp:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style Selector="Button.LauncherApp:pressed /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>
        <!-- The default Fluent Theme Button template already includes a RenderTransform scale down on press (0.98), 
             so this seamlessly gives us the "squish" click effect! -->
      </Grid.Styles>
      
      <!-- Search Bar Area -->
      <Border Grid.Row="0" Padding="24,24,24,12">
        <controls:SearchBar />
      </Border>
      
      <!-- Pinned Apps / Content Area Placeholder -->
      <ScrollViewer Grid.Row="1" Padding="24,12,24,24">
        <StackPanel Spacing="24">
          <TextBlock Text="Pinned" FontWeight="SemiBold" FontSize="16" />
          
          <WrapPanel ItemWidth="84" ItemHeight="96" HorizontalAlignment="Center">
            <!-- App Item Placeholder 1 -->
            <Button Classes="LauncherApp">
              <StackPanel Spacing="8">
                <Border Width="48" Height="48" Background="#33FFFFFF" CornerRadius="8">
                  <Image Source="avares://DaisyOS.Shell/Assets/AppIcons/SettingsIcon.png" RenderOptions.BitmapInterpolationMode="HighQuality" Width="24" Height="24"/>
                </Border>
                <TextBlock Text="Settings" TextAlignment="Center" FontSize="12" />
              </StackPanel>
            </Button>

            <!-- App Item Placeholder 2 -->
            <Button Classes="LauncherApp">
              <StackPanel Spacing="8">
                <Border Width="48" Height="48" Background="#33FFFFFF" CornerRadius="8">
                  <Image Source="avares://DaisyOS.Shell/Assets/AppIcons/FilesIcon.png" RenderOptions.BitmapInterpolationMode="HighQuality" Width="24" Height="24"/>
                </Border>
                <TextBlock Text="Files" TextAlignment="Center" FontSize="12" />
              </StackPanel>
            </Button>
            
            <!-- Dummy Items -->
            <Button Classes="LauncherApp">
              <StackPanel Spacing="8">
                <Border Width="48" Height="48" Background="#33FFFFFF" CornerRadius="8" />
                <TextBlock Text="Calculator" TextAlignment="Center" FontSize="12" />
              </StackPanel>
            </Button>
            <Button Classes="LauncherApp">
              <StackPanel Spacing="8">
                <Border Width="48" Height="48" Background="#33FFFFFF" CornerRadius="8" />
                <TextBlock Text="Terminal" TextAlignment="Center" FontSize="12" />
              </StackPanel>
            </Button>
            <Button Classes="LauncherApp">
              <StackPanel Spacing="8">
                <Border Width="48" Height="48" Background="#33FFFFFF" CornerRadius="8" />
                <TextBlock Text="Browser" TextAlignment="Center" FontSize="12" />
              </StackPanel>
            </Button>
            <Button Classes="LauncherApp">
              <StackPanel Spacing="8">
                <Border Width="48" Height="48" Background="#33FFFFFF" CornerRadius="8" />
                <TextBlock Text="Photos" TextAlignment="Center" FontSize="12" />
              </StackPanel>
            </Button>
            
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
