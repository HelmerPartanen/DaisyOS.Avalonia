<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
             x:Class="DaisyOS.Shell.Views.LauncherView"
             Width="640" Height="720">
  
  <Border Background="{DynamicResource TaskbarBackgroundBrush}"
          BorderBrush="{DynamicResource TaskbarBorderBrush}"
          BorderThickness="1"
          CornerRadius="12"
          ClipToBounds="True"
          BoxShadow="0 8 32 0 #40000000">
    <Grid RowDefinitions="Auto,*">
      <!-- Search Bar Area -->
      <Border Grid.Row="0" Padding="24,24,24,12">
        <controls:SearchBar />
      </Border>
      
      <!-- Pinned Apps / Content Area Placeholder -->
      <ScrollViewer Grid.Row="1" Padding="24,12,24,24">
        <StackPanel Spacing="24">
          <TextBlock Text="Pinned" FontWeight="SemiBold" Foreground="White" FontSize="16" />
          
          <WrapPanel ItemWidth="84" ItemHeight="96" HorizontalAlignment="Center">
            <!-- App Item Placeholder 1 -->
            <StackPanel Spacing="8" Margin="8">
              <Border Width="48" Height="48" Background="#33FFFFFF" CornerRadius="8">
                <Image Source="avares://DaisyOS.Shell/Assets/AppIcons/SettingsIcon.png" RenderOptions.BitmapInterpolationMode="HighQuality" Width="24" Height="24"/>
              </Border>
              <TextBlock Text="Settings" Foreground="White" TextAlignment="Center" FontSize="12" />
            </StackPanel>

            <!-- App Item Placeholder 2 -->
            <StackPanel Spacing="8" Margin="8">
              <Border Width="48" Height="48" Background="#33FFFFFF" CornerRadius="8">
                <Image Source="avares://DaisyOS.Shell/Assets/AppIcons/FilesIcon.png" RenderOptions.BitmapInterpolationMode="HighQuality" Width="24" Height="24"/>
              </Border>
              <TextBlock Text="Files" Foreground="White" TextAlignment="Center" FontSize="12" />
            </StackPanel>
            
            <!-- Dummy Items -->
            <StackPanel Spacing="8" Margin="8">
              <Border Width="48" Height="48" Background="#33FFFFFF" CornerRadius="8" />
              <TextBlock Text="Calculator" Foreground="White" TextAlignment="Center" FontSize="12" />
            </StackPanel>
            <StackPanel Spacing="8" Margin="8">
              <Border Width="48" Height="48" Background="#33FFFFFF" CornerRadius="8" />
              <TextBlock Text="Terminal" Foreground="White" TextAlignment="Center" FontSize="12" />
            </StackPanel>
            <StackPanel Spacing="8" Margin="8">
              <Border Width="48" Height="48" Background="#33FFFFFF" CornerRadius="8" />
              <TextBlock Text="Browser" Foreground="White" TextAlignment="Center" FontSize="12" />
            </StackPanel>
            <StackPanel Spacing="8" Margin="8">
              <Border Width="48" Height="48" Background="#33FFFFFF" CornerRadius="8" />
              <TextBlock Text="Photos" Foreground="White" TextAlignment="Center" FontSize="12" />
            </StackPanel>
            
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
