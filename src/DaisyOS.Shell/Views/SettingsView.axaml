<UserControl
    x:Class="DaisyOS.Shell.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Styles>
    <Style Selector="Button.SettingsNavItem">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.SettingsNavItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TaskbarHoverBrush}" />
    </Style>
    <Style Selector="Button.AppearanceChoice">
      <Setter Property="Padding" Value="14" />
      <Setter Property="Background" Value="{DynamicResource AppSurfaceContainerLowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppOutlineVariantBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Button.AppearanceChoice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceContainerHighBrush}" />
    </Style>
    <Style Selector="Button.WallpaperChoice">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppOutlineVariantBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.WallpaperChoice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="244,*," Background="{DynamicResource SystemBarMaterialBrush}">
    <Border Background="{DynamicResource SystemBarMaterialBrush}" BorderThickness="0">
      <StackPanel Margin="16" Spacing="4">
        <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="8,8,8,18" />
        <Button Classes="SettingsNavItem" IsEnabled="False">
          <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="palette" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" /><TextBlock Text="Appearance" /></StackPanel>
        </Button>
        <Button Classes="SettingsNavItem" IsEnabled="False">
          <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="volume_up" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" /><TextBlock Text="Sound" /></StackPanel>
        </Button>
        <Button Classes="SettingsNavItem" IsEnabled="False">
          <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="wifi" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" /><TextBlock Text="Network" /></StackPanel>
        </Button>
        <Button Classes="SettingsNavItem" IsEnabled="False">
          <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="display_settings" FontFamily="avares://DaisyOS.Shell/Assets/fonts#Material Symbols Rounded" /><TextBlock Text="Displays" /></StackPanel>
        </Button>
        <TextBlock Text="More settings are being built here—not sent to another desktop's control panel." TextWrapping="Wrap" Margin="8,24,8,0" Opacity="0.68" FontSize="12" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1" Margin="40,32">
      <StackPanel MaxWidth="760" Spacing="30">
        <StackPanel Spacing="6">
          <TextBlock Text="Appearance" FontSize="30" FontWeight="SemiBold" />
          <TextBlock Text="Make the desktop feel like yours." Foreground="{DynamicResource AppOnSurfaceVariantBrush}" />
        </StackPanel>

        <StackPanel Spacing="12">
          <TextBlock Text="Theme" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="Choose the color treatment used throughout DottOS." Foreground="{DynamicResource AppOnSurfaceVariantBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
            <Button Classes="AppearanceChoice" Click="OnLightThemeClicked" Width="174">
              <StackPanel Spacing="10">
                <Border Height="72" Background="#FFF6F3FA" CornerRadius="9"><Border Margin="12" Width="72" Background="#FFE7DEF8" CornerRadius="5" /></Border>
                <TextBlock Text="Light" HorizontalAlignment="Left" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
            <Button Classes="AppearanceChoice" Click="OnDarkThemeClicked" Width="174">
              <StackPanel Spacing="10">
                <Border Height="72" Background="#FF211F26" CornerRadius="9"><Border Margin="12" Width="72" Background="#FF4F378B" CornerRadius="5" /></Border>
                <TextBlock Text="Dark" HorizontalAlignment="Left" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="12">
          <TextBlock Text="Wallpaper" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="A wallpaper refreshes the desktop and its dynamic color palette." Foreground="{DynamicResource AppOnSurfaceVariantBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
            <Button Classes="WallpaperChoice" Click="OnWallpaperClicked" Tag="avares://DaisyOS.Shell/Assets/Wallpapers/Green.jpg" ToolTip.Tip="Green wallpaper">
              <Image Source="avares://DaisyOS.Shell/Assets/Wallpapers/Green.jpg" Width="146" Height="92" Stretch="UniformToFill" IsHitTestVisible="False" />
            </Button>
            <Button Classes="WallpaperChoice" Click="OnWallpaperClicked" Tag="avares://DaisyOS.Shell/Assets/Wallpapers/Purple.jpg" ToolTip.Tip="Purple wallpaper">
              <Image Source="avares://DaisyOS.Shell/Assets/Wallpapers/Purple.jpg" Width="146" Height="92" Stretch="UniformToFill" IsHitTestVisible="False" />
            </Button>
            <Button Classes="WallpaperChoice" Click="OnWallpaperClicked" Tag="avares://DaisyOS.Shell/Assets/Wallpapers/Orange.jpg" ToolTip.Tip="Orange wallpaper">
              <Image Source="avares://DaisyOS.Shell/Assets/Wallpapers/Orange.jpg" Width="146" Height="92" Stretch="UniformToFill" IsHitTestVisible="False" />
            </Button>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
