<UserControl
    x:Class="DaisyOS.Shell.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <StackPanel Spacing="20">
            <TextBlock Text="Appearance Settings" FontSize="24" FontWeight="Bold" />
            
            <TextBlock Text="Theme" FontSize="16" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Light" Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                <Button Content="Dark" Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
            </StackPanel>

            <TextBlock Text="Wallpaper" FontSize="16" Margin="0,20,0,0" />
            <Button Content="Browse..." Command="{Binding BrowseWallpaperCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
