#!/usr/bin/env bash
set -Eeuo pipefail

# This launcher is installed in /usr/local/bin by
# scripts/install-development-session.sh. It deliberately starts KWin first:
# DaisyOS is currently a shell hosted by a compositor, not a compositor itself.
config_file="${DAISYOS_DEVELOPMENT_CONFIG:-/etc/daisyos/daisyos-development-session.conf}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/DaisyOS"
session_log="$state_dir/development-session.log"

if [[ -r "$config_file" ]]; then
  # The configuration file is administrator-owned and contains only the source
  # checkout path written by the installer.
  # shellcheck disable=SC1090
  source "$config_file"
fi

source_root="${DAISYOS_DEVELOPMENT_ROOT:-}"

log_message() {
  local message="$1"
  mkdir -p "$state_dir"
  printf '%s %s\n' "$(date --iso-8601=seconds)" "$message" >> "$session_log"
  printf '%s\n' "$message" >&2
}

resolve_source_root() {
  if [[ -z "$source_root" || ! -d "$source_root/src/DaisyOS.Shell" ]]; then
    log_message "DaisyOS development source is unavailable. Expected a checkout containing src/DaisyOS.Shell."
    exit 1
  fi

  source_root="$(cd "$source_root" && pwd -P)"
}

publish_session_environment() {
  export DAISYOS_SHELL_SERVICES=real
  export DESKTOP_SESSION=daisyos-development
  export XDG_CURRENT_DESKTOP=DaisyOS
  export XDG_SESSION_DESKTOP=DaisyOS
  export XDG_SESSION_TYPE=wayland

  if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd \
      DISPLAY WAYLAND_DISPLAY XAUTHORITY \
      XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE >/dev/null 2>&1 || true
  fi
}

start_user_services() {
  systemctl --user --no-block start \
    pipewire.service \
    pipewire-pulse.service \
    wireplumber.service \
    plasma-polkit-agent.service \
    xdg-desktop-portal.service \
    plasma-xdg-desktop-portal-kde.service >/dev/null 2>&1 || true
}

run_shell() {
  resolve_source_root
  publish_session_environment
  start_user_services

  if ! command -v dotnet >/dev/null 2>&1; then
    log_message "The .NET SDK is required for DaisyOS (Development), but dotnet was not found."
    exit 1
  fi

  log_message "Starting DaisyOS from $source_root."
  exec dotnet run --project "$source_root/src/DaisyOS.Shell" -- --real-services
}

start_compositor() {
  resolve_source_root
  publish_session_environment

  if ! command -v kwin_wayland >/dev/null 2>&1; then
    log_message "KWin Wayland is required for DaisyOS (Development), but kwin_wayland was not found."
    exit 1
  fi

  log_message "Starting the KWin Wayland session for DaisyOS (Development)."
  export DAISYOS_DEVELOPMENT_RUN_SHELL=1
  local kwin_command=(
    kwin_wayland
    --drm
    --xwayland
    --no-lockscreen
    --exit-with-session "$0"
  )

  # A display manager normally owns the user session bus. Create one only for
  # direct launcher invocation, so portal and authentication services retain
  # the display manager's normal session scope.
  if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    exec "${kwin_command[@]}"
  fi

  exec dbus-run-session -- "${kwin_command[@]}"
}

case "${1:-}" in
  --run-shell)
    shift
    run_shell "$@"
    ;;
  --help|-h)
    cat <<'EOF'
Usage: daisyos-development-session [--run-shell]

Starts the DaisyOS development checkout as a standalone KWin Wayland session.
The display manager invokes this launcher without arguments.
EOF
    ;;
  "")
    if [[ "${DAISYOS_DEVELOPMENT_RUN_SHELL:-}" == "1" ]]; then
      run_shell
    else
      start_compositor
    fi
    ;;
  *)
    echo "Unknown option: $1" >&2
    exit 2
    ;;
esac
